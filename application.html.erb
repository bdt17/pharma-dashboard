<!DOCTYPE html>
<html>
  <head>
    <title>PharmaTransport 2.0</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- KILL FAVICON 404 -->
    <%= favicon_link_tag %>

    <style>
      /* PHARMA TRANSPORT 2.0 BRAND COLORS */
      :root {
        --primary-blue: #0984C0;
        --accent-silver: #AAA7B0;
        --mid-grey: #565759;
        --background-white: #FFFFFF;
        --light-variant: #C0BEC6;
        --lighter-blue: #60BDD1;
        --success-green: #00ff88;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 20px;
        background: var(--background-white) !important;
        color: var(--mid-grey) !important;
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        position: relative;
      }

      /* TOP LEFT NAVIGATION */
      .top-nav-links {
        position: absolute;
        top: 20px;
        left: 20px;
        display: flex;
        gap: 15px;
        z-index: 100;
      }

      .top-nav-links a {
        color: var(--lighter-blue) !important;
        text-decoration: none !important;
        font-weight: 500 !important;
        font-size: 14px !important;
        padding: 10px 16px !important;
        background: rgba(96,189,209,0.1) !important;
        border: 1px solid rgba(96,189,209,0.3) !important;
        border-radius: 8px !important;
        transition: all 0.3s ease !important;
      }

      .top-nav-links a:hover {
        background: var(--primary-blue) !important;
        color: white !important;
        transform: translateY(-1px) !important;
      }

      /* KILL ALL BOTTOM LINKS */
      body:not(.logged-in) p:last-child,
      #new_user p:last-child,
      #new_session p:last-child,
      body:not(.logged-in) p:only-child a,
      .links:last-child,
      div:last-child a[href*="sign_up"],
      div:last-child a[href*="password"] {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        overflow: hidden !important;
      }

      /* DASHBOARD */
      .dashboard, main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px;
        background: var(--background-white);
        border: 1px solid var(--accent-silver);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      }

      /* STATS */
      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 30px 0;
      }
      .stat {
        padding: 25px;
        background: var(--light-variant);
        border: 1px solid var(--accent-silver);
        border-radius: 10px;
        text-align: center;
      }
      .number, [class*="mrr"], [class*="batch"] {
        font-size: 40px;
        font-weight: bold;
        color: var(--success-green);
      }

      /* LOGIN FORM */
      .devise-form, #new_user, #new_session {
        max-width: 420px;
        margin: 100px auto 40px !important;
        padding: 40px;
        background: var(--background-white);
        border: 2px solid var(--accent-silver);
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.12);
        position: relative;
        z-index: 10;
      }

      label {
        display: block;
        margin-bottom: 12px;
        font-weight: 600;
        color: var(--mid-grey);
      }

      input[type="email"], input[type="password"] {
        width: 100%;
        padding: 16px;
        margin-bottom: 20px;
        background: #FFFFFF;
        border: 2px solid var(--light-variant);
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.3s ease;
      }

      input[type="email"]:focus, input[type="password"]:focus {
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 4px rgba(9,132,192,0.1);
        outline: none;
      }

      input[type="submit"] {
        width: 100%;
        padding: 18px;
        background: var(--primary-blue);
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 18px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      input[type="submit"]:hover {
        background: var(--lighter-blue);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(9,132,192,0.3);
      }

      /* RESPONSIVE */
      @media (max-width: 768px) {
        .stats { grid-template-columns: 1fr; }
        body { padding: 10px; }
        .top-nav-links { 
          position: static !important; 
          margin: 20px auto; 
          justify-content: center; 
        }
      }
    </style>
  </head>
  <body>
    <!-- TOP LINKS FOR LOGIN PAGES -->
    <% unless user_signed_in? %>
      <div class="top-nav-links">
        <%= link_to "Sign up", new_user_registration_path %>
        <%= link_to "Forgot password?", new_user_password_path %>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
