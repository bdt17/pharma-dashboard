def print_roadmap
  ROADMAP.each do |phase, data|
    puts "\n" + "="*80
    puts data[:title].colorize(:green).bold
    puts "Status: #{data[:status]} | Effort: #{data[:effort]} | Impact: #{data[:impact]}".colorize(:yellow)
    puts "="*80
    
    data[:tasks].each do |task|
      case task
      when /\A✅/
        puts "✅ #{task.sub('✅ ', '')}".colorize(:green)
      when /\A⬜/
        puts "⬜ #{task.sub('⬜ ', '')}".colorize(:red)
      end
    end
  end
end

