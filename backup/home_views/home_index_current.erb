<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white min-h-screen text-gray-900 p-0 m-0">
  <!-- EXACT NAVBAR FROM YOUR SCREENSHOT -->
  <nav class="bg-white border-b shadow-sm py-3 px-4">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center">
        <span class="text-2xl mr-3">💉</span>
        <h1 class="text-lg font-bold text-[#0984C0]">Pharma Transport</h1>
      </div>
      <div class="flex space-x-6">
        <a href="#" class="text-gray-700 hover:text-gray-900">Dashboard</a>
        <a href="#" class="text-gray-700 hover:text-gray-900">Shipments</a>
        <a href="#" class="text-gray-700 hover:text-gray-900">Fleet</a>
        <a href="#" class="text-gray-700 hover:text-gray-900">Reports</a>
      </div>
      <div>
        <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
          Sign in
        </button>
      </div>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Welcome to Pharma Transport</h2>
    <p class="text-gray-600 mb-8">
      Secure, temperature‑controlled logistics for pharmaceuticals and medical supplies.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-blue-50 p-6 rounded-lg border">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Live Tracking</h3>
        <p class="text-gray-600">
          Monitor shipments in real time with GPS and temperature telemetry.
        </p>
      </div>
      <div class="bg-blue-50 p-6 rounded-lg border">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Compliance</h3>
        <p class="text-gray-600">
          Automated logs and alerts to meet cGMP and FDA requirements.
        </p>
      </div>
      <div class="bg-blue-50 p-6 rounded-lg border">
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Fleet Control</h3>
        <p class="text-gray-600">
          Dispatch drones and vehicles with one integrated dashboard.
        </p>
      </div>
    </div>
  </main>
</body>
</html>
