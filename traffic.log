    font-family: system-ui, -apple-system, sans-serif !important;
    min-height: 100vh;
  }
  
  /* ===== DASHBOARD ===== */
  .dashboard, main { 
    max-width: 1200px; margin: 0 auto; padding: 30px; 
    background: #1e3c72 !important; border-radius: 12px; 
  }
  
  /* ===== STATS GRID ===== */
  .stats { 
    display: grid !important; 
    grid-template-columns: repeat(3, 1fr) !important; 
    gap: 20px !important; margin: 30px 0 !important; 
  }
  .stat { 
    padding: 20px !important; 
    background: rgba(255,255,255,0.1) !important; 
    border-radius: 8px !important; text-align: center !important;
  }
  
  /* ===== GREEN STATS ===== */
  .number, [class*="mrr"], [class*="batch"] { 
    font-size: 40px !important; font-weight: bold !important; 
    color: #00ff88 !important; 
  }
  .green { color: #00ff88 !important; }
  
  /* ===== DEVISE FORMS ===== */
  .devise-form, form { 
    max-width: 400px; margin: 40px auto; padding: 30px; 
    background: rgba(30,60,114,0.9) !important; border-radius: 12px;
  }
  input[type="email"], input[type="password"], input[type="submit"] { 
    width: 100% !important; padding: 12px !important; margin: 10px 0 !important; 
    background: rgba(255,255,255,0.9) !important; border: none !important; 
    border-radius: 6px !important; font-size: 16px !important;
  }
  input[type="submit"] { 
    background: #00ff88 !important; color: #000 !important; 
    font-weight: bold !important; cursor: pointer !important;
  }
  
  /* ===== BUTTONS ===== */
  .button, a[href*="/sign"], a[href*="password"] { 
    display: inline-block !important; padding: 12px 24px !important; 
    background: #00ff88 !important; color: #000 !important; 
    text-decoration: none !important; border-radius: 8px !important; 
    font-weight: bold !important; margin: 5px;
  }
  
  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) { 
    .stats { grid-template-columns: 1fr !important; } 
  }
</style>
