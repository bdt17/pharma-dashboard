class BatchesController < ApplicationController
  before_action :set_batch, only: [:show, :chain_of_custody]

  def index
    @batches = Batch.all
    render 'index'
  end

  def show
    render 'show'
  end

  def chain_of_custody
    pdf_content = <<~PDF
      %PDF-1.4
      1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj
      2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj
      3 0 obj<</Type/Page/MediaBox[0 0 612 792]/Parent 2 0 R>>endobj
      4 0 obj<</Length 44>>stream
      BT /F1 24 Tf 100 700 Td (FDA CHAIN OF CUSTODY) Tj ET
      endstream endobj
      xref
      0 5
      0000000000 65535 f 
      0000000010 00000 n 
      0000000075 00000 n 
      0000000120 00000 n 
      0000000200 00000 n 
      trailer<</Size 5/Root 1 0 R>>
      startxref
      300
      %%EOF
    PDF

    respond_to do |format|
      format.pdf do
        send_data pdf_content,
                  filename: "chain_of_custody_#{@batch&.lot_number || 'LOT-1'}.pdf",
                  type: 'application/pdf',
                  disposition: 'attachment',
                  status: :ok
      end
      format.html { render plain: 'PDF Download: ' + chain_of_custody_batch_path(@batch, format: :pdf) }
    end
  end

  private

  def set_batch
    @batch = Batch.find(params[:id])
  end
end
