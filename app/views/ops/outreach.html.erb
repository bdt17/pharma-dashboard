<% content_for :title, "Outreach kit — Pharma Transport" %>
<% content_for :crumb, "Ops / Outreach" %>

<div class="p-7 max-w-4xl">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-[24px]">Outreach kit</h1>
      <span class="text-[13px] text-ink-faint">
        Tagged links, the funnel they feed, and ready-to-send messages.
        <% if DeadlineOffer.active? %>Free setup offer: <%= pluralize(DeadlineOffer.days_left, "day") %> left (ends <%= DeadlineOffer.label %>).<% end %>
      </span>
    </div>
    <%= link_to "Back to ops", ops_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <div id="funnel" class="card overflow-hidden">
    <div class="px-4 py-3 border-b border-line-soft flex flex-wrap items-center gap-2.5">
      <span class="font-sans text-[13px] font-semibold">Funnel by campaign</span>
      <span class="text-[12px] text-ink-faint">First-touch source / campaign. Signups and trials are customer orgs only.</span>
      <span class="ml-auto flex gap-1.5">
        <% { "30" => "30 days", "90" => "90 days", "all" => "All time" }.each do |key, label| %>
          <%= link_to label, ops_outreach_path(window: key, anchor: "funnel"),
                class: "btn btn-sm #{@funnel.window == key ? 'btn-primary' : 'btn-secondary'}" %>
        <% end %>
      </span>
    </div>
    <% if @funnel.rows.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-[13px]">
          <thead>
            <tr class="text-left text-[11.5px] text-ink-faint">
              <th class="px-4 py-2 font-medium">Source / campaign</th>
              <% %w[Checks Email PDF Calls Signups Trial/paid].each do |heading| %>
                <th class="px-3 py-2 font-medium text-right"><%= heading %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% (@funnel.rows + [ @funnel.totals ]).each_with_index do |row, i| %>
              <% total = i == @funnel.rows.size %>
              <tr class="border-t border-line-soft <%= 'font-semibold' if total %>">
                <td class="px-4 py-2 mono text-[12px]"><%= total ? "Total" : row.label %></td>
                <% %i[checks emails pdfs calls signups converted].each do |col| %>
                  <td class="px-3 py-2 mono text-[12px] text-right <%= 'text-ink-faint' if row.public_send(col).zero? %>"><%= row.public_send(col) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-3 text-[12.5px] text-ink-faint">Nothing in this window yet. Send the first messages below.</p>
    <% end %>
  </div>

  <div id="builder" class="card mt-5">
    <div class="px-4 py-3 border-b border-line-soft">
      <span class="font-sans text-[13px] font-semibold">Campaign link builder</span>
      <span class="text-[12px] text-ink-faint ml-2">Use a new campaign name per list or newsletter so each gets its own funnel row.</span>
    </div>
    <%= form_with url: ops_outreach_path(anchor: "builder"), method: :get, local: true, class: "px-4 py-3 flex flex-wrap items-end gap-3" do %>
      <%= hidden_field_tag :window, @funnel.window %>
      <label class="flex flex-col gap-1 text-[12px] text-ink-soft">
        Landing page
        <%= select_tag :page, options_for_select(Ops::OutreachKit::LANDING_PAGES.map { |key, (label, _)| [ label, key ] }, @builder[:page]),
              class: "border border-line rounded px-2 py-1.5 text-[13px]" %>
      </label>
      <label class="flex flex-col gap-1 text-[12px] text-ink-soft">
        Source
        <%= select_tag :source, options_for_select(Ops::OutreachKit::SOURCES, @builder[:source]),
              class: "border border-line rounded px-2 py-1.5 text-[13px]" %>
      </label>
      <label class="flex flex-col gap-1 text-[12px] text-ink-soft grow">
        Campaign
        <%= text_field_tag :campaign, @builder[:campaign], placeholder: "az-pharmacy-assoc-dec", required: true, class: "field-input mono" %>
      </label>
      <%= submit_tag "Build link", name: nil, class: "btn btn-primary btn-sm" %>
    <% end %>
    <% if @built_link %>
      <div class="px-4 pb-4">
        <textarea readonly rows="2" aria-label="Built campaign link" class="w-full bg-paper border border-line rounded px-3 py-1.5 mono text-[12px] break-all" data-controller="select-on-click" data-action="click->select-on-click#select"><%= @built_link %></textarea>
      </div>
    <% end %>
  </div>

  <div id="templates" class="flex flex-col gap-5 mt-5">
    <% @kit.templates.each do |template| %>
      <div id="template-<%= template.key %>" class="card">
        <div class="px-4 py-3 border-b border-line-soft">
          <div class="font-sans text-[13px] font-semibold"><%= template.title %></div>
          <div class="text-[12px] text-ink-faint"><%= template.when_to_use %></div>
        </div>
        <div class="px-4 py-3 flex flex-col gap-2">
          <% if template.subject %>
            <label class="text-[12px] text-ink-soft">Subject
              <input type="text" readonly value="<%= template.subject %>" class="mt-1 w-full bg-paper border border-line rounded px-3 py-1.5 text-[13px]" data-controller="select-on-click" data-action="click->select-on-click#select">
            </label>
          <% end %>
          <label class="text-[12px] text-ink-soft"><%= template.subject ? "Body" : "Message" %>
            <textarea readonly rows="<%= template.body.lines.sum { |line| (line.length / 90) + 1 } + 1 %>" class="field-sizing-content mt-1 w-full bg-paper border border-line rounded px-3 py-2 text-[13px] leading-relaxed" data-controller="select-on-click" data-action="click->select-on-click#select"><%= template.body %></textarea>
          </label>
          <span class="text-[11.5px] text-ink-faint">Click to select, then copy. Replace the [bracketed] parts before sending.</span>
        </div>
      </div>
    <% end %>
  </div>
</div>
