<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport - Enterprise Cold Chain SaaS</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio"></script>
  <script>
    tailwind.config = {
      corePlugins: { preflight: false }
    }
  </script>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-emerald-50 min-h-screen antialiased">

  <!-- SINGLE Nav - scrolls with page (KEEP THIS ONE) -->
  <nav class="bg-white/90 backdrop-blur-xl shadow-lg border-b border-white/60 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="text-3xl">💉</div>
          <h1 class="text-2xl font-bold bg-gradient-to-r from-gray-900 to-blue-900 bg-clip-text text-transparent">Pharma Transport</h1>
        </div>
        <div class="flex space-x-3">
          <a href="/dashboard" class="px-5 py-2.5 bg-blue-50 text-blue-700 rounded-xl font-semibold hover:bg-blue-100 transition-all">Dashboard</a>
          <a href="/vehicles" class="px-5 py-2.5 bg-emerald-50 text-emerald-700 rounded-xl font-semibold hover:bg-emerald-100 transition-all">Vehicles</a>
          <a href="/batches" class="px-5 py-2.5 bg-purple-50 text-purple-700 rounded-xl font-semibold hover:bg-purple-100 transition-all">Batches</a>
          <a href="/users/sign_in" class="px-6 py-2.5 bg-gradient-to-r from-emerald-500 to-blue-600 text-white rounded-xl font-semibold hover:shadow-lg transition-all">Login</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <div class="max-w-6xl mx-auto px-6 py-20">
    <div class="text-center mb-20">
      <div class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-100 to-blue-100 text-emerald-800 rounded-2xl text-sm font-bold mb-12 shadow-lg">
        🚀 Phase 10 LIVE - $5M ARR Target Q4 2026
      </div>
      <div class="text-7xl mb-8">💉</div>
      <h1 class="text-5xl md:text-7xl font-black bg-gradient-to-r from-gray-900 via-blue-900 to-emerald-800 bg-clip-text text-transparent mb-8 leading-tight">
        Enterprise Cold Chain<br><span class="text-4xl md:text-6xl bg-gradient-to-r from-emerald-500 to-blue-600">SaaS Platform</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-700 mb-12 max-w-3xl mx-auto leading-relaxed font-light">
        Real-time Queclink GPS tracking | DSCSA 2-8°C compliance | Multi-tenant pharmacy dashboard | 21 CFR Part 11 audit trail
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-20">
        <a href="/users/sign_in" class="group bg-gradient-to-r from-emerald-500 to-blue-600 text-white px-12 py-6 rounded-3xl font-bold text-xl shadow-2xl hover:shadow-3xl hover:-translate-y-1 transition-all duration-300">
          🔐 Enterprise Login <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a href="/subscribe" class="border-4 border-gray-200 bg-white/80 px-12 py-6 rounded-3xl font-bold text-xl hover:bg-gray-50 hover:shadow-2xl transition-all duration-300">
          💳 Start Free Trial
        </a>
      </div>
      
      <!-- Live Stats -->
      <div class="grid md:grid-cols-4 gap-8 mb-20">
        <div class="text-center p-8 bg-white/80 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/60 hover:shadow-3xl transition-all">
          <div class="text-4xl font-black text-emerald-600 mb-2"><%= @vehicles_count %></div>
          <div class="text-gray-700 font-semibold text-lg">Vehicles LIVE</div>
        </div>
        <div class="text-center p-8 bg-white/80 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/60 hover:shadow-3xl transition-all">
          <div class="text-4xl font-black text-blue-600 mb-2"><%= @active_batches %></div>
          <div class="text-gray-700 font-semibold text-lg">Active Batches</div>
        </div>
        <div class="text-center p-8 bg-white/80 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/60 hover:shadow-3xl transition-all">
          <div class="text-4xl font-black text-purple-600 mb-2"><%= @mrr_potential %></div>
          <div class="text-gray-700 font-semibold text-lg">MRR Potential</div>
        </div>
        <div class="text-center p-8 bg-white/80 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/60 hover:shadow-3xl transition-all">
          <div class="text-4xl font-black text-orange-600 mb-2"><%= @compliance_rate %></div>
          <div class="text-gray-700 font-semibold text-lg">DSCSA Compliance</div>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="grid md:grid-cols-3 gap-12 mb-24">
      <% @features.each do |feature| %>
        <div class="group p-8 rounded-3xl bg-white/70 backdrop-blur-xl shadow-xl border border-white/50 hover:shadow-3xl hover:-translate-y-2 transition-all">
          <div class="text-6xl mb-8"><%= feature[:icon] %></div>
          <h3 class="text-3xl font-bold text-gray-900 mb-6 group-hover:text-emerald-600 transition"><%= feature[:title] %></h3>
          <p class="text-lg text-gray-600 leading-relaxed"><%= feature[:description] %></p>
        </div>
      <% end %>
    </div>

    <!-- Compliance -->
    <div class="bg-white/70 backdrop-blur-2xl rounded-3xl p-16 mb-24 shadow-3xl border border-white/60">
      <h2 class="text-5xl font-black text-center text-gray-900 mb-16 bg-gradient-to-r from-gray-900 to-emerald-800 bg-clip-text text-transparent">
        Regulatory Compliance Guaranteed
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
        <% @compliance_standards.each do |standard| %>
          <div class="text-center group hover:scale-105 transition">
            <div class="text-6xl mb-6 mx-auto"><%= standard[:icon] %></div>
            <h4 class="text-2xl font-bold text-gray-900 mb-4"><%= standard[:title] %></h4>
            <p class="text-gray-600 font-medium"><%= standard[:desc] %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Final CTA -->
    <div class="text-center py-32">
      <h2 class="text-5xl md:text-6xl font-black bg-gradient-to-r from-gray-900 via-blue-900 to-emerald-800 bg-clip-text text-transparent mb-8">
        Ready to Protect Your Cold Chain?
      </h2>
      <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-2xl mx-auto">
        Join 47+ vehicles already protected. Enterprise login available 24/7 from Phoenix, AZ HQ.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="/users/sign_in" class="bg-gradient-to-r from-emerald-500 to-blue-600 text-white px-16 py-7 rounded-3xl font-bold text-xl shadow-2xl hover:shadow-3xl hover:scale-105 transition-all">
          🚀 Launch Dashboard Now
        </a>
        <a href="/subscribe" class="border-4 border-emerald-200 bg-emerald-50/80 px-16 py-7 rounded-3xl font-bold text-xl hover:bg-emerald-100 hover:shadow-2xl transition-all">
          💳 14-Day Free Trial
        </a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-gradient-to-t from-slate-900 via-gray-900 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-20">
      <div class="grid md:grid-cols-4 gap-12 text-white">
        <div>
          <div class="flex items-center space-x-4 mb-8">
            <div class="text-4xl">💉</div>
            <h3 class="text-3xl font-bold bg-gradient-to-r from-white to-emerald-200 bg-clip-text text-transparent">Pharma Transport</h3>
          </div>
          <p class="text-gray-400 leading-relaxed max-w-md text-lg">Enterprise Cold Chain SaaS built for pharmacies. Phoenix, AZ HQ serving nationwide with Queclink GV55 GPS tracking.</p>
        </div>
        <div><h4 class="text-2xl font-bold mb-8">Product</h4><ul class="space-y-3 text-gray-300"><li><a href="/dashboard" class="hover:text-white">Dashboard</a></li><li><a href="/vehicles" class="hover:text-white">Vehicles</a></li><li><a href="/batches" class="hover:text-white">Batches</a></li><li><a href="/subscribe" class="hover:text-white">Pricing</a></li></ul></div>
        <div><h4 class="text-2xl font-bold mb-8">Company</h4><ul class="space-y-3 text-gray-300"><li><a href="/about" class="hover:text-white">About</a></li><li><a href="/careers" class="hover:text-white">Careers</a></li><li><a href="/contact" class="hover:text-white">Contact</a></li></ul></div>
        <div><h4 class="text-2xl font-bold mb-8">Support</h4><ul class="space-y-3 text-gray-300"><li><a href="/docs" class="hover:text-white">Documentation</a></li><li><a href="/status" class="hover:text-white">Status</a></li><li><a href="/support" class="hover:text-white">Support</a></li></ul></div>
      </div>
      <div class="border-t border-white/20 mt-16 pt-12 text-center text-gray-400 text-lg">
        <p>© 2026 Pharma Transport Inc. Phoenix, AZ. All rights reserved. DSCSA | 21 CFR Part 11 Compliant.</p>
      </div>
    </div>
  </footer>

</body>
</html>
