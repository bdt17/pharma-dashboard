<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-gray-900 text-white">
  <div class="max-w-6xl mx-auto p-8">
    <h1 class="text-5xl font-bold mb-12 text-yellow-400">💉 Pharma Transport</h1>
    <p class="text-2xl mb-16">Phase 14 LIVE • 24 GPS Vehicles • 127 Batches</p>
    
    <div class="grid md:grid-cols-3 gap-12 mb-16">
      <div class="bg-blue-600 p-12 rounded-2xl text-center">
        <div class="text-6xl mb-6">🚛</div>
        <div class="text-4xl font-bold mb-4">24</div>
        <p class="text-xl">Live Vehicles<br>GPS Tracked • Real-time</p>
      </div>
      
      <div class="bg-emerald-600 p-12 rounded-2xl text-center">
        <div class="text-6xl mb-6">📦</div>
        <div class="text-4xl font-bold mb-4">127</div>
        <p class="text-xl">Active Batches<br>FDA Compliant</p>
      </div>
      
      <div class="bg-yellow-500 p-12 rounded-2xl text-center">
        <div class="text-6xl mb-6">💰</div>
        <div class="text-4xl font-bold mb-4">$12K</div>
        <p class="text-xl">Monthly Revenue<br>Phase 14 Growth +18%</p>
      </div>
    </div>
    
    <div class="text-center">
      <a href="/gps" class="bg-blue-600 hover:bg-blue-700 text-white px-12 py-6 rounded-2xl text-2xl font-bold inline-block">
        🚚 LIVE GPS DASHBOARD
      </a>
    </div>
    
    <div class="mt-16 text-center text-lg text-gray-300">
      🔒 FDA 21 CFR Part 11 • 📡 24/7 GPS • 🤖 AI Anomaly Detection • ⚙️ Rails 8.1
    </div>
  </div>
</body>
</html>
