<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-b from-blue-50 to-white min-h-screen">
  
  <!-- SINGLE Clean Nav like your dashboard -->
  <nav class="bg-white/80 backdrop-blur-md border-b border-blue-100 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="text-2xl">💉</div>
          <h1 class="text-xl font-bold text-gray-900">Pharma Transport</h1>
        </div>
        <div class="flex space-x-3 text-sm">
          <a href="/dashboard" class="px-4 py-2 text-blue-600 font-medium hover:bg-blue-50 rounded-lg">Dashboard</a>
          <a href="/vehicles" class="px-4 py-2 text-gray-700 font-medium hover:bg-gray-50 rounded-lg">Fleet</a>
          <a href="/batches" class="px-4 py-2 text-gray-700 font-medium hover:bg-gray-50 rounded-lg">Batches</a>
          <a href="/users/sign_in" class="px-6 py-2 bg-gradient-to-r from-emerald-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg">Login</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero matching dashboard style -->
  <div class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-20">
      <div class="inline-flex items-center px-4 py-2 bg-emerald-100 text-emerald-800 rounded-full text-sm font-semibold mb-8 mx-auto">
        🚀 Phase 10 LIVE
      </div>
      <div class="text-6xl mb-8 mx-auto">💉</div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
        Chain of Custody<br>
        <span class="text-3xl md:text-4xl text-blue-600">GPS Tracking</span>
      </h1>
      <p class="text-lg text-gray-600 mb-12 max-w-2xl mx-auto leading-relaxed">
        Real-time Queclink GPS | DSCSA 2-8°C compliance | 21 CFR Part 11 audit trail
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a href="/users/sign_in" class="bg-gradient-to-r from-emerald-500 to-blue-600 text-white px-8 py-4 rounded-xl font-semibold text-lg shadow-lg hover:shadow-xl">🔐 Login</a>
        <a href="/subscribe" class="border-2 border-gray-200 bg-white px-8 py-4 rounded-xl font-semibold text-lg hover:shadow-md">💳 Free Trial</a>
      </div>
    </div>

    <!-- Dashboard-style cards -->
    <div class="grid md:grid-cols-3 gap-6 mb-20">
      <div class="bg-white/70 backdrop-blur-xl rounded-2xl p-8 border border-blue-100 shadow-lg hover:shadow-xl transition-all">
        <div class="text-4xl mb-4">📄</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Chain of Custody</h3>
        <p class="text-gray-600 mb-6">21 CFR Part 11 PDFs</p>
        <a href="/batches" class="w-full bg-gradient-to-r from-orange-500 to-red-600 text-white py-3 px-6 rounded-xl font-semibold text-center block hover:shadow-lg">Download PDF</a>
      </div>
      <div class="bg-white/70 backdrop-blur-xl rounded-2xl p-8 border border-blue-100 shadow-lg hover:shadow-xl transition-all">
        <div class="text-4xl mb-4">🚚</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Live Fleet</h3>
        <p class="text-gray-600 mb-6"><span class="font-bold text-2xl text-emerald-600"><%= @vehicles_count %></span> Vehicles</p>
        <a href="/vehicles" class="w-full bg-blue-500 text-white py-3 px-6 rounded-xl font-semibold text-center block hover:shadow-lg">View Fleet</a>
      </div>
      <div class="bg-white/70 backdrop-blur-xl rounded-2xl p-8 border border-blue-100 shadow-lg hover:shadow-xl transition-all">
        <div class="text-4xl mb-4">🩺</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Health Check</h3>
        <p class="text-gray-600 mb-6">DSCSA 2-8°C compliance</p>
        <a href="/health" class="w-full bg-emerald-500 text-white py-3 px-6 rounded-xl font-semibold text-center block hover:shadow-lg">Status</a>
      </div>
    </div>

    <!-- Footer matching dashboard -->
    <footer class="bg-gradient-to-r from-slate-900 to-gray-900 text-white border-t border-white/10 mt-24">
      <div class="max-w-4xl mx-auto px-6 py-12 text-center">
        <p class="text-gray-400 text-sm">© 2026 Thomas IT Network. Phoenix, AZ.</p>
      </div>
    </footer>
  </div>
</body>
</html>
