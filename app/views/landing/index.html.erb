<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-b from-blue-50 to-white min-h-screen antialiased">
  
  <!-- SINGLE Nav ONLY -->
  <nav class="bg-white/90 backdrop-blur-xl shadow-sm border-b border-blue-100/50 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-6 py-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="text-2xl">💉</div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-gray-900 to-blue-900 bg-clip-text text-transparent">Pharma Transport</h1>
        </div>
        <div class="flex space-x-2 text-sm">
          <a href="/dashboard" class="px-4 py-2 text-blue-600 font-medium hover:bg-blue-50 rounded-xl transition-all">Dashboard</a>
          <a href="/vehicles" class="px-4 py-2 text-gray-700 font-medium hover:bg-gray-50 rounded-xl transition-all">Fleet</a>
          <a href="/batches" class="px-4 py-2 text-gray-700 font-medium hover:bg-gray-50 rounded-xl transition-all">Batches</a>
          <a href="/users/sign_in" class="px-6 py-2 bg-gradient-to-r from-emerald-500 to-blue-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all">Login</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero with PDF FIRST -->
  <div class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-20">
      <div class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-100 via-blue-100 to-emerald-100 text-emerald-800 rounded-2xl text-sm font-bold mb-12 shadow-lg backdrop-blur-sm">
        🚀 Phase 10 LIVE
      </div>
      <div class="text-6xl mb-8">💉</div>
      <h1 class="text-4xl md:text-6xl font-black bg-gradient-to-r from-gray-900 via-blue-900 to-emerald-800 bg-clip-text text-transparent mb-6 leading-tight">
        Chain of Custody<br><span class="text-3xl md:text-5xl bg-gradient-to-r from-emerald-500 to-blue-600">GPS Tracking</span>
      </h1>
      
      <!-- MONEY MAKER PDF BUTTON -->
      <div class="mb-12">
        <a href="/batches/1/chain-of-custody.pdf" class="inline-flex items-center bg-gradient-to-r from-orange-500 via-red-600 to-orange-600 text-white px-10 py-5 rounded-2xl font-bold text-xl shadow-2xl hover:shadow-3xl hover:scale-105 transition-all duration-300 transform">
          📄 Download Chain of Custody PDF
          <span class="ml-3 text-lg">→</span>
        </a>
      </div>
      
      <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-2xl mx-auto leading-relaxed">
        Real-time Queclink GPS | DSCSA 2-8°C compliance | 21 CFR Part 11 audit trail
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a href="/users/sign_in" class="bg-gradient-to-r from-emerald-500 to-blue-600 text-white px-12 py-5 rounded-2xl font-bold text-xl shadow-2xl hover:shadow-3xl hover:scale-105 transition-all duration-300">🔐 Enterprise Login</a>
        <a href="/subscribe" class="border-3 border-gray-200 bg-white/80 px-12 py-5 rounded-2xl font-bold text-xl hover:shadow-2xl hover:border-gray-300 transition-all backdrop-blur-xl">💳 Start Free Trial</a>
      </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="grid md:grid-cols-3 gap-8 mb-24">
      <div class="group bg-white/80 backdrop-blur-xl rounded-3xl p-10 border border-blue-100/50 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
        <div class="text-5xl mb-6 group-hover:scale-110 transition-transform"><%= @vehicles_count || 47 %></div>
        <div class="text-4xl mb-4">📄</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Chain of Custody</h3>
        <p class="text-gray-600 mb-8 text-lg">21 CFR Part 11 compliant PDFs</p>
        <a href="/batches/1/chain-of-custody.pdf" class="w-full bg-gradient-to-r from-orange-500 to-red-600 text-white py-4 px-8 rounded-2xl font-bold text-center block shadow-lg hover:shadow-xl transition-all">Download PDF</a>
      </div>
      <div class="group bg-white/80 backdrop-blur-xl rounded-3xl p-10 border border-blue-100/50 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
        <div class="text-4xl mb-4">🚚</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Live Fleet</h3>
        <p class="text-gray-600 mb-8 text-lg"><span class="font-bold text-3xl text-emerald-600"><%= @vehicles_count || 47 %></span> Vehicles tracked</p>
        <a href="/vehicles" class="w-full bg-gradient-to-r from-blue-500 to-blue-600 text-white py-4 px-8 rounded-2xl font-bold text-center block shadow-lg hover:shadow-xl transition-all">View Fleet</a>
      </div>
      <div class="group bg-white/80 backdrop-blur-xl rounded-3xl p-10 border border-blue-100/50 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
        <div class="text-4xl mb-4">🩺</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Health Check</h3>
        <p class="text-gray-600 mb-8 text-lg">DSCSA 2-8°C compliance monitoring</p>
        <a href="/health" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 text-white py-4 px-8 rounded-2xl font-bold text-center block shadow-lg hover:shadow-xl transition-all">View Status</a>
      </div>
    </div>
  </div>

  <!-- FANCY Gradient Footer -->
  <footer class="bg-gradient-to-br from-slate-900 via-blue-900 to-emerald-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/20 via-transparent to-blue-500/20"></div>
    <div class="relative max-w-4xl mx-auto px-6 py-16 text-center">
      <div class="flex items-center justify-center space-x-4 mb-8">
        <div class="text-3xl">💉</div>
        <h3 class="text-2xl font-bold bg-gradient-to-r from-white to-emerald-200 bg-clip-text text-transparent">Pharma Transport</h3>
      </div>
      <div class="grid md:grid-cols-3 gap-8 mb-12 text-sm text-gray-300 max-w-2xl mx-auto">
        <div>
          <h4 class="font-bold text-white mb-4">Enterprise Cold Chain</h4>
          <p>Queclink GV55 GPS tracking with DSCSA compliance</p>
        </div>
        <div>
          <h4 class="font-bold text-white mb-4">Phase 10 LIVE</h4>
          <p>47 vehicles | $99k MRR potential | Phoenix, AZ HQ</p>
        </div>
        <div>
          <h4 class="font-bold text-white mb-4">Compliance</h4>
          <p>21 CFR Part 11 | DSCSA 503B | HIPAA</p>
        </div>
      </div>
      <div class="border-t border-white/20 pt-8">
        <p class="text-lg font-semibold bg-gradient-to-r from-emerald-300 to-blue-300 bg-clip-text text-transparent">
          © 2026 Thomas IT Network · Phoenix, Arizona
        </p>
      </div>
    </div>
  </footer>

</body>
</html>
