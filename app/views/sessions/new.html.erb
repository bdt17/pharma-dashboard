<div class="max-w-md mx-auto mt-10 p-8 bg-white rounded-xl shadow-md">
  <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">🔐 Login</h2>
  
  <%= form_with url: login_path, local: true do |f| %>
    <div class="mb-6">
      <%= f.label :email, "Email", class: "block text-gray-700 font-medium mb-2" %>
      <%= f.email_field :email, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500", placeholder: "driver1@thomasit.com", required: true %>
    </div>
    
    <div class="mb-6">
      <%= f.label :password, "Password", class: "block text-gray-700 font-medium mb-2" %>
      <%= f.password_field :password, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500", placeholder: "•••••••", required: true %>
    </div>
    
    <%= f.submit "Login", class: "w-full bg-blue-600 text-white py-3 px-4 rounded-lg font-semibold hover:bg-blue-700 transition duration-200" %>
  <% end %>
  
  <div class="mt-6 text-center">
    <p class="text-gray-600">Demo Accounts:</p>
    <div class="mt-2 space-y-1 text-sm">
      <p><strong>Driver:</strong> driver1@thomasit.com / truck123</p>
      <p><strong>Manager:</strong> manager@thomasit.com / pharma456</p>
      <p><strong>Admin:</strong> admin@thomasit.com / admin789</p>
    </div>
  </div>
</div>
