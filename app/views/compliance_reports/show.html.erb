<div class="max-w-2xl mx-auto p-8">
  <h1 class="text-2xl font-bold mb-4">Compliance packet v<%= @compliance_report.version %> — <%= @batch.lot_number %></h1>

  <dl class="grid grid-cols-3 gap-y-3 border rounded-lg p-6 mb-6">
    <dt class="text-gray-500">Generated</dt>
    <dd class="col-span-2"><%= @compliance_report.created_at.strftime("%Y-%m-%d %H:%M %Z") %></dd>

    <dt class="text-gray-500">Generated by</dt>
    <dd class="col-span-2"><%= @compliance_report.generated_by.email %></dd>

    <dt class="text-gray-500">Content hash (SHA-256)</dt>
    <dd class="col-span-2 font-mono text-xs break-all"><%= @compliance_report.content_hash %></dd>

    <% if @compliance_report.previous_hash %>
      <dt class="text-gray-500">Previous version's hash</dt>
      <dd class="col-span-2 font-mono text-xs break-all"><%= @compliance_report.previous_hash %></dd>
    <% end %>
  </dl>

  <p class="text-xs text-gray-400 mb-6">
    This hash lets you verify a copy of this file hasn't changed since it was issued --
    it is tamper-evident, not tamper-proof, and is not on its own a certification of
    regulatory compliance.
  </p>

  <%= link_to "Download PDF", batch_compliance_report_download_path(@batch, @compliance_report), class: "bg-blue-600 text-white px-4 py-2 rounded" %>
  <%= link_to "← All versions", batch_compliance_reports_path(@batch), class: "ml-4 text-blue-600 underline" %>
</div>
