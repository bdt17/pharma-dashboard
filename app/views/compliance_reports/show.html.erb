<% content_for :title, "Compliance packet — Pharma Transport" %>
<% content_for :crumb, "Compliance packet" %>

<div class="p-7 max-w-2xl">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-[24px]">Compliance packet v<%= @compliance_report.version %></h1>
      <span class="text-[13px] text-ink-faint">
        Lot <span class="mono"><%= @batch.lot_number %></span>
      </span>
    </div>
    <%= link_to "Download PDF", batch_compliance_report_download_path(@batch, @compliance_report), class: "btn btn-primary btn-sm shrink-0" %>
  </div>

  <dl class="card p-6 grid grid-cols-3 gap-y-3 text-[14px]">
    <dt class="text-ink-faint">Generated</dt>
    <dd class="col-span-2 mono"><%= @compliance_report.created_at.strftime("%Y-%m-%d %H:%M %Z") %></dd>

    <dt class="text-ink-faint">Generated by</dt>
    <dd class="col-span-2"><%= @compliance_report.generated_by.email %></dd>

    <dt class="text-ink-faint">Content hash (SHA-256)</dt>
    <dd class="col-span-2 mono text-[12px] break-all"><%= @compliance_report.content_hash %></dd>

    <% if @compliance_report.previous_hash %>
      <dt class="text-ink-faint">Previous version's hash</dt>
      <dd class="col-span-2 mono text-[12px] break-all"><%= @compliance_report.previous_hash %></dd>
    <% end %>
  </dl>

  <p class="text-[12px] text-ink-faint mt-4">
    This hash lets you verify a copy of this file hasn't changed since it was issued —
    it is tamper-evident, not tamper-proof, and is not on its own a certification of
    regulatory compliance.
  </p>

  <p class="text-[13px] mt-4">
    <%= link_to "← All versions", batch_compliance_reports_path(@batch), class: "font-medium" %>
  </p>
</div>
