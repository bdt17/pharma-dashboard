<div class="max-w-4xl mx-auto p-8">
  <h1 class="text-2xl font-bold mb-2">Compliance packets — <%= @batch.lot_number %></h1>
  <p class="text-sm text-gray-500 mb-6">
    <%= link_to "View custody history", batch_custody_logs_path(@batch) %>
  </p>

  <% if policy(@batch).generate_compliance_report? %>
    <%= button_to "Generate new compliance packet", batch_compliance_reports_path(@batch), method: :post, class: "bg-blue-600 text-white px-4 py-2 rounded mb-6" %>
  <% end %>

  <% if @compliance_reports.empty? %>
    <p class="text-gray-500">No compliance packets generated yet.</p>
  <% else %>
    <table class="w-full border-collapse border border-gray-300">
      <thead>
        <tr class="bg-gray-100">
          <th class="border border-gray-300 p-2 text-left">Version</th>
          <th class="border border-gray-300 p-2 text-left">Generated</th>
          <th class="border border-gray-300 p-2 text-left">By</th>
          <th class="border border-gray-300 p-2 text-left">Hash</th>
          <th class="border border-gray-300 p-2 text-left"></th>
        </tr>
      </thead>
      <tbody>
        <% @compliance_reports.each do |report| %>
          <tr>
            <td class="border border-gray-300 p-2"><%= link_to "v#{report.version}", batch_compliance_report_path(@batch, report) %></td>
            <td class="border border-gray-300 p-2"><%= report.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="border border-gray-300 p-2"><%= report.generated_by.email %></td>
            <td class="border border-gray-300 p-2 font-mono text-xs"><%= report.content_hash[0, 12] %>…</td>
            <td class="border border-gray-300 p-2"><%= link_to "Download", batch_compliance_report_download_path(@batch, report) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
