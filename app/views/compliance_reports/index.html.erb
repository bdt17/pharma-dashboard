<% content_for :title, "Compliance packets — Pharma Transport" %>
<% content_for :crumb, "Compliance packets" %>

<div class="p-7 max-w-4xl">
  <div class="flex flex-col gap-1 mb-6">
    <h1 class="text-[24px]">Compliance packets</h1>
    <span class="text-[13px] text-ink-faint">
      Lot <span class="mono"><%= @batch.lot_number %></span>
      <span class="mx-1">·</span>
      <%= link_to "View custody history", batch_custody_logs_path(@batch), class: "font-medium" %>
    </span>
  </div>

  <% if policy(@batch).generate_compliance_report? %>
    <div class="card p-4 mb-6 flex items-center justify-between gap-4">
      <div class="text-[13px]">
        <% if @quota.unlimited? %>
          <span class="text-ink-soft">Unlimited compliance packets on your current plan.</span>
        <% elsif @quota.exceeded? %>
          <span class="text-[#b42318] font-medium">Monthly limit reached</span>
          <span class="text-ink-faint">
            (<%= @quota.monthly_allowance %>/month on your current plan).
            <%= link_to "Upgrade for a higher allowance", billing_path, class: "font-medium" %>.
          </span>
        <% else %>
          <span class="text-ink-soft">
            <span class="mono"><%= @quota.remaining %></span> of
            <span class="mono"><%= @quota.monthly_allowance %></span> compliance packets left this month.
          </span>
        <% end %>
      </div>
      <%= button_to "Generate new packet", batch_compliance_reports_path(@batch), method: :post,
            class: "btn btn-primary btn-sm shrink-0", disabled: @quota.exceeded? %>
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold">Issued versions</div>
    <% if @compliance_reports.empty? %>
      <p class="px-4 py-4 text-ink-faint text-[13px]">No compliance packets generated yet.</p>
    <% else %>
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2">Version</th>
            <th class="text-left font-medium px-4 py-2">Generated</th>
            <th class="text-left font-medium px-4 py-2">By</th>
            <th class="text-left font-medium px-4 py-2">Hash</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @compliance_reports.each do |report| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5">
                <%= link_to "v#{report.version}", batch_compliance_report_path(@batch, report), class: "font-medium" %>
              </td>
              <td class="px-4 py-2.5 mono text-ink-soft"><%= report.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= report.generated_by.email %></td>
              <td class="px-4 py-2.5 mono text-[12px] text-ink-faint"><%= report.content_hash[0, 12] %>…</td>
              <td class="px-4 py-2.5 text-right">
                <%= link_to "Download", batch_compliance_report_download_path(@batch, report), class: "font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
