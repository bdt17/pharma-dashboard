<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport - Live GPS Dashboard</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 p-8 text-white font-sans">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- HEADER -->
    <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-8 shadow-2xl hover:shadow-blue-500/25 transition-all">
      <div class="flex flex-col lg:flex-row lg:items-center gap-6">
        <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-2xl flex items-center justify-center text-3xl shadow-2xl">💉</div>
        <div class="flex-1 text-center lg:text-left">
          <h1 class="text-4xl lg:text-5xl font-black bg-gradient-to-r from-blue-400 to-cyan-500 bg-clip-text text-transparent mb-3 drop-shadow-lg">Pharma Transport</h1>
          <p class="text-xl text-gray-300 font-medium">Phase 14 LIVE • 24 GPS Vehicles • 127 Batches</p>
        </div>
        <a href="https://www.pharmatransport.org/" class="px-10 py-5 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white font-black rounded-2xl shadow-2xl hover:shadow-3xl hover:-translate-y-1 transition-all duration-300 whitespace-nowrap">
          🛠️ Production Platform
        </a>
      </div>
    </div>

    <!-- GPS TRACKING GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- VEHICLE CARDS -->
      <div class="lg:col-span-3">
        <div class="bg-white/5 backdrop-blur-xl border border-white/20 rounded-3xl p-8 shadow-2xl">
          <h2 class="text-3xl font-bold mb-8 flex items-center gap-4"><span class="text-4xl">🗺️</span> Live GPS Tracking</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @vehicles.each do |vehicle| %>
              <div class="group bg-white/10 hover:bg-white/20 border border-white/30 hover:border-blue-400/60 rounded-3xl p-8 backdrop-blur-xl shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                <div class="flex items-start gap-4 mb-6">
                  <div class="w-16 h-16 flex-shrink-0 bg-gradient-to-br <%= vehicle.status == 'alert' ? 'from-red-500 to-red-400' : 'from-emerald-500 to-emerald-400' %> rounded-xl flex items-center justify-center shadow-2xl">
                    <%= vehicle.status == 'alert' ? '🚨' : '🚛' %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-mono text-lg font-bold text-gray-100 uppercase tracking-wide mb-1 truncate"><%= vehicle.id %></div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-black/30 rounded-full text-sm font-semibold <%= vehicle.status == 'alert' ? 'text-red-400 bg-red-500/20 border border-red-400/50' : 'text-emerald-400 bg-emerald-500/20 border border-emerald-400/50' %>">
                      <%= vehicle.status == 'alert' ? 'ALERT' : 'ACTIVE' %>
                    </div>
                  </div>
                </div>
                <div class="space-y-2 text-sm text-gray-300 font-mono bg-black/20 p-4 rounded-2xl backdrop-blur-sm">
                  <div>🌡️ <span class="font-bold text-white"><%= vehicle.temp %></span></div>
                  <div>⏱️ <span class="font-bold text-white"><%= vehicle.eta %></span></div>
                  <div>📍 Phoenix, AZ (Live)</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- METRICS -->
      <div class="space-y-6">
        <div class="group bg-gradient-to-b from-emerald-500/20 via-emerald-600/20 to-emerald-700/20 border-2 border-emerald-400/50 backdrop-blur-xl rounded-3xl p-8 shadow-2xl hover:shadow-emerald-500/50 hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="text-5xl group-hover:scale-110 transition-transform duration-300 mb-6">🚛</div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-200 mb-6">Live Vehicles</h3>
          <div class="text-5xl lg:text-6xl font-black text-emerald-400 mb-2">24</div>
          <div class="text-emerald-300 font-medium">Real-time</div>
        </div>

        <div class="group bg-gradient-to-b from-blue-500/20 via-blue-600/20 to-blue-700/20 border-2 border-blue-400/50 backdrop-blur-xl rounded-3xl p-8 shadow-2xl hover:shadow-blue-500/50 hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="text-5xl group-hover:scale-110 transition-transform duration-300 mb-6">📦</div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-blue-200 mb-6">Active Batches</h3>
          <div class="text-5xl lg:text-6xl font-black text-blue-400 mb-2">127</div>
          <div class="text-blue-300 font-medium">FDA Compliant</div>
        </div>

        <div class="group bg-gradient-to-b from-amber-500/20 via-amber-600/20 to-amber-700/20 border-2 border-amber-400/50 backdrop-blur-xl rounded-3xl p-8 shadow-2xl hover:shadow-amber-500/50 hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="text-5xl group-hover:scale-110 transition-transform duration-300 mb-6">💰</div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-amber-200 mb-6">Monthly Revenue</h3>
          <div class="text-5xl lg:text-6xl font-black text-amber-400 mb-2">$12K</div>
          <div class="text-amber-300 font-medium">Phase 14 Growth</div>
        </div>
      </div>
    </div>

    <!-- TECH STACK -->
    <div class="bg-white/5 backdrop-blur-xl border border-white/20 rounded-3xl p-10 text-center">
      <div class="flex flex-wrap justify-center items-center gap-10 text-xl lg:text-2xl">
        <span class="text-gray-300">⚙️ Rails 8.1.1 Solid Stack</span>
        <span class="text-emerald-400 font-bold">🟢 GPS Live</span>
        <span class="text-blue-400 font-bold">🔒 FDA Part 11</span>
        <span class="text-amber-400 font-bold">📈 Phase 14</span>
      </div>
    </div>
  </div>
</div>
