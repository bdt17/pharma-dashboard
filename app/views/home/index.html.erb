<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pharma Transport</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #FFFFFF; 
      color: #565759; 
      line-height: 1.6;
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    h1 { font-size: 3rem; font-weight: 800; color: #0984C0; margin-bottom: 1rem; }
    .subtitle { font-size: 1.5rem; font-weight: 600; color: #0984C0; margin-bottom: 0.5rem; }
    .subtext { font-size: 1.25rem; color: #C0BEC6; margin-bottom: 3rem; }
    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 3rem 0; }
    .card { 
      border: 2px solid #0984C0; 
      padding: 2rem; 
      border-radius: 12px; 
      transition: box-shadow 0.3s;
    }
    .card:hover { box-shadow: 0 10px 30px rgba(9,132,192,0.2); }
    .card h2 { font-size: 2rem; font-weight: 700; color: #0984C0; margin-bottom: 1.5rem; }
    .card h2::before { content: ''; display: inline-block; width: 32px; height: 32px; margin-right: 12px; vertical-align: middle; }
    .card h2.pharma::before { background: #0984C0; clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%); }
    .card h2.patient::before { background: #60BDD1; border-radius: 8px; }
    .card li { 
      font-size: 1.1rem; color: #AAA7B0; 
      margin-bottom: 0.75rem; 
      display: flex; align-items: center;
    }
    .card li::before { 
      content: '✓'; color: #10B981; font-weight: 800; font-size: 1.2rem; 
      margin-right: 12px; width: 20px; 
    }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; margin: 3rem 0; text-align: center; }
    .stat-number { 
      font-size: 4rem; font-weight: 800; color: #0984C0; 
      margin-bottom: 0.5rem; 
      font-family: monospace;
    }
    .stat-number::before { 
      display: inline-block; width: 48px; height: 48px; margin-right: 12px; vertical-align: middle;
    }
    .stat-number.vehicles::before { background: linear-gradient(45deg, #0984C0, #60BDD1); clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%); }
    .stat-number.orders::before { background: #0984C0; clip-path: polygon(20% 0%, 80% 0%, 100% 100%, 0% 100%); }
    .stat-number.revenue::before { background: linear-gradient(45deg, #10B981, #059669); clip-path: circle(); }
    .stat-label { font-size: 1.5rem; color: #AAA7B0; margin-bottom: 0.25rem; }
    .stat-subtext { color: #C0BEC6; }
    header, footer { border-bottom: 2px solid #0984C0; padding: 2rem 0; }
    footer { margin-top: 4rem; padding-top: 3rem !important; text-align: center; color: #C0BEC6; font-size: 1.1rem; }
    footer::before { content: ''; display: inline-block; width: 24px; height: 24px; background: #565759; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); margin-right: 8px; }
    @media (max-width: 768px) {
      .container { padding: 1rem; }
      h1 { font-size: 2.5rem; }
      .cards, .stats { grid-template-columns: 1fr; gap: 1.5rem; }
      .stat-number { font-size: 3rem; }
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1>Pharma Transport</h1>
    </div>
  </header>
  
  <main class="container">
    <div class="subtitle">PharmaTransport.org - LIVE</div>
    <div class="subtext">B2B2C Pharmacy Delivery • Phoenix Metro • Rails 8.1 Production</div>
    
    <div class="cards">
      <div class="card">
        <h2 class="pharma">Pharmacist Portal</h2>
        <ul>
          <li>Submit private orders</li>
          <li>Real-time GPS tracking</li>
          <li>FDA 21 CFR Part 11</li>
          <li>Revenue sharing model</li>
        </ul>
      </div>
      
      <div class="card">
        <h2 class="patient">Patient App</h2>
        <ul>
          <li>Order from local pharmacies</li>
          <li>Home delivery or pickup</li>
          <li>Live notifications</li>
          <li>HIPAA secure payments</li>
        </ul>
      </div>
    </div>
    
    <div class="stats">
      <div>
        <div class="stat-number vehicles">24</div>
        <div class="stat-label">Live Vehicles</div>
        <div class="stat-subtext">Phoenix Metro Coverage</div>
      </div>
      <div>
        <div class="stat-number orders">127</div>
        <div class="stat-label">Active Orders</div>
        <div class="stat-subtext">HIPAA Compliant</div>
      </div>
      <div>
        <div class="stat-number revenue">$12K</div>
        <div class="stat-label">Monthly Revenue</div>
        <div class="stat-subtext">Phase 18 Live +18% Growth</div>
      </div>
    </div>
  </main>
  
  <footer>
    <div class="container">
      Rails 8.1 Production • HIPAA/FDA Compliant • iOS & Android Ready • Phoenix Live Network
    </div>
  </footer>
</body>
</html>
