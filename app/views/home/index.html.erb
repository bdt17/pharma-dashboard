<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white min-h-screen text-gray-900 antialiased">

  <!-- SIMPLIFIED NAVBAR -->
  <nav class="bg-white border-b shadow-sm">
    <div class="max-w-4xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <span class="text-3xl">💉</span>
          <h1 class="text-xl font-bold text-blue-600">Pharma Transport</h1>
        </div>
        <div class="flex space-x-3 text-sm">
          <a href="/dashboard" class="text-gray-600 hover:text-blue-600 font-medium">Dashboard</a>
          <a href="/batches" class="text-blue-600 font-bold border-b-2 border-blue-600 pb-1">Batches</a>
          <a href="/subscribe" class="bg-blue-600 text-white px-5 py-2 rounded-lg text-xs font-bold">Pro $99/mo</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- TIGHT LAYOUT - OG SPACING -->
  <div class="max-w-4xl mx-auto px-6 py-12">
    
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-blue-600 mb-4">🩺 PHARMA DASHBOARD</h1>
      <p class="text-lg text-gray-600">Cold chain + GPS tracking</p>
    </div>

    <!-- COMPACT 2-COL -->
    <div class="grid md:grid-cols-2 gap-6">
      
      <!-- METRICS -->
      <div class="bg-gray-50 p-6 rounded-xl border">
        <h3 class="text-xl font-bold text-blue-600 mb-4">📊 Metrics</h3>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between"><span>Batches:</span><span class="font-bold text-xl text-blue-600">5</span></div>
          <div class="flex justify-between"><span>Vehicles:</span><span class="font-bold text-lg text-blue-400">2</span></div>
          <div class="flex justify-between"><span>GPS:</span><span class="font-bold text-blue-400">GV55</span></div>
        </div>
      </div>

      <!-- PDF BUTTON DOMINATES -->
      <div class="bg-blue-600 text-white p-6 rounded-xl shadow-lg">
        <div class="text-center">
          <div class="text-2xl font-bold mb-4">✅ LIVE</div>
          <p class="text-sm mb-6 opacity-90">PDF Chain of Custody ✓ GPS ✓ 21 CFR</p>
          <a href="/batches" class="block w-full bg-white text-blue-600 font-bold py-3 px-4 rounded-lg text-center shadow-lg hover:shadow-xl transition">
            📄 GENERATE PDF
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- CLEAN FOOTER -->
  <footer class="bg-blue-600 text-white py-8 mt-16">
    <div class="max-w-4xl mx-auto px-6 text-center text-xs">
      <div class="text-2xl mb-2">💉</div>
      <div class="mb-2">Pharma Transport Enterprise</div>
      <div class="opacity-75 mb-4">21 CFR Part 11 | SOC2 Compliant</div>
      <div>Batches • Pro Plan • Status • GPS</div>
    </div>
  </footer>

</body>
</html>
