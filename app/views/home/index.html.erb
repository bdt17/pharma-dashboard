<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white min-h-screen">

  <!-- SIMPLIFIED NAVBAR - MATCHES YOUR SCREENSHOT -->
  <nav class="bg-white border-b shadow-sm py-3">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <span class="text-2xl mr-3">💉</span>
          <h1 class="text-lg font-bold text-[#0984C0]">Pharma Transport</h1>
        </div>
        <div class="flex space-x-2">
          <a href="/dashboard" class="px-3 py-2 text-gray-700 hover:text-[#0984C0]">Dashboard</a>
          <a href="/vehicles" class="px-3 py-2 text-gray-700 hover:text-[#0984C0]">Fleet</a>
          <a href="/batches" class="px-3 py-2 text-[#0984C0] font-bold border-b-2 border-[#0984C0] pb-1">Batches</a>
          <a href="/subscribe" class="bg-[#0984C0] text-white px-4 py-2 rounded text-xs font-bold hover:bg-[#0984C0]/90">Pro $99/mo</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- EXACT 2-COLUMN LAYOUT FROM YOUR SCREENSHOT -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-[#0984C0] mb-4">🩺 PHARMA DASHBOARD</h1>
      <p class="text-gray-600">Enterprise cold chain + GPS IoT tracking</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- METRICS -->
      <div class="bg-gray-50 p-8 rounded-xl border">
        <h3 class="text-xl font-bold text-[#0984C0] mb-6">📊 Production Metrics</h3>
        <div class="space-y-4">
          <div class="flex justify-between"><span class="font-medium">Batches:</span> <span class="text-2xl font-bold text-[#0984C0]">5</span></div>
          <div class="flex justify-between"><span class="font-medium">Vehicles:</span> <span class="text-xl font-bold text-[#60BDD1]">2</span></div>
          <div class="flex justify-between"><span class="font-medium">GPS IoT:</span> <span class="font-bold text-[#60BDD1]">GV55 Ready</span></div>
        </div>
      </div>

      <!-- PDF BUTTON -->
      <div class="bg-gradient-to-r from-[#0984C0] to-[#60BDD1] p-8 rounded-xl text-white shadow-xl">
        <div class="text-center">
          <div class="text-2xl font-bold mb-4">✅ LIVE PRODUCTION</div>
          <p class="text-sm mb-6 leading-tight">Chain of Custody PDF ✓<br>GPS IoT ✓ | 21 CFR Ready</p>
          <a href="/batches" class="block mx-auto w-48 bg-white text-[#0984C0] font-bold py-3 px-6 rounded-lg text-center shadow-lg hover:shadow-xl">📄 GENERATE PDF BATCHES</a>
        </div>
      </div>
    </div>
  </div>

  <!-- CLEAN FOOTER -->
  <footer class="bg-[#0984C0] text-white py-8">
    <div class="max-w-4xl mx-auto px-4 text-center text-sm">
      <div class="text-2xl mb-2">💉</div>
      <div class="font-bold mb-2">Pharma Transport Enterprise</div>
      <div class="opacity-90 mb-4">21 CFR Part 11 | SOC2 | GPS IoT Cold Chain</div>
      <div class="space-x-4">
        <a href="/batches" class="hover:opacity-80">Batches</a>
        <a href="/subscribe" class="hover:opacity-80">Pro Plan</a>
        <a href="/health" class="hover:opacity-80">Status</a>
        <a href="/gps" class="hover:opacity-80">GPS IoT</a>
      </div>
    </div>
  </footer>

</body>
</html>
