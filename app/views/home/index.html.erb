<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pharma Transport</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white font-sans">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="border-b-2 border-[#0984C0] p-8">
      <h1 class="text-4xl md:text-5xl font-bold text-[#0984C0]">Pharma Transport</h1>
    </header>
    
    <!-- Main -->
    <main class="max-w-6xl mx-auto p-8">
      <!-- Subtitle -->
      <div class="mb-8">
        <div class="text-2xl md:text-3xl font-semibold text-[#0984C0] mb-2">PharmaTransport.org - LIVE</div>
        <div class="text-lg md:text-xl text-[#C0BEC6]">B2B2C Pharmacy Delivery • Phoenix Metro • Rails 8.1 Production</div>
      </div>
      
      <!-- Cards -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="border-2 border-[#0984C0] p-8 rounded-lg hover:shadow-lg transition-shadow">
          <h2 class="text-2xl md:text-3xl font-bold text-[#0984C0] mb-6">🏥 Pharmacist Portal</h2>
          <ul class="space-y-3 text-[#AAA7B0] text-lg">
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> Submit private orders</li>
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> Real-time GPS tracking</li>
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> FDA 21 CFR Part 11</li>
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> Revenue sharing model</li>
          </ul>
        </div>
        
        <div class="border-2 border-[#0984C0] p-8 rounded-lg hover:shadow-lg transition-shadow">
          <h2 class="text-2xl md:text-3xl font-bold text-[#0984C0] mb-6">📱 Patient App</h2>
          <ul class="space-y-3 text-[#AAA7B0] text-lg">
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> Order from local pharmacies</li>
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> Home delivery or pickup</li>
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> Live notifications</li>
            <li class="flex items-center"><span class="text-green-500 mr-3 text-xl">✅</span> HIPAA secure payments</li>
          </ul>
        </div>
      </div>
      
      <!-- Stats -->
      <div class="grid md:grid-cols-3 gap-12 mb-12 text-center">
        <div>
          <div class="text-5xl md:text-6xl font-bold text-[#0984C0] mb-4">🚛 24</div>
          <div class="text-2xl text-[#AAA7B0]">Live Vehicles</div>
          <div class="text-[#C0BEC6]">Phoenix Metro Coverage</div>
        </div>
        <div>
          <div class="text-5xl md:text-6xl font-bold text-[#0984C0] mb-4">📦 127</div>
          <div class="text-2xl text-[#AAA7B0]">Active Orders</div>
          <div class="text-[#C0BEC6]">HIPAA Compliant</div>
        </div>
        <div>
          <div class="text-5xl md:text-6xl font-bold text-[#0984C0] mb-4">$12K</div>
          <div class="text-2xl text-[#AAA7B0]">Monthly Revenue</div>
          <div class="text-[#C0BEC6]">Phase 18 Live +18% Growth</div>
        </div>
      </div>
      
      <!-- Footer -->
      <footer class="border-t-2 border-[#0984C0] pt-12 text-center text-[#C0BEC6] text-lg">
        ⚔️ Rails 8.1 Production • 🔒 HIPAA/FDA Compliant • 📱 iOS & Android Ready • 🚀 Phoenix Live Network
      </footer>
    </main>
  </div>
</body>
</html>
