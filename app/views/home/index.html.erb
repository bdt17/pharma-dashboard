<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .ocean-blue { color: #0984C0; }
    .sea-serpent { color: #60BDD1; }
  </style>
</head>
<body class="bg-white min-h-screen font-sans">
  
  <!-- CLEAN SINGLE NAVBAR -->
  <nav class="bg-white border-b border-gray-200 shadow-sm sticky top-0">
    <div class="max-w-5xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <span class="text-3xl">💉</span>
          <h1 class="text-2xl font-bold ocean-blue">Pharma Transport</h1>
        </div>
        <div class="flex space-x-4">
          <a href="/dashboard" class="px-4 py-2 text-gray-700 font-medium hover:text-ocean-blue transition">Dashboard</a>
          <a href="/vehicles" class="px-4 py-2 text-gray-700 font-medium hover:text-ocean-blue transition">Fleet</a>
          <a href="/batches" class="px-4 py-2 ocean-blue font-bold border-b-2 border-ocean-blue pb-1">Batches</a>
          <a href="/subscribe" class="bg-ocean-blue text-white px-6 py-2 rounded-lg font-semibold hover:bg-opacity-90 transition">Pro $99/mo</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT - EXACT SCREENSHOT LAYOUT -->
  <main class="max-w-5xl mx-auto px-6 py-20">
    
    <!-- HEADER -->
    <div class="text-center mb-20">
      <h1 class="text-5xl font-bold ocean-blue mb-6">🩺 PHARMA DASHBOARD</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Enterprise cold chain + GPS IoT tracking
      </p>
    </div>

    <!-- TWO COLUMN METRICS - PERFECT SPACING -->
    <div class="grid md:grid-cols-2 gap-12 mb-20">
      
      <!-- METRICS CARD -->
      <div class="bg-gray-50 p-10 rounded-2xl border border-gray-200">
        <h2 class="text-3xl font-bold ocean-blue mb-10 flex items-center">
          📊 Production Metrics
        </h2>
        <div class="space-y-8">
          <div class="flex justify-between items-end">
            <span class="text-lg text-gray-600 font-medium">Batches</span>
            <span class="text-4xl font-black ocean-blue">5</span>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-lg text-gray-600 font-medium">Vehicles</span>
            <span class="text-3xl font-bold sea-serpent">2</span>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-lg text-gray-600 font-medium">GPS IoT</span>
            <span class="text-2xl font-bold sea-serpent">GV55 Ready</span>
          </div>
        </div>
      </div>

      <!-- PDF MONEY MAKER -->
      <div class="bg-gradient-to-br from-ocean-blue to-sea-serpent p-10 rounded-2xl text-white shadow-2xl">
        <h2 class="text-3xl font-bold mb-10">✅ LIVE PRODUCTION</h2>
        <div class="text-center">
          <p class="text-xl mb-12 opacity-95 leading-relaxed">
            Chain of Custody PDF ✓<br>
            GPS IoT ✓ | 21 CFR Ready
          </p>
          <a href="/batches" class="inline-block bg-white text-ocean-blue font-bold py-5 px-12 rounded-xl shadow-2xl hover:shadow-3xl hover:scale-105 transition-all text-lg">
            📄 GENERATE PDF BATCHES
          </a>
        </div>
      </div>
      
    </div>
  </main>

  <!-- PRO FOOTER - KEEP WORKING -->
  <footer class="bg-ocean-blue text-white py-16">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="text-4xl mb-6">💉</div>
      <h3 class="text-2xl font-bold mb-6">Pharma Transport Enterprise</h3>
      <p class="text-lg opacity-90 mb-8 max-w-2xl mx-auto">
        21 CFR Part 11 | SOC2 | GPS IoT Cold Chain | Chain of Custody
      </p>
      <div class="flex flex-wrap justify-center gap-8 text-sm mb-8">
        <a href="/batches" class="hover:opacity-80 transition">Batches</a>
        <a href="/subscribe" class="hover:opacity-80 transition">Pro Plan</a>
        <a href="/health" class="hover:opacity-80 transition">Status</a>
        <a href="/gps" class="hover:opacity-80 transition">GPS IoT</a>
      </div>
      <p class="text-sm opacity-75">© 2026 Thomas IT Network. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
