<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white min-h-screen text-gray-900 antialiased">

  <!-- PROPER NAVBAR SIZING -->
  <nav class="bg-white border-b shadow-sm py-4">
    <div class="max-w-5xl mx-auto px-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <span class="text-3xl">💉</span>
          <h1 class="text-2xl font-bold text-[#0984C0]">Pharma Transport</h1>
        </div>
        <div class="flex space-x-4">
          <a href="/dashboard" class="px-4 py-2 text-gray-700 font-medium hover:text-[#0984C0] rounded-lg">Dashboard</a>
          <a href="/vehicles" class="px-4 py-2 text-gray-700 font-medium hover:text-[#0984C0] rounded-lg">Fleet</a>
          <a href="/batches" class="px-4 py-2 text-[#0984C0] font-bold border-b-2 border-[#0984C0] pb-1">Batches</a>
          <a href="/subscribe" class="bg-[#0984C0] text-white px-6 py-2 rounded-lg font-semibold hover:bg-[#0984C0]/90">Pro $99/mo</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- PROPER MAIN CONTENT SIZING -->
  <main class="max-w-5xl mx-auto px-6 py-16">
    
    <!-- HERO HEADER -->
    <div class="text-center mb-16">
      <h1 class="text-5xl font-black text-[#0984C0] mb-6">🩺 PHARMA DASHBOARD</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Enterprise cold chain + GPS IoT tracking
      </p>
    </div>

    <!-- PROPER 2-COLUMN GRID -->
    <div class="grid lg:grid-cols-2 gap-8 mb-16">
      
      <!-- METRICS CARD - FULL SIZE -->
      <div class="bg-gray-50 p-10 rounded-2xl border border-gray-200 shadow-lg">
        <h2 class="text-3xl font-bold text-[#0984C0] mb-10 flex items-center">
          📊 Production Metrics
        </h2>
        <div class="space-y-6">
          <div class="flex justify-between items-end py-3">
            <span class="text-lg text-gray-600 font-medium">Batches:</span>
            <span class="text-4xl font-black text-[#0984C0]">5</span>
          </div>
          <div class="flex justify-between items-end py-3">
            <span class="text-lg text-gray-600 font-medium">Vehicles:</span>
            <span class="text-3xl font-bold text-[#60BDD1]">2</span>
          </div>
          <div class="flex justify-between items-end py-3">
            <span class="text-lg text-gray-600 font-medium">GPS IoT:</span>
            <span class="text-xl font-bold text-[#60BDD1]">GV55 Ready</span>
          </div>
        </div>
      </div>

      <!-- PDF MONEY MAKER - FULL SIZE -->
      <div class="bg-gradient-to-r from-[#0984C0] to-[#60BDD1] p-10 rounded-2xl text-white shadow-2xl">
        <div class="text-center">
          <div class="text-3xl font-bold mb-8">✅ LIVE PRODUCTION</div>
          <p class="text-lg mb-10 leading-relaxed opacity-95">
            Chain of Custody PDF ✓<br>
            GPS IoT ✓ | 21 CFR Ready
          </p>
          <a href="/batches" class="inline-block bg-white text-[#0984C0] font-bold py-5 px-12 rounded-xl shadow-2xl hover:shadow-3xl hover:scale-105 transition-all text-lg mx-auto">
            📄 GENERATE PDF BATCHES
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- PROPER FOOTER -->
  <footer class="bg-[#0984C0] text-white py-12">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="text-4xl mb-6">💉</div>
      <h3 class="text-2xl font-bold mb-6">Pharma Transport Enterprise</h3>
      <p class="text-lg opacity-90 mb-8 max-w-2xl mx-auto">
        21 CFR Part 11 | SOC2 | GPS IoT Cold Chain | Chain of Custody
      </p>
      <div class="flex flex-wrap justify-center gap-8 text-sm mb-8">
        <a href="/batches" class="hover:opacity-80 transition">Batches</a>
        <a href="/subscribe" class="hover:opacity-80 transition">Pro Plan</a>
        <a href="/health" class="hover:opacity-80 transition">Status</a>
        <a href="/gps" class="hover:opacity-80 transition">GPS IoT</a>
      </div>
      <p class="text-sm opacity-75">© 2026 Thomas IT Network. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
