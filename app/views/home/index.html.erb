<% content_for :full_bleed, "1" %>
<% content_for :title, "Pharma Transport — chain-of-custody for pharmaceutical transport" %>
<% content_for :meta_description, "Fleet GPS tracking, immutable hash-chained chain-of-custody logging, and FDA-ready compliance PDFs for pharmaceutical transport." %>

<%# Hero %>
<section class="border-b border-line bg-gradient-to-b from-[#fbfcfd] to-[#f3f6f8]">
  <div class="mx-auto max-w-6xl px-6 py-20 grid gap-16 lg:grid-cols-[1.05fr_0.95fr] items-center">
    <div class="flex flex-col gap-6">
      <span class="eyebrow">Chain-of-custody for pharmaceutical transport</span>
      <h1 class="text-[38px] sm:text-[47px] leading-[1.12]">
        The shipment record you can produce on demand&nbsp;&mdash; not reconstruct from memory.
      </h1>
      <p class="text-[18px] text-ink-soft max-w-[38ch]">
        Track your fleet, log every custody handoff as it happens, and generate FDA-ready
        compliance documentation automatically. When a regulator, a client, or an auditor
        asks what happened to a batch, the answer is already written down.
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary" %>
        <%= link_to "See pricing", pricing_path, class: "btn btn-secondary" %>
      </div>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-2 pt-3 text-[13px] text-ink-faint">
        <span>Built for 21 CFR Part 11</span>
        <span class="w-1 h-1 rounded-full bg-line"></span>
        <span>DSCSA-aligned custody records</span>
        <span class="w-1 h-1 rounded-full bg-line"></span>
        <span>Live in production</span>
      </div>
    </div>

    <%# Product snapshot %>
    <div class="card overflow-hidden shadow-[0_18px_44px_-18px_rgba(19,26,36,0.24)]">
      <div class="flex items-center justify-between px-4 py-3.5 border-b border-line-soft bg-[#fbfcfd]">
        <div class="flex flex-col">
          <span class="font-semibold text-sm">Dashboard</span>
          <span class="text-xs text-ink-faint">Meridian Specialty Pharmacy &mdash; sample data</span>
        </div>
        <span class="badge badge-accent">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Compliant
        </span>
      </div>
      <div class="p-4 flex flex-col gap-4">
        <div class="grid grid-cols-3 gap-3">
          <div class="border border-line rounded-sm p-3">
            <div class="text-[11px] text-ink-faint tracking-wide">BATCHES</div>
            <div class="mono text-[22px] font-medium mt-0.5">128</div>
            <div class="text-[11px] text-ink-faint">14 active</div>
          </div>
          <div class="border border-[#f0c8c2] bg-[#fdeceb] rounded-sm p-3">
            <div class="text-[11px] text-[#8a2c22] tracking-wide">EXCURSIONS</div>
            <div class="mono text-[22px] font-medium mt-0.5 text-[#b42318]">1</div>
            <div class="text-[11px] text-[#8a2c22]">outside 2&ndash;8&deg;C</div>
          </div>
          <div class="border border-line rounded-sm p-3">
            <div class="text-[11px] text-ink-faint tracking-wide">VEHICLES</div>
            <div class="mono text-[22px] font-medium mt-0.5">6</div>
            <div class="text-[11px] text-ink-faint">6 online</div>
          </div>
        </div>
        <div class="border border-line rounded-sm overflow-hidden">
          <div class="grid grid-cols-3 text-[11px] text-ink-faint bg-[#fbfcfd] px-3 py-2 border-b border-line-soft tracking-wide">
            <span>EVENT</span><span>LOT</span><span>LOCATION</span>
          </div>
          <div class="grid grid-cols-3 text-xs px-3 py-2.5 border-b border-line-soft"><span class="font-medium">Delivery</span><span class="mono">LOT-4471-C</span><span class="text-ink-soft">Tucson, AZ</span></div>
          <div class="grid grid-cols-3 text-xs px-3 py-2.5 border-b border-line-soft"><span class="font-medium">Transfer</span><span class="mono">LOT-4468-A</span><span class="text-ink-soft">Phoenix hub</span></div>
          <div class="grid grid-cols-3 text-xs px-3 py-2.5"><span class="font-medium">Pickup</span><span class="mono">LOT-4472-B</span><span class="text-ink-soft">Mesa DC</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Problem band %>
<section class="bg-brand-900 text-[#eaf0f4]">
  <div class="mx-auto max-w-6xl px-6 py-[72px] grid gap-14 md:grid-cols-2 items-center">
    <h2 class="text-[30px] text-white">&ldquo;We&rsquo;re fairly sure that shipment stayed in range&rdquo; is not a record.</h2>
    <p class="text-[16px] text-[#b9c6d2]">
      Most transport paperwork only gets read when something has already gone wrong &mdash;
      a temperature excursion, a missing signature, a batch nobody can account for. By then
      the people who handled it are working from memory. Pharma Transport captures the
      custody trail while the shipment is moving, so the record exists before anyone needs it.
    </p>
  </div>
</section>

<%# Features %>
<section class="mx-auto max-w-6xl px-6 py-[88px]">
  <div class="flex flex-col gap-3.5 mb-14">
    <span class="eyebrow">What you get</span>
    <h2 class="text-[34px] max-w-[20ch]">Four records, kept automatically, for every batch you move.</h2>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <% [
      ["Live fleet GPS tracking",
       "Real-time vehicle positions, scoped to your organization. Every driver ping is a timestamped data point, not a dot on a demo map.",
       '<path d="M12 21s-6.5-5.6-6.5-10A6.5 6.5 0 0 1 18.5 11c0 4.4-6.5 10-6.5 10Z"/><circle cx="12" cy="11" r="2.3"/>'],
      ["Immutable custody log",
       "Every handoff — pickup, transfer, delivery — is written as a hash-chained record. A later edit breaks the chain, so tampering is detectable rather than silent.",
       '<path d="M9 15l6-6"/><path d="M11 7l1-1a4 4 0 0 1 5.7 5.7l-1 1"/><path d="M13 17l-1 1A4 4 0 0 1 6.3 12.3l1-1"/>'],
      ["FDA-ready Compliance Packets",
       "One PDF per batch covering chain-of-custody and temperature monitoring, generated from the underlying data — built for 21 CFR Part 11 documentation needs.",
       '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9.5 14.5l1.8 1.8 3.2-3.6"/>'],
      ["Proof-of-delivery signatures",
       "Captured at the point of delivery and attached directly to the custody record it belongs to — not a separate photo in someone’s phone.",
       '<path d="M3 17c3-1 4-5 7-5s4 3 7 1"/><path d="M12.5 7.5l4 4L9 19H5v-4z"/>'],
    ].each do |title, body, icon| %>
      <div class="card p-7 flex flex-col gap-3.5">
        <span class="w-10 h-10 rounded-lg bg-accent-50 text-accent-700 flex items-center justify-center">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%== icon %></svg>
        </span>
        <h3 class="text-[19px]"><%= title %></h3>
        <p class="text-[14.5px] text-ink-soft"><%= body %></p>
      </div>
    <% end %>
  </div>
</section>

<%# Trust %>
<section class="mx-auto max-w-6xl px-6 pb-[88px]">
  <div class="flex flex-col gap-3.5 mb-11">
    <span class="eyebrow">Why trust it</span>
    <h2 class="text-[30px]">Built to hold up, not just to demo well.</h2>
  </div>
  <div class="grid sm:grid-cols-3 border border-line rounded overflow-hidden">
    <div class="p-7 border-b sm:border-b-0 sm:border-r border-line flex flex-col gap-2">
      <h3 class="font-sans text-[15px] font-semibold">Live in production</h3>
      <p class="text-[14px] text-ink-soft">Real signup, real email confirmation, real Stripe billing, mandatory two-factor for admins. The product you evaluate is the product you run.</p>
    </div>
    <div class="p-7 border-b sm:border-b-0 sm:border-r border-line flex flex-col gap-2">
      <h3 class="font-sans text-[15px] font-semibold">Security posture</h3>
      <p class="text-[14px] text-ink-soft">Static analysis and dependency auditing run on every change. Auth endpoints are rate-limited. Second-factor secrets are encrypted at rest.</p>
    </div>
    <div class="p-7 flex flex-col gap-2">
      <h3 class="font-sans text-[15px] font-semibold">Compliance-first design</h3>
      <p class="text-[14px] text-ink-soft">Custody records are hash-chained rather than freely editable &mdash; designed around what an audit trail actually has to prove.</p>
    </div>
  </div>
  <p class="mt-6 text-sm">
    <%= link_to "See the full security &amp; compliance detail →".html_safe, security_path, class: "font-medium" %>
  </p>
</section>

<%# DSCSA callout %>
<section class="mx-auto max-w-6xl px-6 pb-[88px]">
  <div class="rounded border p-7 flex flex-wrap items-center justify-between gap-8" style="background-color:#fbf1e4;border-color:#ecd3ac;">
    <div class="flex flex-col gap-1.5 max-w-[62ch]">
      <span class="text-[12px] font-semibold tracking-[0.08em] uppercase text-[#b45309]">DSCSA &mdash; small dispenser exemption</span>
      <p class="text-[15px] text-[#5c4420]">The FDA&rsquo;s small-dispenser exemption from enhanced drug distribution security requirements ends <strong>November&nbsp;27,&nbsp;2026</strong>. If your pharmacy has relied on it, preparation needs to be finished &mdash; not starting.</p>
    </div>
    <%= link_to "Read what changes →", blog_dscsa_exemption_2026_path, class: "btn btn-secondary", style: "border-color:#d8b98a;" %>
  </div>
</section>

<%# Compliance-officer service teaser %>
<section class="bg-brand-900 text-white">
  <div class="mx-auto max-w-6xl px-6 py-[72px] grid gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-center">
    <div class="flex flex-col gap-4">
      <span class="eyebrow" style="color:#5fb6ac;">Fractional compliance officer</span>
      <h2 class="text-[26px] sm:text-[30px] text-white">Don&rsquo;t have someone to own this? We&rsquo;ll be that person.</h2>
      <p class="text-[15px] text-[#b9c6d2]">
        A named compliance professional on monthly retainer: your SOPs authored and kept
        current, every Compliance Packet reviewed before it&rsquo;s relied on, your records
        monitored on a schedule, and audit support on call. Runs alongside your subscription.
      </p>
    </div>
    <div class="flex flex-col gap-3 md:items-end">
      <%= link_to "How the retainer works", compliance_officer_path, class: "btn", style: "background:#fff;color:#1f3a53;" %>
      <span class="text-[13px] text-[#8ba0b0]">Month-to-month &middot; free 20-minute intro call</span>
    </div>
  </div>
</section>

<%# Pricing teaser %>
<section class="bg-surface border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-[88px] grid gap-14 md:grid-cols-2 items-center">
    <div class="flex flex-col gap-4">
      <span class="eyebrow">Pricing</span>
      <h2 class="text-[30px]">One plan. No per-truck upsells, no compliance surcharge.</h2>
      <p class="text-[15px] text-ink-soft">Every plan starts with a 14-day free trial &mdash; you are not charged until it ends. Unlimited team members per organization. Cancel any time.</p>
      <div class="flex gap-3 pt-1">
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary" %>
        <%= link_to "Full pricing", pricing_path, class: "btn btn-secondary" %>
      </div>
    </div>
    <div class="card p-8 flex flex-col gap-4 shadow-[0_1px_3px_rgba(19,26,36,0.08)]">
      <div class="flex items-center justify-between">
        <span class="font-sans font-semibold text-[15px]">What&rsquo;s included</span>
        <span class="badge badge-accent">14-day trial</span>
      </div>
      <div class="bg-accent-50 border border-accent-100 rounded-sm px-3 py-2.5 text-[13px] text-accent-700">
        Founding-customer offer: 25% off your first 6 months, applied automatically for early monthly subscribers.
      </div>
      <div class="flex flex-col gap-2.5 text-[14px] text-ink-soft">
        <% ["Live GPS fleet tracking", "Immutable chain-of-custody event log", "FDA-ready Compliance Packet PDFs", "Signature capture for proof-of-delivery"].each do |item| %>
          <span class="flex gap-2.5"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> <%= item %></span>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# Final CTA %>
<section class="bg-brand-700 text-white">
  <div class="mx-auto max-w-6xl px-6 py-[76px] flex flex-col items-center gap-5 text-center">
    <h2 class="text-[32px] text-white max-w-[22ch]">Start keeping the record before someone asks for it.</h2>
    <p class="text-[#c6d2dc] text-[16px] max-w-[50ch]">Create a free account, add your first vehicle, and log a custody event in the same afternoon.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <%= link_to "Sign up", new_user_registration_path, class: "btn", style: "background:#fff;color:#1f3a53;" %>
      <%= link_to "See pricing", pricing_path, class: "btn btn-secondary", style: "border-color:rgba(255,255,255,0.3);color:#fff;background:transparent;" %>
    </div>
  </div>
</section>
