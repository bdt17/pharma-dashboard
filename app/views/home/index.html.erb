  <p style="font-size:1.3rem;margin-bottom:2rem">Enterprise logistics platform</p>
  <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
    <%= link_to "Sign up", new_user_registration_path, style: "background:#10b981;color:white;padding:1.2rem 3rem;border-radius:12px;text-decoration:none;font-weight:600;font-size:1.1rem" %>
