<% content_for :title, "Fleet GPS — Pharma Transport" %>
<% content_for :crumb, "Fleet GPS" %>

<div class="p-7 max-w-5xl">
  <div class="flex items-end justify-between mb-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-[24px]">Live fleet</h1>
      <span class="text-[13px] text-ink-faint"><%= current_organization&.name %></span>
    </div>
    <% if policy(Vehicle.new).create? %>
      <%= link_to "+ Add a vehicle", new_vehicle_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @vehicles.empty? %>
    <div class="card p-8 text-center text-ink-faint text-[14px] flex flex-col items-center gap-3">
      <span>No vehicles yet.</span>
      <% if policy(Vehicle.new).create? %>
        <%= link_to "Add your first vehicle", new_vehicle_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  <% else %>
    <div class="card overflow-hidden">
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2.5">Vehicle</th>
            <th class="text-left font-medium px-4 py-2.5">Status</th>
            <th class="text-left font-medium px-4 py-2.5">Position</th>
            <th class="text-left font-medium px-4 py-2.5">Speed</th>
            <th class="text-left font-medium px-4 py-2.5">Last ping</th>
            <th class="px-4 py-2.5"></th>
          </tr>
        </thead>
        <tbody>
          <% @vehicles.each do |vehicle| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5 font-medium"><%= vehicle.name.presence || vehicle.identifier %></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= vehicle.status.presence || "unknown" %></td>
              <td class="px-4 py-2.5 mono text-ink-soft">
                <% if vehicle.latitude && vehicle.longitude %>
                  <%= "%.4f, %.4f" % [ vehicle.latitude, vehicle.longitude ] %>
                <% else %>
                  <span class="text-ink-faint">no signal yet</span>
                <% end %>
              </td>
              <td class="px-4 py-2.5 mono"><%= vehicle.speed ? "#{vehicle.speed.round(1)} mph" : "—" %></td>
              <td class="px-4 py-2.5 mono text-ink-soft"><%= vehicle.last_ping_at&.strftime("%Y-%m-%d %H:%M") || "never" %></td>
              <td class="px-4 py-2.5 text-right">
                <% if policy(vehicle).update? %>
                  <%= link_to "Manage", edit_vehicle_path(vehicle), class: "text-[12px] text-accent-600 hover:text-accent-700" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
