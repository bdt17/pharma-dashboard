<% content_for :title, "Two-factor authentication" %>
<% content_for :bare_layout, "1" %>

<h1 class="text-[20px] mb-2">Enter your authentication code</h1>

<p class="text-[14px] text-ink-soft">
  Open your authenticator app and enter the current 6-digit code for
  Pharma Transport. Lost your device? Enter one of your backup codes instead.
</p>

<%= form_with url: two_factor_challenge_path, method: :post, class: "mt-6 flex flex-col gap-4" do %>
  <div class="flex flex-col gap-1.5">
    <%= label_tag :otp_code, "Authentication or backup code", class: "text-[12.5px] font-semibold text-ink-soft" %>
    <%= text_field_tag :otp_code, nil,
          autocomplete: "one-time-code", inputmode: "numeric",
          autofocus: true, placeholder: "123456",
          class: "field-input mono text-[18px] tracking-[0.25em]" %>
  </div>
  <%= submit_tag "Verify", class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-[13px]">
  <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete } %>
</p>
