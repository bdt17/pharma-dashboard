<% content_for :title, "Two-factor authentication" %>
<% content_for :bare_layout, "1" %>

<% if current_user.otp_enabled? %>
  <h1 class="text-[20px] mb-2">Two-factor authentication is on</h1>

  <p class="text-[14px] text-ink-soft">
    Your account is protected by an authenticator app. You'll be asked for a
    code each time you sign in.
  </p>

  <p class="my-5 text-[14px]">
    <%= link_to "Regenerate backup codes", two_factor_backup_codes_path, class: "font-medium" %>
    — replaces any codes you have now.
  </p>

  <% if current_user.two_factor_required? %>
    <p class="text-[13px] text-ink-soft">
      Two-factor authentication is required for <%= current_user.role %>
      accounts and can't be turned off.
    </p>
  <% else %>
    <h2 class="text-[15px] font-sans font-semibold mt-8 mb-1">Turn it off</h2>
    <p class="text-[14px] text-ink-soft">Enter a current authenticator code (or a backup code) to disable it.</p>
    <%= form_with url: two_factor_setup_path, method: :delete, class: "mt-3 flex flex-col gap-3" do %>
      <%= text_field_tag :otp_code, nil,
            autocomplete: "one-time-code", inputmode: "numeric", placeholder: "123456",
            class: "field-input mono text-[16px] tracking-[0.2em]" %>
      <%= submit_tag "Turn off two-factor authentication",
            class: "btn w-full",
            style: "background:#b42318;color:#fff;",
            data: { turbo_confirm: "Turn off two-factor authentication for your account?" } %>
    <% end %>
  <% end %>
<% else %>
  <h1 class="text-[20px] mb-2">Set up two-factor authentication</h1>

  <% if current_user.two_factor_required? %>
    <p class="text-[14px] text-[#b42318] font-semibold">
      Two-factor authentication is required for <%= current_user.role %>
      accounts. Finish setup to continue.
    </p>
  <% else %>
    <p class="text-[14px] text-ink-soft">
      Two-factor authentication adds a one-time code from your phone when you
      sign in, so a stolen password isn't enough on its own. Optional, but
      recommended.
    </p>
  <% end %>

  <p class="text-[14px] text-ink-soft mt-3">
    Scan the QR code with an authenticator app (Google Authenticator, Authy,
    1Password, Microsoft Authenticator), then enter the 6-digit code it shows.
  </p>

  <div class="my-5 max-w-[200px] [&_svg]:w-full [&_svg]:h-auto">
    <%= raw current_user.otp_qr_code_svg %>
  </div>

  <p class="text-[12.5px] text-ink-soft">
    Can't scan? Enter this key manually (type "Time based"):<br>
    <code class="mono text-[14px] tracking-[0.1em]"><%= current_user.otp_secret %></code>
  </p>

  <%= form_with url: two_factor_setup_path, method: :post, class: "mt-5 flex flex-col gap-3" do %>
    <div class="flex flex-col gap-1.5">
      <%= label_tag :otp_code, "6-digit code", class: "text-[12.5px] font-semibold text-ink-soft" %>
      <%= text_field_tag :otp_code, nil,
            autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9]*",
            autofocus: true, placeholder: "123456",
            class: "field-input mono text-[18px] tracking-[0.25em]" %>
    </div>
    <%= submit_tag "Verify and continue", class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
