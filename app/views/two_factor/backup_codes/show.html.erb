<% content_for :title, "Backup codes" %>
<% content_for :bare_layout, "1" %>

<h1 class="text-[20px] mb-2">Backup codes</h1>

<% if @backup_codes.present? %>
  <p class="text-[14px] text-ink-soft">
    Save these <%= @backup_codes.size %> codes somewhere safe (a password
    manager). Each one works <strong>once</strong> if you lose access to your
    authenticator app. This is the only time they'll be shown.
  </p>

  <ul class="mono text-[15px] leading-8 list-none p-4 mt-4 bg-surface border border-line rounded-sm">
    <% @backup_codes.each do |code| %>
      <li><%= code %></li>
    <% end %>
  </ul>

  <%= link_to "I've saved these — continue to dashboard", dashboard_path, class: "btn btn-primary w-full mt-5" %>
<% else %>
  <p class="text-[14px] text-ink-soft">
    Your backup codes were shown once when you set them up. If you've used
    some or lost them, generate a fresh set below — this immediately
    invalidates any previous codes.
  </p>

  <%= button_to "Generate new backup codes", two_factor_backup_codes_path, method: :post, class: "btn btn-primary w-full mt-4" %>
  <p class="mt-4 text-[13px]"><%= link_to "Back to dashboard", dashboard_path %></p>
<% end %>
