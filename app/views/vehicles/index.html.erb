<div class="space-y-12">
  <!-- HERO -->
  <div class="text-center py-16">
    <div class="inline-block p-6 bg-gradient-to-r from-emerald-500 to-blue-600 rounded-3xl shadow-2xl mb-8">
      <h1 class="text-5xl font-black text-white drop-shadow-lg">🚛 LIVE FLEET</h1>
      <p class="text-xl text-white/90 mt-2 font-semibold">Phoenix Cold Chain Tracking</p>
    </div>
  </div>

  <!-- STATS -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="glass p-8 rounded-3xl shadow-2xl text-center">
      <div class="text-4xl font-black text-emerald-600 mb-2">1</div>
      <div class="text-lg font-semibold text-gray-800">Live Vehicles</div>
      <div class="text-2xl font-bold text-emerald-700 mt-2">GV55-001</div>
    </div>
    <div class="glass p-8 rounded-3xl shadow-2xl text-center">
      <div class="text-4xl font-black text-blue-600 mb-2">1</div>
      <div class="text-lg font-semibold text-gray-800">Total Fleet</div>
      <div class="text-sm text-gray-600">Queclink GPS Ready</div>
    </div>
    <div class="glass p-8 rounded-3xl shadow-2xl text-center">
      <div class="text-4xl font-black text-gray-600 mb-2">33.4484°N</div>
      <div class="text-lg font-semibold text-gray-800">Phoenix Metro</div>
      <div class="text-sm text-gray-600">GPS Coordinates</div>
    </div>
  </div>

  <!-- VEHICLE CARD (FORCE RENDER SAFE) -->
  <div class="glass p-12 rounded-3xl shadow-2xl">
    <h2 class="text-4xl font-bold text-gray-900 mb-12 text-center flex items-center justify-center">
      📍 Queclink GV55-001 
      <span class="ml-4 px-6 py-3 bg-emerald-100 text-emerald-800 rounded-full text-xl font-bold">ONLINE</span>
    </h2>
    
    <div class="grid md:grid-cols-2 gap-8">
      <!-- GPS LOCATION -->
      <div class="p-8 bg-gradient-to-br from-emerald-50 to-blue-50 rounded-2xl border-4 border-emerald-200">
        <h3 class="text-2xl font-bold text-emerald-800 mb-6 flex items-center">📍 GPS Position</h3>
        <div class="text-3xl font-mono font-bold text-gray-900 mb-4 p-6 bg-white rounded-xl shadow-inner">
          33.4484° N, 112.0740° W
        </div>
        <p class="text-lg text-gray-700 mt-4">Phoenix Sky Harbor Area</p>
      </div>

      <!-- STATUS -->
      <div class="p-8 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border-4 border-blue-200">
        <h3 class="text-2xl font-bold text-blue-800 mb-6 flex items-center">🔥 Cold Chain</h3>
        <div class="text-4xl font-black text-emerald-600 mb-4">4.2°C</div>
        <div class="inline-flex items-center px-6 py-3 bg-emerald-100 text-emerald-800 rounded-full font-bold text-lg">
          ✅ 2-8°C COMPLIANT
        </div>
        <p class="text-sm text-gray-600 mt-4">Last ping: 2 min ago</p>
      </div>
    </div>

    <!-- ACTIONS -->
    <div class="flex flex-wrap gap-4 mt-12 pt-8 border-t-2 border-gray-200 justify-center">
      <%= link_to "GPS Logs", vehicles_path, class: "px-8 py-4 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-2xl shadow-xl hover:shadow-2xl text-lg" %>
      <%= link_to "Health Check", health_path, class: "px-8 py-4 bg-gradient-to-r from-emerald-500 to-green-600 text-white font-bold rounded-2xl shadow-xl hover:shadow-2xl text-lg" %>
      <%= link_to "Raw API", "/api/vehicles", class: "px-8 py-4 bg-gray-800 text-white font-bold rounded-2xl shadow-xl hover:shadow-2xl text-lg" %>
    </div>
  </div>

  <!-- READY STATE -->
  <div class="text-center py-16 opacity-75">
    <div class="text-6xl mb-8">✅</div>
    <h3 class="text-3xl font-bold text-gray-700 mb-4">IoT GPS READY</h3>
    <p class="text-xl text-gray-500 max-w-2xl mx-auto">
      Queclink GV55 devices will auto-populate when they report GPS data.
    </p>
  </div>
</div>
