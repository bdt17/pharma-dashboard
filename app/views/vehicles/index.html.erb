<!DOCTYPE html>
<html>
<head><title>Vehicle Fleet</title></head>
<body>
  <h1>🚛 Live Vehicle Fleet (Pharma Transport)</h1>
  <p><strong><%= @online_vehicles %> online vehicles</strong></p>
  
  <% if @vehicles.any? %>
    <ul>
    <% @vehicles.each do |vehicle| %>
      <li>
        <strong><%= vehicle.name || vehicle.plate %></strong> 
        📍 <%= vehicle.latitude %>, <%= vehicle.longitude %>
        <span style="color: <%= vehicle.status == 'online' ? 'green' : 'red' %>;">
          <%= vehicle.status.upcase %>
        </span>
      </li>
    <% end %>
    </ul>
  <% else %>
    <p>No vehicles with GPS data yet</p>
  <% end %>
</body>
</html>
