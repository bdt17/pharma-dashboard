<div class="space-y-8">
  <div>
    <h1 class="text-4xl font-bold text-gray-900 mb-2">🚛 Live Vehicle Fleet</h1>
    <p class="text-xl text-gray-600">Real-time GPS tracking for cold chain compliance</p>
  </div>
  
  <div class="bg-white shadow-xl rounded-2xl p-8">
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-2xl font-semibold text-gray-900">Fleet Summary</h2>
      <span class="px-4 py-2 bg-emerald-100 text-emerald-800 rounded-full font-semibold">
        <%= @online_vehicles %> online
      </span>
    </div>
    
    <% if @vehicles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @vehicles.each do |vehicle| %>
          <div class="border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all">
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-900"><%= vehicle.name || vehicle.plate %></h3>
              <span class="px-3 py-1 bg-<%= vehicle.status == 'online' ? 'emerald' : 'gray' %>-100 text-<%= vehicle.status == 'online' ? 'emerald' : 'gray' %>-800 rounded-full text-sm font-medium">
                <%= vehicle.status %>
              </span>
            </div>
            <p class="text-2xl font-bold text-emerald-600 mb-2">
              📍 <%= vehicle.latitude %>, <%= vehicle.longitude %>
            </p>
            <p class="text-sm text-gray-500">Plate: <%= vehicle.plate %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-2xl text-gray-500 mb-4">No vehicles online</p>
        <p class="text-gray-400">GPS data will appear here when trucks report location</p>
      </div>
    <% end %>
  </div>
</div>
