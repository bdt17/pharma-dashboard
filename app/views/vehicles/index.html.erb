<div class="space-y-8">
  <!-- Header -->
  <div class="text-center">
    <h1 class="text-5xl font-bold bg-gradient-to-r from-gray-900 to-gray-700 bg-clip-text text-transparent mb-4">
      🚛 Live Vehicle Fleet
    </h1>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
      Real-time GPS tracking for cold chain compliance across Phoenix metro
    </p>
  </div>

  <!-- Fleet Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white/70 backdrop-blur-md p-8 rounded-2xl shadow-xl border border-emerald-200">
      <div class="text-4xl font-bold text-emerald-600 mb-2"><%= Vehicle.where(status: 'online').count %></div>
      <div class="text-lg font-semibold text-gray-700">Live Vehicles</div>
    </div>
    <div class="bg-white/70 backdrop-blur-md p-8 rounded-2xl shadow-xl border border-blue-200">
      <div class="text-4xl font-bold text-blue-600 mb-2"><%= Vehicle.count %></div>
      <div class="text-lg font-semibold text-gray-700">Total Fleet</div>
    </div>
    <div class="bg-white/70 backdrop-blur-md p-8 rounded-2xl shadow-xl border border-gray-200">
      <div class="text-4xl font-bold text-gray-600 mb-2"><%= @online_vehicles || 0 %></div>
      <div class="text-lg font-semibold text-gray-700">Online Now</div>
    </div>
  </div>

  <!-- Vehicles Grid -->
  <% if @vehicles&.any? %>
    <div class="bg-white/50 backdrop-blur-md rounded-3xl p-8 shadow-2xl border border-gray-100">
      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
        📍 Current Locations
        <span class="ml-4 px-4 py-2 bg-emerald-100 text-emerald-800 rounded-full text-lg font-semibold">
          <%= @vehicles.count %> active
        </span>
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @vehicles.each do |vehicle| %>
          <div class="group bg-white/90 backdrop-blur-md p-8 rounded-2xl shadow-xl hover:shadow-2xl border-2 border-gray-100 hover:border-emerald-400 transition-all duration-300 hover:-translate-y-3 hover:scale-[1.02]">
            <!-- Status Badge -->
            <div class="flex items-start justify-between mb-6">
              <div>
                <h3 class="text-2xl font-bold text-gray-900 group-hover:text-emerald-700 transition-colors">
                  <%= vehicle.name || vehicle.plate %>
                </h3>
                <p class="text-sm text-gray-500 mt-1">Plate: <%= vehicle.plate %></p>
              </div>
              <span class="px-4 py-2 bg-<%= vehicle.status == 'online' ? 'emerald' : 'gray' %>-100 
                           text-<%= vehicle.status == 'online' ? 'emerald' : 'gray' %>-800 
                           rounded-full text-sm font-semibold 
                           <%= vehicle.status == 'online' ? 'animate-pulse ring-2 ring-emerald-200' : '' %>">
                <%= vehicle.status&.capitalize || 'Offline' %>
              </span>
            </div>

            <!-- GPS Location -->
            <div class="mb-6 p-4 bg-gradient-to-r from-emerald-50 to-blue-50 rounded-xl border-l-4 border-emerald-400">
              <div class="flex items-center mb-2">
                <span class="text-2xl mr-3">📍</span>
                <span class="font-mono text-lg font-bold text-emerald-700">
                  <%= number_with_precision(vehicle.latitude, precision: 4) %>, 
                  <%= number_with_precision(vehicle.longitude, precision: 4) %>
                </span>
              </div>
              <p class="text-xs text-gray-500 ml-8">Phoenix Metro GPS Coordinates</p>
            </div>

            <!-- Vehicle Details -->
            <div class="space-y-3 text-sm">
              <% if vehicle.last_seen_at %>
                <div class="flex items-center text-gray-600">
                  <span class="w-20 font-medium">Last Seen:</span>
                  <span class="font-mono ml-2"><%= time_ago_in_words(vehicle.last_seen_at) %> ago</span>
                </div>
              <% end %>
              <% if vehicle.temperature %>
                <div class="flex items-center <%= vehicle.temperature >= 2 && vehicle.temperature <= 8 ? 'text-emerald-600' : 'text-orange-600' %>">
                  <span class="w-20 font-medium">Temp:</span>
                  <span class="font-bold ml-2"><%= vehicle.temperature %>°C</span>
                  <span class="ml-2 text-xs bg-<%= vehicle.temperature >= 2 && vehicle.temperature <= 8 ? 'emerald' : 'orange' %>-100 px-2 py-1 rounded-full">
                    <%= vehicle.temperature >= 2 && vehicle.temperature <= 8 ? '✅ Optimal' : '⚠️ Alert' %>
                  </span>
                </div>
              <% end %>
            </div>

            <!-- Quick Actions -->
            <div class="flex space-x-3 mt-8 pt-6 border-t border-gray-100">
              <%= link_to "GPS Log", vehicle_path(vehicle), 
                  class: "flex-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white py-2 px-4 rounded-xl text-sm font-semibold text-center hover:shadow-lg transition-all hover:from-blue-600 hover:to-blue-700" %>
              <%= link_to "Health", health_vehicle_path(vehicle), 
                  class: "flex-1 bg-emerald-500 text-white py-2 px-4 rounded-xl text-sm font-semibold text-center hover:shadow-lg transition-all hover:bg-emerald-600" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-24 bg-white/50 backdrop-blur-md rounded-3xl shadow-2xl border-2 border-dashed border-gray-300">
      <div class="text-6xl mb-8">🚛</div>
      <h2 class="text-3xl font-bold text-gray-600 mb-4">Fleet Standing By</h2>
      <p class="text-xl text-gray-500 mb-8 max-w-md mx-auto">
        No vehicles currently reporting GPS. Queclink GV55 devices will appear here when online.
      </p>
      <div class="inline-flex items-center px-6 py-3 bg-emerald-100 text-emerald-800 rounded-full font-semibold text-lg">
        ✅ IoT GPS Ready
      </div>
    </div>
  <% end %>
</div>
