<!DOCTYPE html>
<html>
<head>
  <title>Pharma GPS Live Tracking - PHASE 2</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen p-8">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-5xl font-black text-blue-700 mb-8 text-center drop-shadow-lg">
      🚛 Pharma GPS Dashboard - PHASE 2 LIVE
    </h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- GPS Map -->
      <div class="bg-white rounded-2xl shadow-2xl p-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">🗺️ Live Vehicle Tracking</h2>
        <div id="map" class="w-full h-96 border-4 border-blue-500 rounded-xl shadow-xl bg-gray-100"></div>
        <p class="mt-4 text-sm text-gray-600 font-mono">Phoenix Hub • 33.4484°N, 112.0740°W</p>
      </div>
      
      <!-- Status Panel -->
      <div class="bg-gradient-to-br from-emerald-50 to-blue-100 p-8 rounded-2xl shadow-xl border-2 border-emerald-200">
        <h2 class="text-2xl font-bold text-emerald-800 mb-6">✅ PHASE 2 INFRASTRUCTURE</h2>
        <div class="space-y-4 text-lg">
          <div class="flex items-center"><span class="text-emerald-600 text-2xl mr-3">✓</span> GPS Columns: lat/lng/last_ping</div>
          <div class="flex items-center"><span class="text-emerald-600 text-2xl mr-3">✓</span> Solid Cable PostgreSQL ✓</div>
          <div class="flex items-center"><span class="text-emerald-600 text-2xl mr-3">✓</span> VehiclesController ready</div>
          <div class="flex items-center"><span class="text-blue-600 text-2xl mr-3">⚡</span> Google Maps API ready</div>
          <div class="flex items-center"><span class="text-purple-600 text-xl mr-3">🎯</span> Next: FDA Compliance</div>
        </div>
      </div>
    </div>
  </div>

  <script async defer 
    src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap">
  </script>
  <script>
  function initMap() {
    const map = new google.maps.Map(document.getElementById('map'), {
      center: {lat: 33.4484, lng: -112.0740},
      zoom: 11,
      mapTypeId: 'roadmap',
      fullscreenControl: true,
      streetViewControl: false
    });
    
    // Demo vehicles (Phase 2)
    const vehicles = [
      {lat: 33.4484, lng: -112.0740, name: 'HQ Depot', color: 'red'},
      {lat: 33.4255, lng: -111.9379, name: 'PHX Airport', color: 'blue'},
      {lat: 33.3523, lng: -111.7890, name: 'Mesa Hospital', color: 'green'}
    ];
    
    vehicles.forEach(v => {
      new google.maps.Marker({
        position: {lat: v.lat, lng: v.lng},
        map: map,
        title: v.name,
        icon: `https://maps.google.com/mapfiles/ms/icons/truck-${v.color}.png`
      });
    });
  }
  </script>
</body>
</html>
