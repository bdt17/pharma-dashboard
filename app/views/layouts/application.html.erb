<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>body{margin:0;padding:20px;font-family:system-ui;background:#0a0a0a;}</style>
</head>
<body>
  <div style="max-width:1200px;margin:0 auto;">
    <%= yield %>
  </div>
</body>
</html>

<style>
  .dashboard { max-width: 1000px; margin: 20px auto; padding: 30px; background: #1e3c72; color: white; border-radius: 12px; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 30px 0; }
  .stat { text-align: center; padding: 20px; background: rgba(255,255,255,0.1); border-radius: 8px; }
  .number { font-size: 40px; font-weight: bold; margin-bottom: 5px; }
  .green { color: #00ff88; }
  .orange { color: #ffaa00; }
  .red { color: #ff4444; }
  .content { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 30px 0; }
  .section h2 { margin-bottom: 15px; font-size: 22px; }
  .section ul { list-style: none; }
  .section li { margin-bottom: 10px; padding: 10px; background: rgba(0,0,0,0.3); border-radius: 6px; }
  .section span { color: #00ff88; font-weight: bold; float: right; }
  .button { 
    display: inline-block; padding: 15px 30px; background: #00ff88; 
    color: black; text-decoration: none; border-radius: 8px; 
    font-weight: bold; font-size: 16px; text-align: center;
  }
</style>
