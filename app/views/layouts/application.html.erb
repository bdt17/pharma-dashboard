<!DOCTYPE html>
<html>
<head>
  <title>Thomas IT Network - Pharma Transport</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    :root {
      --primary-blue: #0984C0;
      --accent-silver: #AAA7B0;
      --mid-grey: #565759;
      --light-variant: #C0BEC6;
      --lighter-blue: #60BDD1;
      --white: #FFFFFF;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background: var(--white); color: var(--mid-grey); min-height: 100vh; }
    .header { 
      background: linear-gradient(135deg, var(--primary-blue), #60BDD1);
      color: white; 
      padding: 3rem 2rem; 
      text-align: center;
      box-shadow: 0 10px 30px rgba(9,132,192,0.3);
    }
    .logo { 
      display: block; 
      font-size: 2.5rem; 
      font-weight: bold; 
      color: #000; 
      background: white; 
      padding: 0.5rem 1.5rem; 
      border-radius: 50px; 
      display: inline-block;
      margin-bottom: 1rem;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }
    .header h1 { font-size: 2.5rem; margin: 0; text-shadow: 0 2px 4px rgba(0,0,0,0.3); }
    .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 3rem; }
    .stat-card { background: var(--white); border: 1px solid var(--accent-silver); padding: 2rem; border-radius: 16px; box-shadow: 0 5px 20px rgba(0,0,0,0.1); text-align: center; }
    .stat-number { font-size: 3rem; font-weight: bold; color: var(--primary-blue); margin-bottom: 0.5rem; }
    .stat-label { font-size: 1.1rem; color: var(--light-variant); text-transform: uppercase; letter-spacing: 1px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo">Thomas IT Network</div>
    <h1>🚀 Pharma Transport Dashboard</h1>
    <p>Enterprise Cold Chain + GPS Tracking</p>
  </div>
  <div class="container">
    <%= yield %>
  </div>
</body>
</html>
