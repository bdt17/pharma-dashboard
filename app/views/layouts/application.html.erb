<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport Enterprise</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <%= csrf_meta_tags %>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #ffffff;
      color: #1f2937;
      line-height: 1.6;
    }
    header {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
      color: white;
      padding: 1rem 0;
      box-shadow: 0 4px 6px -1px rgba(0, 0,0,0.1);
    }
    nav {
      max-width: 1200px; margin: 0 auto; padding: 0 2rem;
      display: flex; justify-content: space-between; align-items: center;
    }
    .logo { font-size: 1.5rem; font-weight: 700; }
    nav ul { list-style: none; display: flex; gap: 2rem; margin: 0; padding: 0; }
    nav a {
      color: white; text-decoration: none; padding: 0.5rem 1rem;
      border-radius: 0.5rem; transition: all 0.2s;
    }
    nav a:hover { background: rgba(255,255,255,0.2); }
    main {
      max-width: 1200px; margin: 4rem auto; padding: 0 2rem;
    }
    .content-card {
      background: white; padding: 3rem; border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0,0,0.1), 0 4px 6px -2px rgba(0, 0,0,0.05);
      border-top: 4px solid #3b82f6;
    }
    h1 { color: #1e40af; font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }
    footer {
      background: #f8fafc; color: #64748b; text-align: center;
      padding: 2rem; margin-top: 4rem; border-top: 1px solid #e2e8f0;
    }
    @media (max-width: 768px) {
      nav { flex-direction: column; gap: 1rem; }
      nav ul { flex-wrap: wrap; justify-content: center; }
      .content-card { padding: 2rem 1rem; margin: 2rem 1rem; }
    }
  </style>
</head>
<body>
<nav style="position:fixed;top:0;left:0;right:0;background:rgba(15,23,42,0.98);backdrop-filter:blur(20px);z-index:10000;padding:1rem 2rem;box-shadow:0 4px 20px rgba(0,0,0,0.3);font-family:Inter,Arial,sans-serif;">
  <div style="max-width:1400px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;">
    <a href="/" style="color:#10b981;font-size:1.5rem;font-weight:800;text-decoration:none;">Pharma Transport</a>
    <div style="display:flex;gap:1rem;">
      <a href="/gps" style="color:white;padding:0.75rem 1.5rem;border-radius:8px;transition:all 0.3s;">Live GPS</a>
      <a href="/batches" style="color:white;padding:0.75rem 1.5rem;border-radius:8px;transition:all 0.3s;">Batches</a>
      <a href="/health" style="color:#10b981;padding:0.75rem 1.5rem;border-radius:8px;font-weight:600;border:2px solid #10b981;">Health</a>
      <a href="/users/sign_in" style="background:#0984C0;color:white!important;padding:0.75rem 2rem;border-radius:10px;font-weight:700;box-shadow:0 4px 15px rgba(9,132,192,0.4);">🔐 Enterprise Login</a>
    </div>
  </div>
</nav>
  <header>
    <nav>
      <div class="logo">🚛 PHARMA TRANSPORT ENTERPRISE</div>
      <ul>
        <li><%= link_to "🩺 Dashboard", enterprise_dashboard_path %></li>
        <li><%= link_to "🚛 Vehicles", gps_path %></li>
        <li><%= link_to "💉 Batches", batches_pdf_path %></li>
        <li><%= link_to "🛰️ GPS", gps_path %></li>
        <li><%= link_to "💰 Billing", billing_path %></li>
        <li><a href="/health">🔬 Health</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="content-card">
      <%= yield %>
    </div>
  </main>

  <footer>
    🔬 DEA/FDA 21 CFR Part 11 Compliant | 🌡️ Cold Chain IoT Ready | 📊 Phase 10 Enterprise SaaS LIVE
  </footer>
</body>
</html>
<nav style="position:fixed;top:0;left:0;right:0;background:rgba(15,23,42,0.95);backdrop-filter:blur(20px);z-index:9999;padding:1rem 2rem;box-shadow:0 4px 20px rgba(0,0,0,0.3);">
  <div style="max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;">
    <a href="/" style="color:#10b981;font-size:1.5rem;font-weight:800;text-decoration:none;">Pharma Transport</a>
    <div style="display:flex;gap:1rem;">
      <a href="/gps" style="color:white;padding:0.5rem 1rem;text-decoration:none;border-radius:6px;transition:all 0.3s;">Live GPS</a>
      <a href="/batches" style="color:white;padding:0.5rem 1rem;text-decoration:none;border-radius:6px;transition:all 0.3s;">Batches</a>
      <a href="/health" style="color:#10b981;padding:0.5rem 1rem;text-decoration:none;border-radius:6px;font-weight:600;border:2px solid #10b981;transition:all 0.3s;">Health</a>
      <a href="<%= new_user_session_path %>" style="background:#0984C0;color:white!important;padding:0.75rem 2rem;text-decoration:none!important;border-radius:8px;font-weight:700;box-shadow:0 4px 15px rgba(9,132,192,0.4);transition:all 0.3s;">🔐 Enterprise Login</a>
    </div>
  </div>
</nav>
