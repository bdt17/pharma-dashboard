<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all" %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">
  
  <!-- LOGIN NAVBAR -->
  <nav class="bg-gradient-to-r from-blue-900 to-indigo-900 p-6 text-white shadow-2xl">
    <div class="container mx-auto flex justify-between items-center">
      <h1 class="text-3xl font-black tracking-tight">🚚 Pharma Transport</h1>
      
      <% if current_user %>
        <div class="flex items-center space-x-6">
          <div class="text-lg font-semibold">
            👋 Welcome <span class="text-yellow-300"><%= current_user.name %></span> 
            (<span class="bg-green-500 px-2 py-1 rounded-full text-xs font-bold"><%= current_user.role || 'user' %></span>)
          </div>
          <%= link_to "🚪 Logout", logout_path, 
              method: :delete, 
              class: "bg-red-600 hover:bg-red-700 px-6 py-2 rounded-xl font-bold transition-all duration-200" %>
        </div>
      <% else %>
        <div>
          <%= link_to "🔐 Login", login_path, 
              class: "bg-green-600 hover:bg-green-700 px-8 py-3 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-1" %>
        </div>
      <% end %>
    </div>
  </nav>

  <% if flash[:notice] %>
    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mx-6 mt-4 rounded-lg shadow">
      <%= flash[:notice] %>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mx-6 mt-4 rounded-lg shadow">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <main class="container mx-auto px-6 pb-12">
    <%= yield %>
  </main>
</body>
</html>
