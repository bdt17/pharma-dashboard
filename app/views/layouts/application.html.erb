<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body class="bg-white min-h-screen text-gray-900 p-0 m-0">
  <!-- GLOBAL NAVBAR -->
  <nav class="bg-white border-b shadow-sm py-3 px-4">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center">
        <span class="text-2xl mr-3">💉</span>
        <h1 class="text-lg font-bold text-[#0984C0]">Pharma Transport</h1>
      </div>
      <div class="flex space-x-6">
        <%= link_to "Dashboard", dashboard_path, class: "text-gray-700 hover:text-gray-900" %>
        <%= link_to "Shipments", batches_path, class: "text-gray-700 hover:text-gray-900" %>
        <%= link_to "Fleet", vehicles_path, class: "text-gray-700 hover:text-gray-900" %>
        <%= link_to "Reports", compliance_path, class: "text-gray-700 hover:text-gray-900" %>
      </div>
      <div>
        <%= form_tag "/users/sign_in", method: :post do %>
          <%= submit_tag "Sign in", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        <% end %>
      </div>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <!-- ALL PAGE CONTENT GOES HERE -->
    <%= yield %>
  </main>
</body>
</html>
