<!DOCTYPE html>
<html>
<head>
  <title>🏥 PharmaTransport 2.0 ENTERPRISE</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Pharma Transport Dashboard - Enterprise Logistics & Compliance">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-white to-purple-50 min-h-screen">
  
  <!-- Navigation -->
  <nav class="bg-white/80 backdrop-blur-md shadow-lg border-b border-indigo-100 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-8">
          <h1 class="text-2xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
            🏥 PharmaTransport 2.0
          </h1>
          <div class="hidden md:flex space-x-6">
            <%= link_to "📈 Health", "/health", class: "text-gray-700 hover:text-indigo-600 font-medium transition-colors" %>
            <%= link_to "🚚 Vehicles", "/vehicles", class: "text-gray-700 hover:text-indigo-600 font-medium transition-colors" %>
            <%= link_to "📦 Batches", "/batches", class: "text-gray-700 hover:text-indigo-600 font-medium transition-colors" %>
            <%= link_to "📋 Compliance", "/compliance", class: "text-gray-700 hover:text-indigo-600 font-medium transition-colors" %>
            <%= link_to "💰 Billing", "/billing", class: "text-gray-700 hover:text-indigo-600 font-medium transition-colors" %>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <span class="text-sm text-gray-600">👋 <%= current_user.email %></span>
            <%= link_to "🚪 Logout", destroy_user_session_path, method: :delete, 
                class: "px-4 py-2 bg-red-100 text-red-700 rounded-xl hover:bg-red-200 transition-all font-medium" %>
          <% else %>
            <%= link_to "🔐 Login", new_user_session_path, 
                class: "px-6 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl hover:from-indigo-700 hover:to-purple-700 shadow-lg transition-all font-semibold" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-6 py-12">
    <%= yield %>
  </main>

  <!-- Flash Messages -->
  <% if notice %>
    <div class="fixed top-24 right-6 bg-green-500 text-white px-6 py-4 rounded-2xl shadow-2xl transform translate-x-full transition-all duration-300 z-50 animate-slide-in-right">
      <%= notice %>
      <button onclick="this.parentElement.remove()" class="ml-4 text-white opacity-75 hover:opacity-100">&times;</button>
    </div>
  <% end %>

  <% if alert %>
    <div class="fixed top-24 right-6 bg-red-500 text-white px-6 py-4 rounded-2xl shadow-2xl transform translate-x-full transition-all duration-300 z-50 animate-slide-in-right">
      <%= alert %>
      <button onclick="this.parentElement.remove()" class="ml-4 text-white opacity-75 hover:opacity-100">&times;</button>
    </div>
  <% end %>

  <script>
    // Auto-dismiss flash messages
    setTimeout(() => {
      document.querySelectorAll('.animate-slide-in-right').forEach(el => {
        el.style.transform = 'translateX(100%)';
        setTimeout(() => el.remove(), 300);
      });
    }, 5000);
  </script>

  <style>
    @keyframes slide-in-right {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    .animate-slide-in-right {
      animation: slide-in-right 0.3s ease-out;
    }
  </style>
</html>

