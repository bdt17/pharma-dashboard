<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Pharma Transport Dashboard">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f8fafc;
      color: #565759;
      line-height: 1.6;
    }
    .main-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    .dashboard-card {
      background: white;
      border-radius: 12px;
      padding: 2rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      border: 1px solid #AAA7B0;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }
    .stat-item { text-align: center; padding: 1.5rem; }
    .stat-number { 
      font-size: 2.5rem; 
      font-weight: 700; 
      color: #0984C0; 
      margin-bottom: 0.25rem; 
    }
    .stat-label { 
      color: #C0BEC6; 
      text-transform: uppercase; 
      font-size: 0.875rem; 
      letter-spacing: 0.05em; 
    }
    .status-indicators {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin: 2rem 0;
    }
    .status-item {
      background: white;
      padding: 1rem 1.5rem;
      border-radius: 8px;
      border-left: 4px solid #60BDD1;
      flex: 1;
      min-width: 200px;
    }
    footer {
      background: #0984C0;
      color: white;
      text-align: center;
      padding: 2rem;
      margin-top: 4rem;
    }
    @media (max-width: 768px) {
      .main-content { padding: 1rem; }
      .stats-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <main class="main-content">
    <div class="dashboard-card">
      <%= yield %>
    </div>
  </main>
  
  <footer>
    <p>&copy; 2026 Thomas IT Network. All rights reserved.</p>
    <p>Pharma Transport Dashboard | Enterprise Cold Chain Solutions</p>
  </footer>
</body>
</html>
