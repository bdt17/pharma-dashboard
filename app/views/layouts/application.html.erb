<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport Enterprise</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <%= csrf_meta_tags %>
  <%# Never wired up before -- config/importmap.rb didn't even exist, so no
      Stimulus controller in this app (gps_map_controller.js etc.) has ever
      actually loaded in a browser. Needed now for real: signature capture
      below depends on JS actually running. %>
  <%= javascript_importmap_tags %>
  <%# Same story as the importmap above: every Tailwind utility class used
      throughout app/views (p-2, border, max-w-lg, text-2xl, bg-gray-100...)
      has never actually rendered -- nothing linked a compiled stylesheet
      here. tailwindcss-rails compiles app/assets/tailwind/application.css
      to app/assets/builds/tailwind.css automatically as part of
      assets:precompile. %>
  <%= stylesheet_link_tag "tailwind" %>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #ffffff;
      color: #1f2937;
      line-height: 1.6;
    }
    header {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
      color: white;
      padding: 1rem 0;
      box-shadow: 0 4px 6px -1px rgba(0, 0,0,0.1);
    }
    nav {
      max-width: 1200px; margin: 0 auto; padding: 0 2rem;
      display: flex; justify-content: space-between; align-items: center;
    }
    .logo { font-size: 1.5rem; font-weight: 700; }
    nav ul { list-style: none; display: flex; gap: 2rem; margin: 0; padding: 0; }
    nav a {
      color: white; text-decoration: none; padding: 0.5rem 1rem;
      border-radius: 0.5rem; transition: all 0.2s;
    }
    nav a:hover { background: rgba(255,255,255,0.2); }
    main {
      max-width: 1200px; margin: 4rem auto; padding: 0 2rem;
    }
    .content-card {
      background: white; padding: 3rem; border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0,0,0.1), 0 4px 6px -2px rgba(0, 0,0,0.05);
      border-top: 4px solid #3b82f6;
    }
    h1 { color: #1e40af; font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }
    .flash { padding: 1rem 2rem; margin: 1rem 2rem 0; border-radius: 0.5rem; max-width: 1200px; margin-left: auto; margin-right: auto; }
    .flash-notice { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .flash-alert { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    footer {
      background: #f8fafc; color: #64748b; text-align: center;
      padding: 2rem; margin-top: 4rem; border-top: 1px solid #e2e8f0;
    }
    @media (max-width: 768px) {
      nav { flex-direction: column; gap: 1rem; }
      nav ul { flex-wrap: wrap; justify-content: center; }
      .content-card { padding: 2rem 1rem; margin: 2rem 1rem; }
    }
  </style>
</head>
<body>
  <header>
    <nav>
      <div class="logo">🚛 Pharma Transport</div>
      <ul>
        <li><%= link_to "Dashboard", dashboard_path %></li>
        <li><%= link_to "GPS", gps_path %></li>
        <li><%= link_to "Billing", billing_path %></li>
        <li><%= link_to "Compliance", compliance_path %></li>
        <% if user_signed_in? %>
          <li><%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete } %></li>
        <% else %>
          <li><%= link_to "Sign in", new_user_session_path %></li>
        <% end %>
      </ul>
    </nav>
  </header>

  <% if notice %>
    <div class="flash flash-notice"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="flash flash-alert"><%= alert %></div>
  <% end %>

  <main>
    <div class="content-card">
      <%= yield %>
    </div>
  </main>

  <footer>
    Pharma Transport &middot;
    <%= link_to "Terms", terms_path %> &middot;
    <%= link_to "Privacy", privacy_path %>
  </footer>
</body>
</html>
