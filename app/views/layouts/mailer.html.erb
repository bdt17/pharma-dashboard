<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <%# Email clients strip <style> and block images by default, so the
      frame is tables with inline styles and a text wordmark -- it looks
      the same in Gmail, Outlook and Apple Mail with images off. %>
  <body style="margin:0;padding:0;background:#f4f6f8;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
            <tr>
              <td style="padding:0 4px 14px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:16px;font-weight:600;color:#14273a;">
                <span style="display:inline-block;width:22px;height:22px;line-height:22px;border-radius:6px;background:#1f3a53;color:#ffffff;font-size:13px;text-align:center;vertical-align:-4px;">&#9679;</span>&nbsp; Pharma Transport
              </td>
            </tr>
            <tr>
              <td style="background:#ffffff;border:1px solid #dfe5eb;border-radius:10px;padding:28px 28px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:14px;line-height:1.55;color:#131a24;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:14px 4px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:12px;line-height:1.5;color:#71809a;">
                Pharma Transport &middot; Chain-of-custody records for independent pharmacies &middot;
                <a href="https://pharmatransport.org" style="color:#71809a;">pharmatransport.org</a><br>
                Questions? Reply to this email and a person will answer.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
