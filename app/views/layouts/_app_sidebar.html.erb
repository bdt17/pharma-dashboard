<%
  nav_item = ->(label, path, active, icon) do
    base = "flex items-center gap-2.5 px-2.5 py-2 rounded-sm text-[13.5px] font-medium transition-colors"
    cls  = active ? "#{base} bg-brand-700 text-white" : "#{base} text-ink-soft hover:bg-surface hover:text-ink"
    link_to(path, class: cls) { safe_join([content_tag(:span, icon.html_safe, class: "shrink-0"), label]) }
  end
  ico = ->(paths) { %(<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">#{paths}</svg>) }
  path = request.path
%>
<aside class="w-[236px] shrink-0 bg-paper border-r border-line flex flex-col p-3.5 gap-1.5">
  <%= link_to root_path, class: "flex items-center gap-2.5 font-sans font-semibold text-[14.5px] text-ink px-2 pt-2 pb-3.5" do %>
    <span class="w-[26px] h-[26px] rounded-[7px] bg-brand-700 text-white flex items-center justify-center shrink-0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="2.4"/><circle cx="19" cy="12" r="2.4"/><path d="M7.4 12h9.2"/><path d="M12 8.2v7.6"/></svg>
    </span>
    <span>Pharma Transport</span>
  <% end %>

  <div class="flex items-center justify-between border border-line rounded-sm px-2.5 py-2 text-[12.5px] text-ink-soft mb-2.5">
    <span class="truncate"><%= current_organization&.name %></span>
  </div>

  <%= nav_item.("Dashboard", dashboard_path, path == dashboard_path,
        ico.('<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>')) %>
  <%= nav_item.("Fleet GPS", gps_path, path == gps_path,
        ico.('<path d="M12 21s-6.5-5.6-6.5-10A6.5 6.5 0 0 1 18.5 11c0 4.4-6.5 10-6.5 10Z"/><circle cx="12" cy="11" r="2.3"/>')) %>
  <%= nav_item.("Compliance", compliance_path, path == compliance_path,
        ico.('<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8 3.2-3.6"/>')) %>
  <%= nav_item.("Alerts", alert_settings_path, path == alert_settings_path,
        ico.('<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>')) %>
  <%= nav_item.("Billing", billing_path, path == billing_path,
        ico.('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>')) %>
  <%= nav_item.("Security", two_factor_setup_path, path.start_with?("/two_factor"),
        ico.('<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>')) %>

  <div class="mt-auto pt-2.5 border-t border-line-soft flex flex-col gap-0.5">
    <%= button_to destroy_user_session_path, method: :delete,
          class: "w-full flex items-center gap-2.5 px-2.5 py-2 rounded-sm text-[13.5px] font-medium text-ink-soft hover:bg-surface hover:text-ink text-left" do %>
      <span class="shrink-0"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg></span>
      Sign out
    <% end %>
  </div>
</aside>
