<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport Enterprise</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { pharma: { 500: '#0ea5e9', 600: '#0284c7' } } } }
    }
  </script>
  <style>
    .glass { backdrop-filter: blur(20px); background: rgba(255,255,255,0.25); }
    .gradient-text { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-emerald-50 min-h-screen antialiased">
  <nav class="glass shadow-xl border-b border-white/50 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <div class="text-3xl">💉</div>
          <h1 class="text-2xl font-bold gradient-text">Pharma Transport</h1>
        </div>
        <div class="flex space-x-4">
          <a href="/dashboard" class="px-4 py-2 rounded-xl hover:bg-white/50 transition-all">Dashboard</a>
          <a href="/vehicles" class="px-4 py-2 rounded-xl hover:bg-white/50 transition-all">Vehicles</a>
          <a href="/batches" class="px-4 py-2 rounded-xl hover:bg-white/50 transition-all">Batches</a>
          <a href="/subscribe" class="bg-gradient-to-r from-emerald-500 to-blue-600 text-white px-6 py-2 rounded-2xl font-semibold shadow-lg hover:shadow-xl transition-all">
            Pro $99/mo
          </a>
        </div>
      </div>
    </div>
  </nav>
  
  <main class="pt-4">
    <%= yield %>
  </main>
</body>
</html>
