<!DOCTYPE html>
<html style="ALL: unset !important; background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important; margin: 0 !important; padding: 0 !important;">
<head>
  <title>Pharma Transport Dashboard</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- TOTAL CSS APOCALYPSE -->
  <style>
    /* KILL EVERYTHING */
    * { 
      all: revert !important; 
      box-sizing: border-box !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    
    /* FORCE YOUR COLORS */
    html, body {
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important;
      color: #FFFFFF !important;
      font-family: -apple-system, BlinkMacSystemFont, sans-serif !important;
      min-height: 100vh !important;
      line-height: 1.6 !important;
    }
    
    /* NUKE ALL CLASSES */
    *::before, *::after { all: revert !important; }
    
    /* KILL LINK PURPLE */
    a, a:visited, a:link, a:hover, a:active, a:focus {
      color: #60BDD1 !important;
      text-decoration: none !important;
    }
    
    /* KILL RAILS/TURBO */
    [data-turbo], turbo-frame, turbo-cable-stream-source {
      all: revert !important;
    }
  </style>
</head>
<body style="background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important;">
  <!-- NAV BAR -->
  <nav style="background: rgba(9,132,192,0.98) !important; border-bottom: 3px solid #0984C0 !important; padding: 1rem 2rem; position: sticky; top: 0; z-index: 999 !important; backdrop-filter: blur(30px) !important;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #0984C0, #60BDD1) !important; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; box-shadow: 0 12px 40px rgba(9,132,192,0.5) !important;">
          💉
        </div>
        <div>
          <h1 style="font-size: 2.4rem; font-weight: 900; color: #FFFFFF !important; margin: 0; text-shadow: 0 2px 10px rgba(0,0,0,0.3) !important;">Pharma Transport</h1>
          <p style="color: #C0BEC6 !important; font-size: 1rem; margin: 0; font-weight: 500;">Phase 14 LIVE - GPS + AI + Marketplace</p>
        </div>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main style="max-width: 1300px; margin: 2rem auto; padding: 0 2rem; background: transparent !important;">
    <%= yield %>
  </main>
</body>
</html>
