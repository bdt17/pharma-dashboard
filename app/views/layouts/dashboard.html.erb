<!DOCTYPE html>
<html style="ALL: unset !important; background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 60%, #1E1B4B 100%) !important; margin: 0 !important; padding: 0 !important;">
<head>
  <title>Pharma Transport - Executive Dashboard</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    * { all: revert !important; box-sizing: border-box !important; margin: 0 !important; padding: 0 !important; }
    html, body { 
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 60%, #1E1B4B 100%) !important;
      color: #FFFFFF !important;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
      min-height: 100vh !important;
      overflow-x: hidden !important;
    }
    a { color: #60BDD1 !important; text-decoration: none !important; }
    .glass { 
      background: rgba(255,255,255,0.06) !important; 
      backdrop-filter: blur(25px) !important; 
      border: 1px solid rgba(9,132,192,0.3) !important;
    }
    .glow-blue { box-shadow: 0 0 30px rgba(9,132,192,0.4) !important; }
    .metric-glow { text-shadow: 0 0 25px rgba(96,189,209,0.8) !important; }
  </style>
</head>
<body>
  <!-- HERO COMMAND CENTER -->
  <div style="position: fixed; top: 0; left: 0; right: 0; height: 120px; background: rgba(9,132,192,0.95) !important; backdrop-filter: blur(40px) !important; z-index: 1000; border-bottom: 3px solid #0984C0 !important;">
    <div style="max-width: 1400px; margin: 0 auto; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center;">
      <!-- LOGO + STATUS -->
      <div style="display: flex; align-items: center; gap: 1.5rem;">
        <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #0984C0, #60BDD1, #0984C0) !important; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; box-shadow: 0 20px 40px rgba(9,132,192,0.6) !important; animation: pulse 2s infinite;">
          💉
        </div>
        <div>
          <h1 style="font-size: 2.8rem; font-weight: 900; background: linear-gradient(90deg, #FFFFFF, #60BDD1) !important; -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0;">Pharma Transport</h1>
          <div style="display: flex; gap: 2rem; font-size: 1.1rem; color: #C0BEC6 !important; font-weight: 500; mt: 0.5rem;">
            <span>🛰️ Phase 14 LIVE</span>
            <span>📡 24 GPS Vehicles</span>
            <span>⚡ Real-time AI</span>
          </div>
        </div>
      </div>
      
      <!-- ACTION BUTTONS -->
      <div style="display: flex; gap: 1rem;">
        <a href="/vehicles" style="background: rgba(96,189,209,0.2) !important; border: 2px solid #60BDD1 !important; color: #FFFFFF !important; padding: 1rem 2rem; border-radius: 16px; font-weight: 700; font-size: 1rem; glow-blue;">🚛 Vehicle Control</a>
        <a href="/batches" style="background: linear-gradient(90deg, #0984C0, #60BDD1) !important; color: #FFFFFF !important; padding: 1rem 2.5rem; border-radius: 16px; font-weight: 800; font-size: 1.1rem; box-shadow: 0 15px 35px rgba(9,132,192,0.6) !important;">🚀 Production Platform</a>
      </div>
    </div>
  </div>

  <!-- MAIN DASHBOARD -->
  <main style="margin-top: 140px; max-width: 1400px; margin-left: auto; margin-right: auto; padding: 0 2rem;">
    
    <!-- NORTH STAR METRICS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
      
      <!-- PRIMARY KPI -->
      <div class="glass" style="padding: 3.5rem 3rem; border-radius: 24px; text-align: center; glow-blue; border: 2px solid rgba(9,132,192,0.5) !important;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem; opacity: 0.9;">🚛</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 1px;">Live Vehicles</h3>
        <div style="font-size: 4.2rem; font-weight: 900; color: #60BDD1 !important; metric-glow; line-height: 1;">24</div>
        <p style="color: #AAA7B0 !important; font-size: 1.1rem; margin-top: 1rem;">GPS Tracked • 100% Uptime</p>
      </div>

      <!-- REVENUE FLASH -->
      <div class="glass" style="padding: 3.5rem 3rem; border-radius: 24px; text-align: center; background: rgba(255,215,0,0.08) !important; border: 2px solid rgba(255,215,0,0.4) !important; box-shadow: 0 0 40px rgba(255,215,0,0.3) !important;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem;">💰</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1.5rem; font-weight: 500; text-transform: uppercase;">Monthly Revenue</h3>
        <div style="font-size: 4.2rem; font-weight: 900; color: #FFD700 !important; text-shadow: 0 0 30px rgba(255,215,0,0.8) !important; line-height: 1;">$12K</div>
        <p style="color: #D4AF37 !important; font-size: 1.1rem; margin-top: 1rem; font-weight: 600;">+18% Phase 14 Growth</p>
      </div>

      <!-- BATCHES -->
      <div class="glass" style="padding: 3.5rem 3rem; border-radius: 24px; text-align: center; glow-blue;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem;">📦</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1.5rem; font-weight: 500; text-transform: uppercase;">Active Batches</h3>
        <div style="font-size: 4.2rem; font-weight: 900; color: #0984C0 !important; metric-glow; line-height: 1;">127</div>
        <p style="color: #AAA7B0 !important; font-size: 1.1rem; margin-top: 1rem;">FDA Compliant • Temp Controlled</p>
      </div>
    </div>

    <!-- OPERATIONAL WIDGETS -->
    <div style="display: grid; grid-template-columns: 1fr 380px; gap: 3rem; margin-bottom: 3rem;">
      
      <!-- ALERTS & STATUS -->
      <div class="glass" style="padding: 2.5rem; border-radius: 20px; height: fit-content;">
        <h3 style="color: #FFFFFF !important; font-size: 1.6rem; font-weight: 800; margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem;">
          🚨 Live Alerts
        </h3>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div style="display: flex; justify-content: space-between; padding: 1.5rem; background: rgba(255,0,0,0.1) !important; border: 1px solid rgba(255,0,0,0.3) !important; border-radius: 12px;">
            <span style="color: #FF6B6B !important; font-weight: 600;">🚛 Vehicle #7 Temp Alert</span>
            <span style="color: #C0BEC6 !important;">02:14</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 1.5rem; background: rgba(255,193,7,0.1) !important; border: 1px solid rgba(255,193,7,0.3) !important; border-radius: 12px;">
            <span style="color: #FFD700 !important; font-weight: 600;">📦 Batch #184 Delay</span>
            <span style="color: #C0BEC6 !important;">01:47</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 1.5rem; background: rgba(0,255,0,0.1) !important; border: 1px solid rgba(0,255,0,0.3) !important; border-radius: 12px;">
            <span style="color: #51CF66 !important; font-weight: 600;">✅ All Systems Optimal</span>
            <span style="color: #C0BEC6 !important;">LIVE</span>
          </div>
        </div>
      </div>

      <!-- QUICK ACTIONS -->
      <div class="glass" style="padding: 2.5rem; border-radius: 20px; height: fit-content; glow-blue;">
        <h3 style="color: #FFFFFF !important; font-size: 1.6rem; font-weight: 800; margin-bottom: 2rem;">⚡ Quick Actions</h3>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <a href="#" style="background: rgba(96,189,209,0.2) !important; border: 1px solid #60BDD1 !important; padding: 1.25rem; border-radius: 12px; color: #FFFFFF !important; font-weight: 600; text-align: center;">📍 Reroute All Vehicles</a>
          <a href="#" style="background: rgba(76,175,80,0.2) !important; border: 1px solid #51CF66 !important; padding: 1.25rem; border-radius: 12px; color: #FFFFFF !important; font-weight: 600; text-align: center;">✅ Mark Batches Delivered</a>
          <a href="#" style="background: rgba(255,193,7,0.2) !important; border: 1px solid #FFD700 !important; padding: 1.25rem; border-radius: 12px; color: #FFFFFF !important; font-weight: 600; text-align: center;">📊 Generate Compliance Report</a>
        </div>
      </div>
    </div>

    <!-- FOOTER STATUS BAR -->
    <div style="background: rgba(15,23,42,0.8) !important; backdrop-filter: blur(20px) !important; border-top: 1px solid rgba(9,132,192,0.3) !important; padding: 2rem; border-radius: 20px; text-align: center;">
      <div style="display: flex; justify-content: space-around; flex-wrap: wrap; gap: 2rem; font-size: 1.1rem;">
        <span>🛰️ Solid Stack LIVE</span>
        <span>🔒 FDA Compliant</span>
        <span>⚡ 24/7 GPS Tracking</span>
        <span>🤖 AI Anomaly Detection</span>
      </div>
    </div>
  </main>

  <style>
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
  </style>
</body>
</html>

