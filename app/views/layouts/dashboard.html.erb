<!DOCTYPE html>
<html class="bg-gradient-to-br from-blue-900 to-slate-900">
<head>
  <title>Pharma Transport Dashboard</title>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= csrf_meta_tags %>

  <!-- 💥 PERMANENT PHARMA BLUE - NO PURPLE EVER -->
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important;
      color: #F8FAFC !important;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    nav {
      background: rgba(30,58,138,0.98) !important;
      backdrop-filter: blur(20px) !important;
      border-bottom: 1px solid rgba(59,130,246,0.3) !important;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5) !important;
    }
    .logo-badge {
      background: linear-gradient(90deg, #3B82F6 0%, #06B6D4 100%) !important;
      box-shadow: 0 10px 25px rgba(59,130,246,0.4) !important;
    }
    .phase-text { color: #BFDBFE !important; }
    main { background: transparent !important; }
  </style>
</head>
<body class="min-h-screen text-white">
  <nav class="bg-blue-900/95 backdrop-blur-md shadow-2xl border-b border-blue-500/30 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 logo-badge rounded-2xl flex items-center justify-center shadow-xl">
            <span class="text-2xl">🚛</span>
          </div>
          <div>
            <h1 class="text-2xl font-black tracking-tight text-white">Pharma Transport</h1>
            <p class="phase-text text-sm">Phase 14 LIVE - GPS + AI + Marketplace</p>
          </div>
        </div>
        <div class="flex space-x-2">
          <%= nav_link "📊 Dashboard", dashboard_index_path %>
          <%= nav_link "🚛 Vehicles", vehicles_path %>
          <%= nav_link "📦 Batches", batches_path %>
          <%= nav_link "🚨 Alerts", alerts_path %>
          <%= nav_link "💰 Revenue", revenue_path %>
          <%= nav_link "🧑 Drivers", drivers_path %>
          <%= nav_link "📋 Compliance", compliance_index_path %>
        </div>
      </div>
    </div>
  </nav>
  <main class="max-w-7xl mx-auto px-6 py-8">
    <%= yield %>
  </main>
</body>
</html>
