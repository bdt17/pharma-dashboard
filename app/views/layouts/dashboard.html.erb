<!DOCTYPE html>
<html style="background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important; margin: 0 !important; padding: 0 !important;">
<head>
  <title>Pharma Transport Dashboard</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- TOTAL CSS KILL SWITCH - YOUR COLORS ONLY -->
  <style>
    /* NUKE ALL FRAMEWORKS - PURE COLORS */
    * { 
      all: revert !important; 
      box-sizing: border-box !important;
    }
    
    html, body {
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important;
      color: #FFFFFF !important;
      font-family: -apple-system, BlinkMacSystemFont, sans-serif !important;
      min-height: 100vh !important;
      margin: 0 !important;
      padding: 0 !important;
      line-height: 1.6;
    }
    
    /* KILL TAILWIND PURPLE */
    [class*="purple"], [class*="violet"], [class*="indigo"],
    [class*="bg-"], [class*="text-"], [class*="border-"] {
      background: none !important;
      color: inherit !important;
      border-color: transparent !important;
    }
  </style>
</head>
<body>
  <!-- PRIMARY BLUE NAV #0984C0 -->
  <nav style="background: rgba(9,132,192,0.95) !important; border-bottom: 2px solid #0984C0 !important; padding: 1rem 2rem; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(20px);">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <!-- LOGO - DEEP OCEAN BLUE #0984C0 -->
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 52px; height: 52px; background: linear-gradient(135deg, #0984C0, #60BDD1) !important; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 8px 25px rgba(9,132,192,0.4);">
          💉
        </div>
        <div>
          <h1 style="font-size: 2.2rem; font-weight: 900; background: linear-gradient(90deg, #0984C0, #FFFFFF) !important; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0;">Pharma Transport</h1>
          <p style="color: #C0BEC6 !important; font-size: 0.95rem; margin: 0; font-weight: 500;">Phase 14 LIVE • 24 GPS Vehicles • 127 Batches</p>
        </div>
      </div>
      
      <!-- NAV LINKS - LIGHTER BLUE #60BDD1 -->
      <div style="display: flex; gap: 0.5rem;">
        <a href="/dashboard" style="color: #FFFFFF !important; text-decoration: none; padding: 0.75rem 1.5rem; background: rgba(96,189,209,0.2) !important; border: 1px solid #60BDD1 !important; border-radius: 10px; font-weight: 600; transition: all 0.3s ease; font-size: 0.9rem;">📊 Dashboard</a>
        <a href="/vehicles" style="color: #FFFFFF !important; text-decoration: none; padding: 0.75rem 1.5rem; background: rgba(96,189,209,0.2) !important; border: 1px solid #60BDD1 !important; border-radius: 10px; font-weight: 600; transition: all 0.3s ease; font-size: 0.9rem;">🚛 Vehicles</a>
        <a href="/batches" style="color: #FFFFFF !important; text-decoration: none; padding: 0.75rem 1.5rem; background: rgba(96,189,209,0.2) !important; border: 1px solid #60BDD1 !important; border-radius: 10px; font-weight: 600; transition: all 0.3s ease; font-size: 0.9rem;">📦 Batches</a>
        <a href="https://www.pharmatransport.org/" style="background: linear-gradient(90deg, #0984C0, #60BDD1) !important; color: #FFFFFF !important; padding: 0.75rem 2rem; border-radius: 10px; text-decoration: none; font-weight: 700; box-shadow: 0 8px 25px rgba(9,132,192,0.4) !important; font-size: 0.9rem;">🚀 Launch Platform</a>
      </div>
    </div>
  </nav>

  <main style="max-width: 1300px; margin: 2.5rem auto; padding: 0 2rem;">
    <!-- HERO GLASS CARD -->
    <div style="background: rgba(255,255,255,0.08) !important; backdrop-filter: blur(25px) !important; border: 1px solid rgba(9,132,192,0.3) !important; border-radius: 2rem; padding: 4rem 3rem; text-align: center; margin-bottom: 3rem; box-shadow: 0 25px 50px rgba(0,0,0,0.3);">
      <div style="font-size: 5rem; margin-bottom: 1.5rem; opacity: 0.9;">💉</div>
      <h2 style="color: #FFFFFF !important; font-size: 3rem; font-weight: 900; margin-bottom: 1rem; letter-spacing: -0.02em;">Executive Dashboard</h2>
      <p style="color: #C0BEC6 !important; font-size: 1.4rem; margin-bottom: 2.5rem; max-width: 600px; margin-left: auto; margin-right: auto;">Phase 14 LIVE • Real-time GPS Tracking • AI Predictive Analytics</p>
    </div>

    <!-- METRICS GRID -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
      
      <!-- VEHICLES CARD - PRIMARY BLUE -->
      <div style="background: rgba(255,255,255,0.08) !important; border: 2px solid rgba(9,132,192,0.4) !important; border-radius: 1.5rem; padding: 3rem 2.5rem; text-align: center; backdrop-filter: blur(20px) !important; transition: all 0.3s ease;">
        <div style="font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.9;">🚛</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.4rem; margin-bottom: 1rem; font-weight: 500;">Active Vehicles</h3>
        <div style="font-size: 3.5rem; font-weight: 900; color: #0984C0 !important; text-shadow: 0 0 20px rgba(9,132,192,0.5);">24</div>
        <p style="color: #AAA7B0 !important; font-size: 1rem; margin-top: 0.5rem;">GPS Tracked • Real-time</p>
      </div>

      <!-- BATCHES CARD - LIGHTER BLUE -->
      <div style="background: rgba(255,255,255,0.08) !important; border: 2px solid rgba(96,189,209,0.4) !important; border-radius: 1.5rem; padding: 3rem 2.5rem; text-align: center; backdrop-filter: blur(20px) !important; transition: all 0.3s ease;">
        <div style="font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.9;">📦</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.4rem; margin-bottom: 1rem; font-weight: 500;">Live Batches</h3>
        <div style="font-size: 3.5rem; font-weight: 900; color: #60BDD1 !important; text-shadow: 0 0 20px rgba(96,189,209,0.5);">127</div>
        <p style="color: #AAA7B0 !important; font-size: 1rem; margin-top: 0.5rem;">FDA Compliant • Temperature Controlled</p>
      </div>

      <!-- REVENUE CARD - GOLD ACCENT -->
      <div style="background: rgba(255,213,0,0.12) !important; border: 2px solid rgba(255,213,0,0.5) !important; border-radius: 1.5rem; padding: 3rem 2.5rem; text-align: center; backdrop-filter: blur(20px) !important; transition: all 0.3s ease;">
        <div style="font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.9;">💰</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.4rem; margin-bottom: 1rem; font-weight: 500;">Monthly Revenue</h3>
        <div style="font-size: 3.5rem; font-weight: 900; color: #FFD700 !important; text-shadow: 0 0 20px rgba(255,213,0,0.6);">$12K</div>
        <p style="color: #AAA7B0 !important; font-size: 1rem; margin-top: 0.5rem;">Phase 14 Growth</p>
      </div>
    </div>
  </main>
</body>
</html>

