<!DOCTYPE html>
<html style="background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important; margin: 0 !important; padding: 0 !important;">
<head>
  <title>Pharma Transport Dashboard</title>
  <%= csrf_meta_tags %>
  <!-- DISABLE ALL EXTERNAL CSS - PURE INLINE -->
  <style>
    * { margin: 0 !important; padding: 0 !important; box-sizing: border-box !important; }
    html, body { 
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important; 
      color: white !important; 
      font-family: -apple-system, BlinkMacSystemFont, sans-serif !important;
      min-height: 100vh !important;
    }
  </style>
</head>
<body>
  <!-- NAV - YOUR COLORS ONLY -->
  <nav style="background: rgba(9,132,192,0.95) !important; border-bottom: 1px solid #0984C0 !important; padding: 1rem 2rem; position: sticky; top: 0; z-index: 100;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 48px; height: 48px; background: linear-gradient(90deg, #0984C0, #60BDD1) !important; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
          🚛
        </div>
        <div>
          <h1 style="font-size: 2rem; font-weight: 900; color: white !important; margin: 0;">Pharma Transport</h1>
          <p style="color: #C0BEC6 !important; font-size: 0.9rem; margin: 0;">Phase 14 LIVE - GPS + AI + Marketplace</p>
        </div>
      </div>
      <div style="display: flex; gap: 1rem;">
        <a href="/dashboard" style="color: #60BDD1 !important; text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px;">📊 Dashboard</a>
        <a href="/vehicles" style="color: #60BDD1 !important; text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px;">🚛 Vehicles</a>
        <a href="/batches" style="color: #60BDD1 !important; text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px;">📦 Batches</a>
      </div>
    }
  </nav>

  <main style="max-width: 1200px; margin: 2rem auto; padding: 0 2rem;">
    <%= yield %>
  </main>
</body>
</html>
