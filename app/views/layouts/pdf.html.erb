<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Chain of Custody</title>
  <style>
    body { font-family: Arial, sans-serif; color: #333; max-width: 800px; margin: 40px; }
    .header { color: #0984C0; font-size: 28px; font-weight: bold; text-align: center; margin-bottom: 30px; }
    .compliance { background: #f8f9fa; padding: 20px; border-left: 5px solid #0984C0; margin: 20px 0; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin: 30px 0; }
    .stat { padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; }
    .stat h3 { color: #0984C0; font-size: 24px; margin: 0 0 10px 0; }
    .footer { margin-top: 50px; text-align: center; color: #666; font-size: 12px; }
  </style>
</head>
<body>
  <div class="header">CHAIN OF CUSTODY REPORT</div>
  <div class="compliance">
    <strong>FDA 21 CFR Part 11 Compliant</strong><br>
    Thomas Information Technology • Phoenix, AZ
  </div>
  <div class="stats">
    <div class="stat">
      <h3>PHARMA-<%= Time.now.strftime('%Y%m%d') %>-001</h3>
      <p><strong>Status:</strong> In Transit</p>
    </div>
    <div class="stat">
      <h3><%= (2 + rand*6).round(1) %>°C</h3>
      <p><strong>✓ 2-8°C Cold Chain</strong></p>
    </div>
  </div>
  <div class="footer">
    Generated <%= Time.now.strftime('%m/%d/%Y %I:%M %p MST') %>
  </div>
</body>
</html>
