<!DOCTYPE html>
<html>
<head><style>
  body{font-family:Arial;margin:40px;background:#000;color:#fff;}
  .header{text-align:center;color:#0984C0;}
  table{width:100%;border-collapse:collapse;margin:20px 0;}
  th,td{border:2px solid #0984C0;padding:12px;text-align:center;}
  th{background:#0984C0;color:white;}
</style></head>
<body>
  <div class="header">
    <h1>🚚 PHARMA TRANSPORT</h1>
    <h2>CHAIN OF CUSTODY - <%= @batch_id %></h2>
  </div>
  
  <table>
    <tr><th>Step</th><th>Location</th><th>Driver</th><th>Temp</th><th>Status</th></tr>
    <tr><td>Dispatched</td><td>Phoenix HQ</td><td>John Doe #123</td><td>4.2°C</td><td>✅</td></tr>
    <tr><td>In Transit</td><td>I-10 East</td><td>John Doe #123</td><td>5.1°C</td><td>🟢</td></tr>
    <tr><td>Delivered</td><td>Scottsdale Hospital</td><td>John Doe #123</td><td>3.8°C</td><td>✅</td></tr>
  </table>
  
  <div style="text-align:center;margin-top:40px;">
    <strong>FDA 21 CFR Part 11 COMPLIANT</strong><br>
    Generated: <%= Time.current.strftime('%Y-%m-%d %H:%M MST') %>
  </div>
</body>
</html>
