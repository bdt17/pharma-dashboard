<!DOCTYPE html>
<html>
<head>
<style>
  /* Keep your existing styles - PERFECT */
</style>
</head>
<body>
  <div class="header">
    <h1>🚚 PHARMA TRANSPORT</h1>
    <h2>CHAIN OF CUSTODY - <%= @batch_id %></h2>
  </div>

  <table>
    <tr><th>Step</th><th>Location</th><th>Driver</th><th>Temp</th><th>Status</th></tr>
    <tr><td>Dispatched</td><td><%= @batch_info[:origin] %></td><td><%= @batch_info[:driver] %></td><td>4.2°C</td><td>✅</td></tr>
    <tr><td>In Transit</td><td>I-10 East</td><td><%= @batch_info[:driver] %></td><td>5.1°C</td><td>🟢</td></tr>
    <tr><td>Delivered</td><td><%= @batch_info[:destination] %></td><td><%= @batch_info[:driver] %></td><td>3.8°C</td><td>✅</td></tr>
  </table>

  <div class="footer">
    <strong>FDA 21 CFR Part 11 COMPLIANT</strong><br>
    Generated: <%= Time.current.strftime('%Y-%m-%d %H:%M MST') %>
  </div>
</body>
</html>
