<!DOCTYPE html>
<html>
<head>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; line-height: 1.6; color: #333; padding: 2rem; }
  .header { text-align: center; margin-bottom: 2rem; color: #1e40af; }
  table { width: 100%; border-collapse: collapse; margin: 2rem 0; }
  th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
  th { background: #1e40af; color: white; font-weight: 600; }
  tr:nth-child(even) { background: #f8fafc; }
  .status { padding: 4px 8px; border-radius: 4px; font-size: 0.9em; font-weight: bold; }
  .delivered { background: #10b981; color: white; }
  .transit { background: #f59e0b; color: white; }
  .footer { margin-top: 3rem; text-align: center; font-size: 0.9rem; color: #666; }
</style>
</head>
<body>
  <div class="header">
    <h1>🚚 PHARMA TRANSPORT</h1>
    <h2>CHAIN OF CUSTODY - B001</h2>
  </div>
  <table>
    <tr><th>Step</th><th>Location</th><th>Driver</th><th>Temp</th><th>Status</th></tr>
    <tr><td>Dispatched</td><td>Pfizer Phoenix AZ</td><td>John Doe #TX-7842</td><td>4.2°C</td><td class="status delivered">✅</td></tr>
    <tr><td>In Transit</td><td>I-10 East</td><td>John Doe #TX-7842</td><td>5.1°C</td><td class="status transit">🟢</td></tr>
    <tr><td>Delivered</td><td>CVS #4721</td><td>John Doe #TX-7842</td><td>3.8°C</td><td class="status delivered">✅</td></tr>
  </table>
  <div class="footer">
    <strong>FDA 21 CFR Part 11 COMPLIANT</strong><br>
    Generated: <%= Time.now.strftime("%Y-%m-%d %H:%M %Z") %>
  </div>
</body>
</html>
