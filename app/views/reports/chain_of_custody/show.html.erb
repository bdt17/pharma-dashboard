<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: 'Courier', 'Courier New', monospace;
      background: #000000;
      color: #FFFFFF;
      padding: 2rem;
      line-height: 1.4;
    }
    .container { max-width: 1000px; margin: 0 auto; }
    .header h1 { 
      color: #0984C0; 
      font-size: 2.2rem; 
      margin-bottom: 0.5rem;
      text-shadow: 0 2px 4px rgba(9,132,192,0.5);
    }
    .header h2 { 
      color: #60BDD1; 
      font-size: 1.4rem; 
      margin-bottom: 2rem;
    }
    table { 
      width: 100%; 
      border-collapse: collapse; 
      margin-bottom: 2rem;
      background: rgba(255,255,255,0.1);
      border: 1px solid #0984C0;
      border-radius: 8px;
      overflow: hidden;
    }
    th, td { 
      padding: 1rem; 
      text-align: left; 
      border-bottom: 1px solid rgba(9,132,192,0.3);
    }
    th { 
      background: rgba(9,132,192,0.2); 
      color: #0984C0; 
      font-weight: bold;
      text-transform: uppercase;
      font-size: 0.9rem;
    }
    .status { 
      font-family: 'Courier', monospace;
      font-size: 1.2rem;
      font-weight: bold;
      text-align: center;
    }
    .footer { 
      background: rgba(9,132,192,0.2); 
      padding: 1.5rem; 
      border-radius: 8px;
      border: 1px solid #0984C0;
      margin-top: 2rem;
      font-family: 'Courier', monospace;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🚚 PHARMA TRANSPORT</h1>
      <h2>CHAIN OF CUSTODY - B001</h2>
    </div>

    <table>
      <tr>
        <th>Step</th><th>Location</th><th>Driver</th><th>Temp</th><th>Status</th>
      </tr>
      <tr>
        <td>Dispatched</td><td>Pfizer Phoenix AZ</td><td>John Doe #TX-7842</td><td>4.2°C</td><td class="status">✅</td>
      </tr>
      <tr>
        <td>In Transit</td><td>I-10 East</td><td>John Doe #TX-7842</td><td>5.1°C</td><td class="status">🟢</td>
      </tr>
      <tr>
        <td>Delivered</td><td>CVS #4721</td><td>John Doe #TX-7842</td><td>3.8°C</td><td class="status">✅</td>
      </tr>
    </table>

    <div class="footer">
      <strong>FDA 21 CFR Part 11 COMPLIANT</strong><br>
      Generated: <%= Time.now.strftime("%Y-%m-%d %H:%M MST") %>
    </div>
  </div>
</body>
</html>
