<% content_for :title, "#{@organization.name} — Chain-of-custody records — Pharma Transport" %>
<% content_for :meta_description, "Chain-of-custody records status for #{@organization.name}, kept with Pharma Transport." %>

<div class="max-w-xl mx-auto text-center flex flex-col items-center gap-6 py-8">
  <% if @organization.verified? %>
    <span class="badge badge-accent text-[13px] px-4 py-2">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
      Custody records active
    </span>
    <h1 class="text-[26px]"><%= @organization.name %></h1>
    <p class="text-ink-soft">
      This organization keeps signed, time-stamped chain-of-custody records for its
      shipments with Pharma Transport, active as of <%= Date.current.strftime("%B %-d, %Y") %>.
    </p>
    <p class="text-[13px] text-ink-faint">
      This page confirms the records service is active. It is not a certification of
      compliance with DSCSA or any other regulation.
    </p>
  <% else %>
    <span class="badge text-[13px] px-4 py-2">Not currently active</span>
    <h1 class="text-[26px]"><%= @organization.name %></h1>
    <p class="text-ink-soft">
      This organization does not currently have an active Pharma Transport subscription.
    </p>
  <% end %>

  <p class="text-sm text-ink-faint">
    <%= link_to "pharmatransport.org", root_path, class: "underline" %>
  </p>
</div>
