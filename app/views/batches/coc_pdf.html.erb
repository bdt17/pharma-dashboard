<h1>CHAIN OF CUSTODY - <%= @batch&.lot_number&.presence || "BATCH-#{@batch.id}" %></h1>

<table border="1" style="width:100%;border-collapse:collapse;">
  <tr style="background:#eee;">
    <th>Time</th>
    <th>Handler</th>
    <th>Location</th>
    <th>Action</th>
    <th>Notes</th>
  </tr>
  
  <% if @batch&.custody_logs&.exists? %>
    <% @batch.custody_logs.each do |log| %>
      <tr>
        <td><%= log.timestamp || Time.now.strftime('%Y-%m-%d %H:%M') %></td>
        <td><%= log.handler_name || 'N/A' %></td>
        <td><%= log.location || '-' %></td>
        <td><%= log.action_type || '-' %></td>
        <td><%= log.condition_notes&.presence || '-' %></td>
      </tr>
    <% end %>
  <% else %>
    <tr><td colspan="5" style="text-align:center;color:#666;">No custody records available</td></tr>
  <% end %>
</table>

<footer style="margin-top:20px;font-size:12px;color:#666;">
  <p>Batch ID: <%= @batch.id %> | Generated: <%= Time.now.strftime('%Y-%m-%d %H:%M:%S %Z') %></p>
  <p>FDA 21 CFR Part 11 Compliant | <%= @batch&.vehicle&.name || 'Vehicle N/A' %></p>
</footer>
