<div class="text-center py-20">
  <h1 class="text-6xl font-bold text-gray-900 mb-8">💉 Pharma Transport</h1>
  <p class="text-xl text-gray-600 mb-12">
    Chain of Custody • Cold Chain • GPS Tracking
  </p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
    <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
      <h3 class="text-2xl font-bold text-blue-600 mb-4">📄 Chain of Custody</h3>
      <p class="text-gray-700 mb-6">FDA 21 CFR Part 11 Certified</p>
      <%= link_to "Download PDF", batches_path(format: :pdf), class: "bg-green-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors w-full block text-center" %>
    </div>

    <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
      <h3 class="text-2xl font-bold text-blue-600 mb-4">🚛 Live Fleet</h3>
      <p class="text-gray-700 mb-6">
        <%= pluralize(Vehicle.where(status: 'online').count, "truck") %> online
      </p>
      <%= link_to "View Vehicles", vehicles_path, class: "bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors w-full block text-center" %>
    </div>

    <div class="bg-white p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow">
      <h3 class="text-2xl font-bold text-blue-600 mb-4">🩺 Health Check</h3>
      <p class="text-gray-700 mb-6">Production Status: LIVE</p>
      <%= link_to "System Health", health_path, class: "bg-emerald-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-emerald-700 transition-colors w-full block text-center" %>
    </div>
  </div>
</div>
