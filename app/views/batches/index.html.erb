<!DOCTYPE html>
<html><head><title>Pharma Batches - Dashboard</title></head>
<body style="margin:0;padding:20px;background:#000;color:#fff;">
  <div style="max-width:1200px;margin:0 auto;">
    <h1 style="color:#0984C0;">📦 Pharma Batches (<%= @batches.length %> Active)</h1>
    <a href="/" style="color:#60BDD1;font-size:18px;">← Main Dashboard</a>
    
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-top:2rem;">
      <% @batches.each do |batch| %>
        <div style="background:#fff;color:#000;padding:2rem;border-radius:12px;box-shadow:0 4px 20px rgba(0,150,255,0.3);">
          <h2 style="color:#0984C0;margin:0 0 1rem 0;">Batch <%= batch[:id] %></h2>
          <p><strong>Status:</strong> <span style="color:#<%= batch[:status] == 'Delivered' ? '00C851' : batch[:status] == 'Pending' ? 'ff9800' : '2196F3' %>"><%= batch[:status] %></span></p>
          <p><strong>Destination:</strong> <%= batch[:destination] %></p>
          <p><strong>ETA:</strong> <%= batch[:eta] %></p>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>
