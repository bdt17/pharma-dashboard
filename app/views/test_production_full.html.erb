<div class="max-w-4xl mx-auto py-12">
  <h1 class="text-4xl font-bold text-gray-900 mb-8">Production Status</h1>
  
  <div class="grid md:grid-cols-2 gap-6 mb-8">
    <div class="p-6 bg-green-50 border border-green-200 rounded-xl">
      <h3 class="text-xl font-bold text-green-800 mb-2">✅ LIVE ENDPOINTS</h3>
      <ul class="space-y-2">
        <%= link_to "Dashboard", dashboard_path, class: "block p-3 bg-white rounded-lg hover:bg-gray-50 border" %>
        <%= link_to "Health Check", health_path, class: "block p-3 bg-white rounded-lg hover:bg-gray-50 border" %>
        <%= link_to "Batches PDF", "/batches/1/chain_of_custody", class: "block p-3 bg-white rounded-lg hover:bg-gray-50 border", target: "_blank" %>
      </ul>
    </div>
    
    <div class="p-6 bg-yellow-50 border border-yellow-200 rounded-xl">
      <h3 class="text-xl font-bold text-yellow-800 mb-2">🔄 GPS + API</h3>
      <ul class="space-y-2">
        <%= link_to "GPS Update", "/gps/update?imei=GV55-001&lat=33.45&lng=-112.07", class: "block p-3 bg-white rounded-lg hover:bg-gray-50 border" %>
        <%= link_to "GPS Stream", "/gps/update/stream", class: "block p-3 bg-white rounded-lg hover:bg-gray-50 border" %>
        <%= link_to "API Health", "/api/health", class: "block p-3 bg-white rounded-lg hover:bg-gray-50 border" %>
      </ul>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    <div class="p-6 bg-blue-50 border border-blue-200 rounded-xl">
      <%= link_to "Fleet", vehicles_path, class: "block w-full bg-blue-600 text-white py-4 px-6 rounded-lg text-center hover:bg-blue-700 font-bold text-lg" %>
    </div>
    <div class="p-6 bg-emerald-50 border border-emerald-200 rounded-xl">
      <%= link_to "Subscribe $99/mo", "/subscribe", class: "block w-full bg-emerald-600 text-white py-4 px-6 rounded-lg text-center hover:bg-emerald-700 font-bold text-lg" %>
    </div>
    <div class="p-6 bg-purple-50 border border-purple-200 rounded-xl">
      <%= link_to "Test PDF", test_pdf_path, class: "block w-full bg-purple-600 text-white py-4 px-6 rounded-lg text-center hover:bg-purple-700 font-bold text-lg", target: "_blank" %>
    </div>
  </div>
</div>
