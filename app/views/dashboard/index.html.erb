    background-clip: text;
    color: transparent;
    text-align: center;
    margin-bottom: 3rem;
    letter-spacing: -0.025em;
  }
  
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  
  .stat {
    background: white;
    padding: 2rem;
    border-radius: 20px;
