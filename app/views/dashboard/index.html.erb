<% content_for :title, "Dashboard — Pharma Transport" %>
<% content_for :crumb, "Dashboard" %>

<div class="p-7 max-w-6xl">
  <div class="flex items-end justify-between mb-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-[24px]">Dashboard</h1>
      <span class="text-[13px] text-ink-faint"><%= current_organization&.name %></span>
    </div>
    <%= link_to compliance_path, class: "btn btn-primary btn-sm" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
      Compliance detail
    <% end %>
  </div>

  <div class="grid grid-cols-2 <%= @overages_this_month.any? ? "md:grid-cols-5" : "md:grid-cols-4" %> gap-4 mb-8">
    <div class="card p-4 flex flex-col gap-0.5">
      <div class="text-[11px] uppercase tracking-wide text-ink-faint">Batches</div>
      <div class="mono text-[26px] font-medium"><%= @batch_count %></div>
      <div class="text-[11px] text-ink-faint"><%= @active_batch_count %> active</div>
    </div>
    <div class="card p-4 flex flex-col gap-0.5 <%= "border-[#f0c8c2] bg-[#fdeceb]" if @non_compliant_batches.any? %>">
      <div class="text-[11px] uppercase tracking-wide <%= @non_compliant_batches.any? ? "text-[#8a2c22]" : "text-ink-faint" %>">Non-compliant batches</div>
      <div class="mono text-[26px] font-medium <%= "text-[#b42318]" if @non_compliant_batches.any? %>"><%= @non_compliant_batches.size %></div>
      <div class="text-[11px] <%= @non_compliant_batches.any? ? "text-[#8a2c22]" : "text-ink-faint" %>">outside 2&ndash;8&deg;C</div>
    </div>
    <div class="card p-4 flex flex-col gap-0.5">
      <div class="text-[11px] uppercase tracking-wide text-ink-faint">Vehicles</div>
      <div class="mono text-[26px] font-medium"><%= @vehicle_count %></div>
      <div class="text-[11px] text-ink-faint"><%= @vehicles_online_count %> pinged in last 15 min</div>
    </div>
    <% if @overages_this_month.any? %>
      <div class="card p-4 flex flex-col gap-0.5">
        <div class="text-[11px] uppercase tracking-wide text-ink-faint">Extra packets this month</div>
        <div class="mono text-[26px] font-medium"><%= @overages_this_month.count %></div>
        <div class="text-[11px] text-ink-faint"><%= number_to_currency(@overages_this_month.sum(:amount_cents) / 100.0) %> next invoice</div>
      </div>
    <% end %>
    <div class="card p-4 flex flex-col gap-1">
      <div class="text-[11px] uppercase tracking-wide text-ink-faint">Fleet view</div>
      <%= link_to "Live positions →", gps_path, class: "text-[13px] font-medium mt-1" %>
    </div>
  </div>

  <% if @ongoing_excursions.any? %>
    <div class="card overflow-hidden mb-8 border-[#f0c8c2]">
      <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold text-[#b42318] flex items-center gap-2">
        Live temperature excursions <span class="badge badge-danger">In progress</span>
      </div>
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2">Lot</th>
            <th class="text-left font-medium px-4 py-2">Vehicle</th>
            <th class="text-left font-medium px-4 py-2">Peak</th>
            <th class="text-left font-medium px-4 py-2">Since</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @ongoing_excursions.each do |excursion| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5 mono"><%= excursion.batch.lot_number %></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= excursion.vehicle&.name || "—" %></td>
              <td class="px-4 py-2.5 mono text-[#b42318] font-semibold"><%= excursion.peak_temp.round(1) %>&deg;C <span class="text-ink-faint font-normal">(<%= excursion.direction %>)</span></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= time_ago_in_words(excursion.started_at) %> ago</td>
              <td class="px-4 py-2.5"><%= link_to "Chain of custody →", batch_custody_logs_path(excursion.batch) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @non_compliant_batches.any? %>
    <div class="card overflow-hidden mb-8 border-[#f0c8c2]">
      <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold text-[#b42318] flex items-center gap-2">
        Temperature excursions <span class="badge badge-danger">Action needed</span>
      </div>
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2">Lot</th>
            <th class="text-left font-medium px-4 py-2">Temperature</th>
            <th class="text-left font-medium px-4 py-2">Status</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @non_compliant_batches.each do |batch| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5 mono"><%= batch.lot_number %></td>
              <td class="px-4 py-2.5 mono text-[#b42318] font-semibold"><%= batch.temperature_celsius %>&deg;C</td>
              <td class="px-4 py-2.5 text-ink-soft"><%= batch.status.presence || "unknown" %></td>
              <td class="px-4 py-2.5"><%= link_to "Chain of custody →", batch_chain_of_custody_pdf_path(batch) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="grid md:grid-cols-2 gap-6">
    <div class="card overflow-hidden">
      <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold">Recent custody events</div>
      <% if @recent_custody_logs.empty? %>
        <p class="px-4 py-4 text-ink-faint text-[13px]">None recorded yet.</p>
      <% else %>
        <ul>
          <% @recent_custody_logs.each do |log| %>
            <li class="px-4 py-2.5 border-t border-line-soft first:border-t-0 text-[13px] flex items-center gap-2.5">
              <span class="badge badge-accent"><%= log.action_type %></span>
              <span class="text-ink-soft">
                <%= link_to log.batch.lot_number, batch_custody_logs_path(log.batch), class: "mono font-medium" %>
                at <%= log.location %>
                <span class="text-ink-faint"><%= log.timestamp.strftime("%Y-%m-%d %H:%M") %></span>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="card overflow-hidden">
      <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold">Recent activity</div>
      <% if @recent_audit_logs.empty? %>
        <p class="px-4 py-4 text-ink-faint text-[13px]">None recorded yet.</p>
      <% else %>
        <ul>
          <% @recent_audit_logs.each do |log| %>
            <li class="px-4 py-2.5 border-t border-line-soft first:border-t-0 text-[13px] text-ink-soft">
              <span class="mono font-medium text-ink"><%= log.event %></span>
              by <%= log.user.email %>
              <span class="text-ink-faint"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</div>
