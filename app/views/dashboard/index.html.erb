    .container { max-width: 1200px; margin: 0 auto; }
    h1 { font-size: 3.5rem; font-weight: 900; background: linear-gradient(135deg, #059669, #1e40af); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-align: center; margin-bottom: 20px; }
    .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin: 40px 0; }
    .card { background: white; padding: 40px; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.1); }
    .metric { font-size: 1.5rem; margin: 20px 0; }
    .big { font-size: 3rem; font-weight: 900; color: #059669; }
    .cta { background: #10b981; color: white; padding: 20px 40px; font-size: 1.5rem; font-weight: 700; text-decoration: none; border-radius: 16px; display: block; text-align: center; margin-top: 30px; box-shadow: 0 20px 40px rgba(16,185,129,0.3); }
    .cta:hover { background: #059669; }
  </style>
</head>
<body>
  <div class="container">
    <h1>💉 Thomas IT Pharma Transport</h1>
    <p style="text-align:center;font-size:1.3rem;color:#64748b;margin-bottom:50px;">Live GPS • FDA Compliance • Phoenix Fleet</p>
    
    <div class="metrics">
      <div class="card">
        <h2 style="font-size:2rem;color:#1e293b;margin-bottom:30px;">📊 Live Metrics</h2>
        <div class="metric"><strong>Vehicles:</strong> <span class="big">25 LIVE</span></div>
        <div class="metric"><strong>Batches:</strong> <span class="big">128 ACTIVE</span></div>
