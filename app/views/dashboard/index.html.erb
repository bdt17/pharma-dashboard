<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'ocean-blue': '#0984C0',
            'metallic-silver': '#AAA7B0', 
            'davys-grey': '#565759',
            'silver-sand': '#C0BEC6',
            'sea-serpent': '#60BDD1'
          }
        }
      }
    }
  </script>
</head>
<body class="bg-white min-h-screen font-sans antialiased">
  
  <!-- Professional Navigation -->
  <nav class="bg-white shadow-sm border-b border-silver-sand/50">
    <div class="max-w-6xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 bg-ocean-blue rounded-xl flex items-center justify-center shadow-md">
            <span class="text-white font-bold text-xl">PT</span>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-davys-grey tracking-tight">Pharma Transport</h1>
            <p class="text-sm text-silver-sand font-medium">Production Dashboard</p>
          </div>
        </div>

        <!-- Clean Nav Links -->
        <div class="flex items-center space-x-1">
          <%= link_to "Health", "/health", class: "px-4 py-2 text-sm font-semibold text-davys-grey hover:text-ocean-blue hover:bg-silver-sand/50 rounded-lg transition-colors duration-200" %>
          <%= link_to "Vehicles", "/vehicles", class: "px-4 py-2 text-sm font-semibold text-davys-grey hover:text-sea-serpent hover:bg-silver-sand/50 rounded-lg transition-colors duration-200" %>
          <%= link_to "Batches", "/batches", class: "px-4 py-2 text-sm font-semibold text-davys-grey hover:text-sea-serpent hover:bg-silver-sand/50 rounded-lg transition-colors duration-200" %>
          <%= link_to "Billing", "/billing", class: "px-4 py-2 text-sm font-semibold text-davys-grey hover:text-sea-serpent hover:bg-silver-sand/50 rounded-lg transition-colors duration-200" %>
          <%= link_to "Compliance", "/compliance", class: "px-4 py-2 text-sm font-semibold text-davys-grey hover:text-sea-serpent hover:bg-silver-sand/50 rounded-lg transition-colors duration-200" %>
          <%= <%= link_to "🚪 Logout", logout_path, "data-method": "delete", class: "..."", logout_path, method: :delete, class: "ml-4 px-5 py-2 bg-ocean-blue text-white text-sm font-semibold rounded-lg hover:bg-opacity-90 shadow-sm transition-all duration-200" %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Metrics -->
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid lg:grid-cols-4 gap-8 mb-12">
      
      <!-- Vehicles Card -->
      <div class="bg-white border border-silver-sand/30 rounded-2xl p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:border-ocean-blue/50">
        <div class="flex items-center mb-6">
          <div class="w-16 h-16 bg-ocean-blue/10 rounded-xl flex items-center justify-center mr-4">
            <span class="text-2xl">🚛</span>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-davys-grey">Live Vehicles</h3>
            <p class="text-sm text-silver-sand">GPS Tracking</p>
          </div>
        </div>
        <div class="text-5xl font-bold text-ocean-blue mb-2"><%= @vehicles_count %></div>
        <%= link_to "View Details →", "/vehicles", class: "text-sea-serpent hover:text-ocean-blue font-semibold text-sm transition-colors" %>
      </div>

      <!-- Batches Card -->
      <div class="bg-white border border-silver-sand/30 rounded-2xl p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:border-sea-serpent/50">
        <div class="flex items-center mb-6">
          <div class="w-16 h-16 bg-sea-serpent/10 rounded-xl flex items-center justify-center mr-4">
            <span class="text-2xl">📦</span>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-davys-grey">FDA Batches</h3>
            <p class="text-sm text-silver-sand">21 CFR Part 11</p>
          </div>
        </div>
        <div class="text-5xl font-bold text-sea-serpent mb-2"><%= @batches_count %></div>
        <%= link_to "Chain of Custody →", "/batches/1/custody_report", class: "text-sea-serpent hover:text-ocean-blue font-semibold text-sm transition-colors" %>
      </div>

      <!-- Billing Card -->
      <div class="bg-white border border-silver-sand/30 rounded-2xl p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:border-purple-400/50">
        <div class="flex items-center mb-6">
          <div class="w-16 h-16 bg-purple-500/10 rounded-xl flex items-center justify-center mr-4">
            <span class="text-2xl">💰</span>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-davys-grey">Monthly Revenue</h3>
            <p class="text-sm text-silver-sand">MRR Trajectory</p>
          </div>
        </div>
        <div class="text-4xl font-bold text-purple-600 mb-2">$12K</div>
        <%= link_to "Billing Portal →", "/billing", class: "text-purple-600 hover:text-purple-700 font-semibold text-sm transition-colors" %>
      </div>

      <!-- Compliance Card -->
      <div class="bg-white border border-silver-sand/30 rounded-2xl p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:border-emerald-400/50">
        <div class="flex items-center mb-6">
          <div class="w-16 h-16 bg-emerald-500/10 rounded-xl flex items-center justify-center mr-4">
            <span class="text-2xl">✅</span>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-davys-grey">Compliance</h3>
            <p class="text-sm text-silver-sand">Audit Status</p>
          </div>
        </div>
        <div class="text-5xl font-bold text-emerald-600 mb-2">100%</div>
        <%= link_to "Audit Report →", "/compliance", class: "text-emerald-600 hover:text-emerald-700 font-semibold text-sm transition-colors" %>
      </div>
    </div>

    <!-- Status Footer -->
    <div class="bg-gradient-to-r from-silver-sand/20 to-white/50 border border-silver-sand/30 rounded-2xl p-8 backdrop-blur-sm">
      <div class="flex items-center justify-between flex-wrap gap-6">
        <div class="flex items-center space-x-6">
          <span class="px-4 py-2 bg-emerald-100 text-emerald-800 font-semibold rounded-xl text-sm">🟢 PRODUCTION LIVE</span>
          <span class="text-lg font-semibold text-davys-grey">Phoenix, AZ</span>
          <span class="text-sm text-silver-sand"><%= Time.current.strftime("%Y-%m-%d %H:%M MST") %></span>
        </div>
        <div class="flex items-center space-x-4 text-sm text-davys-grey">
          <span>FDA 21 CFR Part 11 Compliant</span>
          <span>•</span>
          <span>Audit Trail Active</span>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
