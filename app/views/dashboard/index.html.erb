<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-blue-50 to-emerald-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    
    <!-- PHARMA BRANDING + PHOENIX AZ -->
    <div class="text-center mb-20">
      <h1 class="text-6xl md:text-7xl font-black bg-gradient-to-r from-gray-900 via-blue-900 to-emerald-700 bg-clip-text text-transparent mb-6">
        💉 PHARMA TRANSPORT
      </h1>
      <h2 class="text-3xl md:text-4xl font-semibold text-gray-800 mb-8">
        Thomas Information Technology · <span class="text-blue-600 font-bold">Phoenix, AZ</span>
      </h2>
      
      <!-- MRR DISPLAY + FDA -->
      <div class="inline-flex items-center bg-gradient-to-r from-green-500 to-emerald-600 text-white px-12 py-8 rounded-3xl shadow-3xl mb-12">
        <div class="text-5xl font-black mr-8">$<%= @revenue_projection %></div>
        <div>
          <div class="text-2xl font-bold mb-2">MRR Potential</div>
          <div class="text-xl opacity-90"><%= @vehicles.size %> trucks × $99/mo 
            <span class="ml-4 px-4 py-2 bg-white/30 rounded-2xl text-sm font-bold">✅ FDA 21 CFR Part 11</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA BUTTON -->
    <div class="text-center mb-20">
      <a href="/billing" class="inline-flex items-center bg-gradient-to-r from-blue-600 to-emerald-600 hover:from-blue-700 hover:to-emerald-700 text-white font-black text-2xl px-20 py-10 rounded-3xl shadow-4xl hover:shadow-5xl hover:-translate-y-2 transition-all mx-auto">
        🚀 START TRACKING TODAY $99/mo per vehicle
      </a>
    </div>

    <!-- LIVE FLEET -->
    <div class="bg-white/80 backdrop-blur-xl rounded-4xl p-12 shadow-3xl border border-white/50 mb-16">
      <h3 class="text-4xl font-bold text-gray-900 mb-12 flex items-center justify-center">
        🗺️ Live Phoenix Fleet 
        <span class="ml-8 px-6 py-3 bg-blue-100 text-blue-800 rounded-3xl text-xl font-bold">Sky Harbor Metro</span>
      </h3>
      <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-8">
        <% @vehicles.each do |truck| %>
          <div class="p-8 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-3xl border-2 border-blue-100 hover:border-blue-300 hover:shadow-2xl transition-all hover:-translate-y-2 text-center">
            <div class="text-3xl mb-4">🚛</div>
            <div class="font-bold text-xl text-gray-900 mb-3"><%= truck.name %></div>
            <div class="text-4xl font-black text-blue-600 mb-4"><%= truck.speed.round %> <span class="text-lg">mph</span></div>
            <div class="text-sm text-gray-500 mb-6">Phoenix Metro</div>
            <a href="https://maps.google.com/?q=<%= truck.latitude %>,<%= truck.longitude %>" target="_blank" 
               class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all">
              🗺️ Live Location
            </a>
          </div>
        <% end %>
      </div>
    </div>

    <!-- PRICING -->
    <div class="grid md:grid-cols-3 gap-8 mb-20">
      <div class="bg-white p-10 rounded-4xl shadow-2xl border-4 border-blue-100">
        <div class="text-6xl font-black text-blue-600 mb-8">$99<span class="text-3xl">/mo</span></div>
        <h3 class="text-3xl font-bold mb-8">GPS Basic</h3>
        <ul class="space-y-3 mb-12 text-lg">
          <li>✅ Live GPS Tracking</li>
          <li>✅ Chain-of-Custody PDF</li>
          <li>✅ Live Dashboard</li>
        </ul>
        <a href="/billing" class="w-full block bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-2xl text-center">Get Started</a>
      </div>
      <div class="bg-white p-10 rounded-4xl shadow-2xl border-4 border-emerald-100">
        <div class="text-6xl font-black text-emerald-600 mb-8">$999<span class="text-3xl">/mo</span></div>
        <h3 class="text-3xl font-bold mb-8">Enterprise</h3>
        <ul class="space-y-3 mb-12 text-lg">
          <li>✅ 10+ Trucks</li>
          <li>✅ FDA 21 CFR Part 11</li>
          <li>✅ API Access</li>
        </ul>
        <a href="/billing" class="w-full block bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-8 rounded-2xl text-center">Enterprise</a>
      </div>
      <div class="bg-white p-10 rounded-4xl shadow-2xl border-4 border-purple-100">
        <div class="text-6xl font-black text-purple-600 mb-8">$1,999<span class="text-3xl">/mo</span></div>
        <h3 class="text-3xl font-bold mb-8">Compliance Pro</h3>
        <ul class="space-y-3 mb-12 text-lg">
          <li>✅ Unlimited Trucks</li>
          <li>✅ Full FDA Compliance</li>
          <li>✅ White-label</li>
        </ul>
        <a href="/billing" class="w-full block bg-purple-600 hover:bg-purple-700 text-white font-bold py-4 px-8 rounded-2xl text-center">Enterprise Pro</a>
      </div>
    </div>
  </div>
</div>
