<div class="max-w-7xl mx-auto px-6 py-20">
  <div class="text-center mb-24">
    <div class="inline-flex items-center bg-gradient-to-r from-emerald-500 to-blue-600 px-8 py-4 rounded-3xl shadow-2xl mx-auto mb-8">
      <span class="text-2xl mr-3">🎉</span>
      <span class="text-xl font-semibold text-white">PHASE 10 LIVE - $12K MRR Trajectory</span>
    </div>
    <h1 class="text-7xl font-black text-gray-900 mb-6">Pharma Transport</h1>
    <p class="text-3xl text-slate-600 max-w-3xl mx-auto mb-12">
      FDA 21 CFR Part 11 • Real-time Queclink GV55 GPS • 2-8°C Cold Chain Compliance
    </p>
  </div>

  <div class="grid lg:grid-cols-4 gap-8 mb-20">
    <!-- Live Vehicles -->
    <div class="bg-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all border border-gray-100 group">
      <div class="text-5xl mb-6 group-hover:scale-110 transition-transform duration-300">🚛</div>
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Live Vehicles</h2>
      <div class="text-4xl font-black text-emerald-600 mb-2">1 ACTIVE</div>
      <p class="text-lg text-slate-600">Queclink GV55 #1<br>Phoenix, AZ</p>
    </div>

    <!-- Active Batches -->
    <div class="bg-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all border border-gray-100 group">
      <div class="text-5xl mb-6 group-hover:scale-110 transition-transform duration-300">💉</div>
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Active Batches</h2>
      <div class="text-4xl font-black text-blue-600 mb-2">5 DELIVERED</div>
      <p class="text-lg text-slate-600">LOT-PHARMA-20260217</p>
      <%= link_to batch_coc_pdf_path(1), class: "mt-4 inline-block text-blue-600 hover:text-blue-800 font-semibold text-sm", target: "_blank" do %>
        📄 CoC PDF
      <% end %>
    </div>

    <!-- Cold Chain -->
    <div class="bg-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all border border-gray-100 group">
      <div class="text-5xl mb-6 group-hover:scale-110 transition-transform duration-300">🌡️</div>
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Cold Chain</h2>
      <div class="text-4xl font-black text-emerald-600 mb-2">4.2°C ✓</div>
      <p class="text-lg text-slate-600">2-8°C Compliant</p>
    </div>

    <!-- Subscription -->
    <div class="bg-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all border border-gray-100 group">
      <div class="text-5xl mb-6 group-hover:scale-110 transition-transform duration-300">💰</div>
      <h2 class="text-3xl font-bold text-gray-900 mb-4">$99/mo</h2>
      <div class="text-2xl font-semibold text-emerald-600 mb-6">Pharmacy Pro</div>
      <%= link_to "/subscribe", class: "w-full block bg-gradient-to-r from-emerald-500 to-blue-600 text-white py-6 px-8 rounded-2xl font-bold text-lg shadow-xl hover:shadow-2xl hover:from-emerald-600 hover:to-blue-700 transition-all duration-300 text-center" do %>
        Upgrade Now
      <% end %>
    </div>
  </div>

  <!-- Action Cards -->
  <div class="grid md:grid-cols-3 gap-8">
    <%= link_to batch_coc_pdf_path(1), class: "group p-8 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-3xl border-2 border-blue-100 hover:border-blue-200 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300", target: "_blank" do %>
      <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-all duration-300">
        <span class="text-3xl">📄</span>
      </div>
      <h3 class="text-2xl font-bold text-gray-900 mb-3 text-center">Chain of Custody</h3>
      <p class="text-blue-600 font-semibold text-lg text-center">Download PDF Report</p>
    <% end %>

    <%= link_to vehicles_path, class: "group p-8 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-3xl border-2 border-emerald-100 hover:border-emerald-200 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300" do %>
      <div class="w-20 h-20 bg-gradient-to-r from-emerald-500 to-teal-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-all duration-300">
        <span class="text-3xl">🚚</span>
      </div>
      <h3 class="text-2xl font-bold text-gray-900 mb-3 text-center">Fleet Tracking</h3>
      <p class="text-emerald-600 font-semibold text-lg text-center">View 4 Vehicles</p>
    <% end %>

    <%= link_to health_path, class: "group p-8 bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl border-2 border-purple-100 hover:border-purple-200 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300", target: "_blank" do %>
      <div class="w-20 h-20 bg-gradient-to-r from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-all duration-300">
        <span class="text-3xl">🩺</span>
      </div>
      <h3 class="text-2xl font-bold text-gray-900 mb-3 text-center">Health Check</h3>
      <p class="text-purple-600 font-semibold text-lg text-center">Production Status</p>
    <% end %>
  </div>
</div>
