<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-slate-50 to-blue-50 min-h-screen">
  
  <!-- Navigation -->
  <nav class="bg-white/80 backdrop-blur-xl shadow-lg border-b border-blue-100 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <div class="w-12 h-12 bg-gradient-to-r from-blue-600 to-teal-500 rounded-2xl flex items-center justify-center shadow-lg">
            <span class="text-2xl">🚛</span>
          </div>
          <h1 class="text-2xl font-black text-gray-900">Pharma Transport Dashboard</h1>
        </div>
        
        <div class="flex items-center space-x-3">
          <%= link_to "🩺 Health", "/health", class: "px-4 py-2 bg-emerald-100 text-emerald-800 font-semibold rounded-xl hover:bg-emerald-200 transition-all" %>
          <%= link_to "🚛 Vehicles", "/vehicles", class: "px-4 py-2 bg-blue-100 text-blue-800 font-semibold rounded-xl hover:bg-blue-200 transition-all" %>
          <%= link_to "📦 Batches", "/batches", class: "px-4 py-2 bg-green-100 text-green-800 font-semibold rounded-xl hover:bg-green-200 transition-all" %>
          <%= link_to "💰 Billing", "/billing", class: "px-4 py-2 bg-purple-100 text-purple-800 font-semibold rounded-xl hover:bg-purple-200 transition-all" %>
          <%= link_to "📋 Compliance", "/compliance", class: "px-4 py-2 bg-orange-100 text-orange-800 font-semibold rounded-xl hover:bg-orange-200 transition-all" %>
          <%= button_to "🚪 Logout", logout_path, method: :delete, class: "px-6 py-2 bg-red-500 text-white font-bold rounded-xl hover:bg-red-600 shadow-lg transition-all ml-2" %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-6 py-12">
    <div class="grid lg:grid-cols-4 gap-8 mb-12">
      <!-- Vehicles Card -->
      <div class="bg-gradient-to-br from-blue-500 to-blue-700 text-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="text-6xl mb-6 group-hover:scale-110 transition-transform">🚛</div>
        <h2 class="text-3xl font-black mb-6">Live Vehicles</h2>
        <div class="text-7xl font-black mb-6"><%= @vehicles_count %></div>
        <p class="text-xl opacity-90">GPS Tracking Active</p>
        <%= link_to "View Live →", "/vehicles", class: "inline-flex items-center mt-4 text-lg font-semibold hover:underline" %>
      </div>

      <!-- Batches Card -->
      <div class="bg-gradient-to-br from-emerald-500 to-teal-600 text-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="text-6xl mb-6 group-hover:scale-110 transition-transform">📦</div>
        <h2 class="text-3xl font-black mb-6">FDA Batches</h2>
        <div class="text-7xl font-black mb-6"><%= @batches_count %></div>
        <p class="text-xl opacity-90">21 CFR Part 11</p>
        <%= link_to "Chain of Custody →", "/batches/1/custody_report", class: "inline-flex items-center mt-4 text-lg font-semibold hover:underline" %>
      </div>

      <!-- Billing Card -->
      <div class="bg-gradient-to-br from-purple-500 to-indigo-600 text-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="text-6xl mb-6 group-hover:scale-110 transition-transform">💰</div>
        <h2 class="text-3xl font-black mb-6">Billing</h2>
        <div class="text-5xl font-black mb-6">$12K MRR</div>
        <p class="text-xl opacity-90">47 Active Clients</p>
        <%= link_to "View Billing →", "/billing", class: "inline-flex items-center mt-4 text-lg font-semibold hover:underline" %>
      </div>

      <!-- Compliance Card -->
      <div class="bg-gradient-to-br from-orange-500 to-red-500 text-white p-10 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="text-6xl mb-6 group-hover:scale-110 transition-transform">✅</div>
        <h2 class="text-3xl font-black mb-6">Compliance</h2>
        <div class="text-7xl font-black mb-6">100%</div>
        <p class="text-xl opacity-90">Audit Ready</p>
        <%= link_to "View Report →", "/compliance", class: "inline-flex items-center mt-4 text-lg font-semibold hover:underline" %>
      </div>
    </div>

    <!-- Status Bar -->
    <div class="bg-white/80 backdrop-blur-xl p-8 rounded-3xl shadow-2xl border border-blue-200">
      <div class="flex flex-wrap items-center justify-center gap-8 text-center">
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-emerald-600">🟢 LIVE</span>
          <span class="text-lg font-semibold text-gray-700">Production</span>
        </div>
        <div class="w-px h-12 bg-gray-300"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-blue-600">Phoenix, AZ</span>
          <span class="text-lg font-semibold text-gray-700"><%= Time.current.strftime("%Y-%m-%d %H:%M MST") %></span>
        </div>
        <div class="w-px h-12 bg-gray-300"></div>
        <div class="flex flex-col items-center">
          <span class="text-3xl font-black text-purple-600">$12K MRR</span>
          <span class="text-lg font-semibold text-gray-700">Trajectory</span>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
