<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Pharma Transport Dashboard</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-medium text-gray-900">Active Batches</h3>
      <p class="mt-1 text-3xl font-semibold text-green-600"><%= @total_batches %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-medium text-gray-900">Online Vehicles</h3>
      <p class="mt-1 text-3xl font-semibold text-blue-600"><%= @online_vehicles %></p>
    </div>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Recent Batches</h3>
    </div>
    <div class="px-4 py-6 sm:px-0">
      <% if @batches.any? %>
        <ul>
          <% @batches.each do |batch| %>
            <li class="py-4 px-4 border-b last:border-b-0">
              <div class="flex justify-between items-center">
                <span>LOT: <%= batch.lot_number %></span>
                <span><%= batch.temperature_celsius %>°C</span>
                <span><%= link_to "PDF", batch_path(batch.id, format: :pdf), class: "text-blue-600 hover:text-blue-500" %></span>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500 text-center py-8">No batches yet</p>
      <% end %>
    </div>
  </div>
</div>
