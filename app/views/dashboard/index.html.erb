<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">💉 PHARMA TRANSPORT</h1>
      <p class="text-xl text-gray-600 mb-8">Thomas Information Technology · Phoenix AZ</p>
    </div>

    <!-- LIVE METRICS -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white p-6 rounded-xl shadow-lg">
        <h3 class="text-lg font-semibold text-gray-900">🚛 Live Vehicles</h3>
        <div class="text-3xl font-bold text-blue-600"><%= Vehicle.count %></div>
      </div>
      <div class="bg-white p-6 rounded-xl shadow-lg">
        <h3 class="text-lg font-semibold text-gray-900">💉 Active Batches</h3>
        <div class="text-3xl font-bold text-green-600"><%= Batch.count %></div>
      </div>
      <div class="bg-white p-6 rounded-xl shadow-lg">
        <h3 class="text-lg font-semibold text-gray-900">💰 Monthly Revenue</h3>
        <div class="text-3xl font-bold text-purple-600">$<%= (Vehicle.count * 99).to_s(:delimited) %>K MRR</div>
      </div>
      <div class="bg-white p-6 rounded-xl shadow-lg border-2 border-green-200">
        <h3 class="text-lg font-semibold text-gray-900">🛡️ FDA Compliance</h3>
        <div class="text-xl font-bold text-green-600">21 CFR Part 11 ✓</div>
      </div>
    </div>

    <!-- LIVE GPS MAP -->
    <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">🗺️ LIVE VEHICLE TRACKING</h2>
      <div id="pharma-map" class="w-full h-96 bg-gray-200 rounded-lg"></div>
    </div>

    <!-- STRIPE CHECKOUT -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-8 rounded-xl shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div>
          <div class="text-3xl font-bold mb-2">$99/mo</div>
          <div class="text-blue-100">Per Vehicle</div>
        </div>
        <div class="border-l border-white/20"></div>
        <div>
          <div class="text-3xl font-bold mb-2">$499/mo</div>
          <div class="text-blue-100">Enterprise</div>
        </div>
        <div class="border-l border-white/20"></div>
        <a href="/stripe/checkout" class="bg-white text-blue-600 px-8 py-4 rounded-lg font-bold text-lg hover:shadow-xl transform hover:-translate-y-1 transition-all">
          🚀 START TRACKING NOW
        </a>
      </div>
    </div>
  </div>
</div>

<script async defer src="https://maps.googleapis.com/maps/api/js?key=&callback=initPharmaMap&loading=async"></script>
<script>
function initPharmaMap() {
  const map = new google.maps.Map(document.getElementById("pharma-map"), {
    zoom: 11,
    center: { lat: 33.4484, lng: -112.0740 }, // Phoenix
    mapTypeId: 'roadmap'
  });

  // PHX-001 LIVE TRUCK (your Queclink GV55 device)
  new google.maps.Marker({
    position: { lat: 33.4484, lng: -112.0740 },
    map: map,
    title: "PHX-001 (GV55-001)",
    icon: {
      url: "data:image/svg+xml;base64,",
      scaledSize: new google.maps.Size(40, 40)
    }
  });
}
</script>
