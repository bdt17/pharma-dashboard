<!-- REPLACE MAP PLACEHOLDER WITH LIVE GOOGLE MAPS -->
<div class="bg-white p-8 rounded-2xl shadow-xl mb-8">
  <h2 class="text-2xl font-bold text-gray-900 mb-4">🗺️ LIVE GPS TRACKING</h2>
  <div id="pharma-map" class="w-full h-96 bg-gray-300 rounded-xl"></div>
</div>

<script async defer 
  src="https://maps.googleapis.com/maps/api/js?key=GOOGLE_MAPS_API_KEY&callback=initPharmaMap">
</script>
<script>
function initPharmaMap() {
  const map = new google.maps.Map(document.getElementById("pharma-map"), {
    zoom: 11,
    center: { lat: 33.4484, lng: -112.0740 }, // Phoenix Sky Harbor
    mapTypeId: 'roadmap'
  });

  // PHX-001 LIVE TRUCK MARKER (Queclink GV55)
  new google.maps.Marker({
    position: { lat: 33.4484, lng: -112.0740 },
    map: map,
    title: "🚛 PHX-001 (GV55-001)",
    icon: "data:image/svg+xml;base64,"
  });
}
</script>
