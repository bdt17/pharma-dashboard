<!DOCTYPE html>
<html style="ALL: initial !important; background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important; margin: 0 !important; padding: 0 !important;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pharma Transport Dashboard</title>
  <style>
    *, *::before, *::after { 
      all: revert !important; 
      box-sizing: border-box !important; 
      margin: 0 !important; 
      padding: 0 !important; 
    }
    html, body { 
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 60%, #1E1B4B 100%) !important;
      color: #FFFFFF !important;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
      min-height: 100vh !important;
      line-height: 1.6 !important;
      overflow-x: hidden !important;
    }
    
    /* SCALED PERFECTLY */
    .glass {
      background: rgba(255,255,255,0.08) !important;
      backdrop-filter: blur(20px) !important;
      border: 1px solid rgba(9,132,192,0.3) !important;
      border-radius: 20px !important;
      transition: all 0.3s ease !important;
      padding: 2.5rem !important;
    }
    .glass:hover { 
      transform: translateY(-8px) !important; 
      box-shadow: 0 25px 50px rgba(0,0,0,0.4), 0 0 25px rgba(9,132,192,0.4) !important;
    }
    
    .pharma-logo {
      color: #0984C0 !important;
      font-weight: 900 !important;
      text-shadow: 0 0 20px rgba(9,132,192,0.8) !important;
      font-size: clamp(2.2rem, 5vw, 3rem) !important;
    }
    
    .metric-icon { font-size: clamp(3rem, 8vw, 4.5rem) !important; margin-bottom: 1rem !important; }
    .metric-number { 
      font-size: clamp(3.5rem, 10vw, 5rem) !important; 
      font-weight: 900 !important; 
      text-shadow: 0 0 25px currentColor !important;
    }
    .metric-label { 
      color: #C0BEC6 !important; 
      font-size: clamp(0.9rem, 2.5vw, 1.2rem) !important; 
      font-weight: 500 !important; 
      text-transform: uppercase; 
      letter-spacing: 1px !important;
      margin-bottom: 0.75rem !important;
    }
    .metric-subtext { 
      color: #AAA7B0 !important; 
      font-size: clamp(0.85rem, 2vw, 1rem) !important;
    }
  </style>
</head>
<body>
  <div style="padding: 2rem; max-width: 1400px; margin: 0 auto;">
    
    <!-- HEADER -->
    <div class="glass" style="margin-bottom: 3rem; background: rgba(9,132,192,0.95) !important; border: 2px solid #0984C0 !important; padding: 2.5rem !important;">
      <div style="display: flex; flex-direction: column; gap: 1.5rem; align-items: center; text-align: center;">
        <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; justify-content: center;">
          <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #0984C0, #60BDD1) !important; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; box-shadow: 0 15px 30px rgba(9,132,192,0.6) !important;">
            💉
          </div>
          <div>
            <h1 class="pharma-logo" style="margin: 0 !important; font-size: clamp(2.2rem, 5vw, 3rem) !important;">Pharma Transport</h1>
            <p style="color: #C0BEC6 !important; font-size: clamp(1rem, 2.5vw, 1.2rem) !important; margin: 0.25rem 0 0 !important;">Phase 14 LIVE • 24 GPS Vehicles • 127 Batches</p>
          </div>
        </div>
        <a href="https://www.pharmatransport.org/" style="background: linear-gradient(135deg, #0984C0, #60BDD1) !important; color: #FFFFFF !important; padding: 1rem 2.5rem; border-radius: 16px; font-weight: 800; font-size: clamp(1rem, 2.5vw, 1.1rem) !important; box-shadow: 0 15px 30px rgba(9,132,192,0.6) !important; align-self: center;">
          🛠️ Production Platform
        </a>
      </div>
    </div>

    <!-- PERFECTLY SCALED METRICS -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
      
      <!-- LIVE VEHICLES -->
      <div class="glass" style="border-color: rgba(96,189,209,0.5) !important; text-align: center;">
        <div class="metric-icon" style="color: #60BDD1 !important;">🚛</div>
        <h3 class="metric-label">Live Vehicles</h3>
        <div class="metric-number" style="color: #60BDD1 !important;">24</div>
        <p class="metric-subtext">GPS Tracked • Real-time</p>
      </div>

      <!-- REVENUE -->
      <div class="glass" style="background: rgba(255,215,0,0.15) !important; border: 2px solid #FFD700 !important; text-align: center;">
        <div class="metric-icon">💰</div>
        <h3 class="metric-label">Monthly Revenue</h3>
        <div class="metric-number" style="color: #FFD700 !important;">$12K</div>
        <p class="metric-subtext">Phase 14 Growth +18%</p>
      </div>

      <!-- BATCHES -->
      <div class="glass" style="border-color: rgba(9,132,192,0.5) !important; text-align: center;">
        <div class="metric-icon">📦</div>
        <h3 class="metric-label">Active Batches</h3>
        <div class="metric-number" style="color: #0984C0 !important;">127</div>
        <p class="metric-subtext">FDA Compliant • Temp Controlled</p>
      </div>
    </div>

    <!-- PERFECT FOOTER -->
    <div class="glass" style="margin-top: 3rem; text-align: center; padding: 2rem !important;">
      <div style="display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap;">
        <span style="color: #C0BEC6 !important; font-size: clamp(0.95rem, 2.2vw, 1.1rem) !important;">⚙️ Solid Stack Rails 8.1</span>
        <span style="color: #60BDD1 !important; font-weight: 600;">🔒 FDA Compliant</span>
        <span style="color: #0984C0 !important; font-weight: 600;">📡 24/7 GPS Tracking</span>
        <span style="color: #FFD700 !important; font-weight: 600;">🤖 AI Anomaly Detection</span>
      </div>
    </div>
  </div>
</body>
</html>
