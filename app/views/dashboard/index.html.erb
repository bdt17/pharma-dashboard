<!DOCTYPE html>
<html>
<head>
  <title>Pharma Transport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:20px;background:#0f0f23;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto;">
  <div style="max-width:1200px;margin:0 auto;">
    <h1 style="color:#1e40af;font-size:2.5rem;margin-bottom:1rem;">Pharma Transport</h1>

    <div style="display:flex;justify-content:space-between;font-size:1.3rem;font-weight:600;margin:2rem 0;padding:1rem;background:rgba(30,64,175,0.1);border-radius:12px;">
      <div style="text-align:center;">
        <div style="font-size:2.5rem;color:#3b82f6;"><%= @batches %></div>
        <div>Active Batches</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:2.5rem;color:#10b981;"><%= @vehicles %></div>
        <div>Live Vehicles</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:2.5rem;color:#f59e0b;"><%= @revenue %></div>
        <div>Monthly Revenue</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin:3rem 0;">
      <div>
        <h3 style="color:#6b7280;margin-bottom:1rem;font-size:1.2rem;">🚛 Vehicle Fleet</h3>
        <div style="background:white;padding:1.5rem;border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,0.1);">
          <% @fleet.each do |vehicle| %>
            <div style="margin-bottom:0.75rem;padding:0.75rem;border-left:4px solid #3b82f6;">
              <%= vehicle %>
            </div>
          <% end %>
        </div>
      </div>

      <div>
        <h3 style="color:#6b7280;margin-bottom:1rem;font-size:1.2rem;">📦 Top Routes</h3>
        <div style="background:white;padding:1.5rem;border-radius:12px;box-shadow:0 4px 6px rgba(0,0,0,0.1);">
          <% @routes.each do |route| %>
            <div style="margin-bottom:0.75rem;">
              <span style="font-weight:600;"><%= route %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div style="text-align:center;margin-top:3rem;">
      <a href="/batches" style="background:linear-gradient(135deg,#1e40af,#3b82f6);color:white;padding:1.25rem 3rem;border:none;border-radius:12px;text-decoration:none;font-size:1.1rem;font-weight:600;box-shadow:0 4px 14px rgba(30,64,175,0.4);display:inline-block;">View All Batches</a>
    </div>

    <div style="text-align:center;margin-top:3rem;color:#6b7280;font-size:0.9rem;">
      Phase 14 LIVE • 24 GPS Vehicles • 127 Batches • FDA Compliant
    </div>
  </div>
</body>
</html>
