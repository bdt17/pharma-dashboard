<div class="text-center">
  <h1 class="text-4xl font-bold text-gray-900 mb-8">Pharma Transport</h1>
  
  <div class="grid md:grid-cols-3 gap-8 mb-12">
    <!-- Chain of Custody Card -->
    <div class="p-8 bg-white border rounded-xl shadow-sm hover:shadow-md transition-all">
      <div class="text-4xl mb-4">📄</div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">Chain of Custody</h3>
      <p class="text-sm text-gray-600 mb-4">FDA 21 CFR Part 11</p>
      <%= link_to "Download PDF", batch_coc_pdf_path(1), class: "w-full block bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700", target: "_blank" %>
    </div>

    <!-- Fleet Card -->
    <div class="p-8 bg-white border rounded-xl shadow-sm hover:shadow-md transition-all">
      <div class="text-4xl mb-4">🚛</div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">Fleet</h3>
      <p class="text-sm text-gray-600 mb-4">4 Vehicles</p>
      <%= link_to "View Fleet", vehicles_path, class: "w-full block bg-emerald-600 text-white py-2 px-4 rounded-lg hover:bg-emerald-700" %>
    </div>

    <!-- Health Card -->
    <div class="p-8 bg-white border rounded-xl shadow-sm hover:shadow-md transition-all">
      <div class="text-4xl mb-4">🩺</div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">Health Check</h3>
      <p class="text-sm text-gray-600 mb-4">Production Status</p>
      <%= link_to "Status", health_path, class: "w-full block bg-purple-600 text-white py-2 px-4 rounded-lg hover:bg-purple-700", target: "_blank" %>
    </div>
  </div>
</div>
