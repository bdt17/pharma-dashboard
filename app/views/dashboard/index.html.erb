    <a href="mailto:sales@thomasinformationtechnology.com" style="display:inline-block;background:linear-gradient(45deg,#0984C0,#60BDD1);color:white;padding:22px 45px;border-radius:50px;font-size:1.25rem;font-weight:bold;text-decoration:none;box-shadow:0 12px 35px rgba(9,132,192,0.5);border:none;">
