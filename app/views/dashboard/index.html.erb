<div style="text-align: center; margin-bottom: 3rem;">
  <h1 style="color: #0984C0 !important; font-size: 3rem; font-weight: 900; margin-bottom: 1rem;">
    Pharma Transport Dashboard
  </h1>
  <p style="color: #565759 !important; font-size: 1.3rem; margin: 0;">
    Phase 14 - GPS Tracking & FDA Compliance
  </p>
</div>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">Live Vehicles</div>
    <div class="metric-number">24</div>
    <div style="color: #AAA7B0; font-size: 0.95rem;">Phoenix Metro Area</div>
  </div>
  
  <div class="metric-card">
    <div class="metric-label">Active Batches</div>
    <div class="metric-number">127</div>
    <div style="color: #AAA7B0; font-size: 0.95rem;">2-8°C Maintained</div>
  </div>
  
  <div class="metric-card">
    <div class="metric-label">Active Alerts</div>
    <div class="metric-number">3</div>
    <div style="color: #AAA7B0; font-size: 0.95rem;">Temperature Deviations</div>
  </div>
  
  <div class="metric-card">
    <div class="metric-label">Monthly Revenue</div>
    <div class="metric-number">$12K</div>
    <div style="color: #AAA7B0; font-size: 0.95rem;">January 2026</div>
  </div>
</div>

<div style="text-align: center; margin-top: 3rem;">
  <%= link_to "View All Vehicles", vehicles_path, class: "btn" %>
</div>
