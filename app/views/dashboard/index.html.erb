<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-8">
  <h1 class="text-4xl font-bold text-gray-900 mb-8">🩺 Pharma Transport Dashboard</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl shadow-lg">
      <h2 class="text-2xl font-semibold text-gray-800">🚛 Vehicles</h2>
      <p class="text-3xl font-bold text-blue-600"><%= @vehicles&.count || 0 %></p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-lg">
      <h2 class="text-2xl font-semibold text-gray-800">💉 Batches</h2>
      <p class="text-3xl font-bold text-green-600"><%= @batches %></p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-lg">
      <h2 class="text-2xl font-semibold text-gray-800">🟢 Status</h2>
      <p class="text-xl font-bold text-green-600">LIVE</p>
      <%= link_to "Health Check", "/health", class: "mt-2 inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
    </div>
  </div>
</div>
