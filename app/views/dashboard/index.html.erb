<!DOCTYPE html>
<html style="ALL: initial !important; background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important; margin: 0 !important; padding: 0 !important;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pharma Transport Dashboard</title>
  <style>
    *, *::before, *::after {
      all: revert !important;
      box-sizing: border-box !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    html, body {
      background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%) !important;
      color: #FFFFFF !important;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
      min-height: 100vh !important;
    }
    a { color: #60BDD1 !important; text-decoration: none !important; }
    .glass {
      background: rgba(255,255,255,0.06) !important;
      backdrop-filter: blur(25px) !important;
      border: 1px solid rgba(9,132,192,0.3) !important;
      border-radius: 24px !important;
    }
    .glow { box-shadow: 0 25px 50px rgba(0,0,0,0.3), 0 0 30px rgba(9,132,192,0.4) !important; }
    .metric-glow { text-shadow: 0 0 30px rgba(96,189,209,0.8) !important; }
  </style>
</head>
<body>
  <div style="padding: 2rem; max-width: 1200px; margin: 0 auto;">
    
    <!-- HEADER - EXACT COPY -->
    <div class="glass glow" style="padding: 2rem; margin-bottom: 3rem; background: rgba(9,132,192,0.95) !important; border: 2px solid #0984C0 !important;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 1.5rem;">
          <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #0984C0, #60BDD1) !important; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; box-shadow: 0 20px 40px rgba(9,132,192,0.6) !important;">
            💉
          </div>
          <div>
            <h1 style="font-size: 2.5rem; font-weight: 900; color: #FFFFFF !important; margin: 0;">🚛 Pharma Transport Dashboard</h1>
            <p style="color: #C0BEC6 !important; font-size: 1.1rem; margin: 0.25rem 0 0;">Phase 14 LIVE - GPS + AI + Marketplace</p>
          </div>
        </div>
        <a href="https://www.pharmatransport.org/" style="background: linear-gradient(90deg, #0984C0, #60BDD1) !important; color: #FFFFFF !important; padding: 1rem 2.5rem; border-radius: 16px; font-weight: 800; font-size: 1.1rem; box-shadow: 0 15px 35px rgba(9,132,192,0.6) !important;">
          🛠️ Production Platform
        </a>
      </div>
    </div>

    <!-- 4 METRICS - YOUR EXACT CONTENT -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
      
      <!-- LIVE VEHICLES -->
      <div class="glass glow" style="padding: 3rem 2rem; text-align: center; border-color: rgba(96,189,209,0.5) !important;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem; color: #60BDD1 !important;">🚛</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1rem; font-weight: 500; text-transform: uppercase;">Live Vehicles</h3>
        <div style="font-size: 4rem; font-weight: 900; color: #60BDD1 !important; metric-glow;">24</div>
      </div>

      <!-- ACTIVE BATCHES -->
      <div class="glass glow" style="padding: 3rem 2rem; text-align: center; border-color: rgba(9,132,192,0.5) !important;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem;">📦</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1rem; font-weight: 500; text-transform: uppercase;">Active Batches</h3>
        <div style="font-size: 4rem; font-weight: 900; color: #0984C0 !important; metric-glow;">127</div>
      </div>

      <!-- ALERTS -->
      <div class="glass glow" style="padding: 3rem 2rem; text-align: center; background: rgba(255,193,7,0.1) !important; border: 2px solid rgba(255,193,7,0.4) !important;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem;">🚨</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1rem; font-weight: 500; text-transform: uppercase;">Alerts</h3>
        <div style="font-size: 4rem; font-weight: 900; color: #FFD700 !important; metric-glow;">3</div>
      </div>

      <!-- REVENUE -->
      <div class="glass glow" style="padding: 3rem 2rem; text-align: center; background: rgba(255,215,0,0.15) !important; border: 2px solid #FFD700 !important;">
        <div style="font-size: 4.5rem; margin-bottom: 1rem;">💰</div>
        <h3 style="color: #C0BEC6 !important; font-size: 1.3rem; margin-bottom: 1rem; font-weight: 500; text-transform: uppercase;">Revenue</h3>
        <div style="font-size: 4rem; font-weight: 900; color: #FFD700 !important; metric-glow;">$12K</div>
      </div>
    </div>

    <!-- STATUS FOOTER -->
    <div class="glass" style="text-align: center; padding: 2rem; margin-top: 3rem;">
      <p style="color: #C0BEC6 !important; font-size: 1.1rem; margin: 0;">
        🛰️ Rails 8.1 Solid Stack • 🔒 FDA Compliant • 📡 GPS Tracking • 🤖 AI Analytics
      </p>
    </div>
  </div>
</body>
</html>

