<div class="min-h-screen">
  <!-- HEADER - Fixed Top Nav -->
  <header class="bg-white shadow-lg border-b border-light-variant/50 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <div class="flex items-center space-x-4">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-blue to-lighter-blue rounded-2xl flex items-center justify-center shadow-xl">
            <svg class="w-9 h-9 text-white drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 6a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-mid-grey tracking-tight">Pharma Transport</h1>
            <p class="text-sm text-accent-silver font-medium">ENTERPRISE v16.1</p>
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex items-center space-x-1">
          <%= link_to "Vehicles", "/vehicles", class: "px-5 py-2.5 bg-primary-blue/10 hover:bg-primary-blue/20 text-primary-blue border border-primary-blue/30 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center space-x-2 group hover:shadow-md" %>
          <%= link_to "Batches", "/batches", class: "px-5 py-2.5 bg-white hover:bg-light-variant text-mid-grey border border-light-variant/50 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center space-x-2 group hover:shadow-md" %>
          <%= link_to "Compliance", "/compliance", class: "px-5 py-2.5 bg-white hover:bg-light-variant text-mid-grey border border-light-variant/50 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center space-x-2 group hover:shadow-md" %>
          <%= link_to "Billing", "/billing", class: "px-5 py-2.5 bg-white hover:bg-light-variant text-mid-grey border border-light-variant/50 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center space-x-2 group hover:shadow-md" %>
          <%= link_to "Health", "/health", class: "px-5 py-2.5 bg-white hover:bg-light-variant text-mid-grey border border-light-variant/50 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center space-x-2 group hover:shadow-md" %>
          <%= link_to "Admin", "/login", class: "px-5 py-2.5 bg-gradient-to-r from-primary-blue to-lighter-blue text-white border-0 rounded-xl font-semibold text-sm shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-200 ml-2" %>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 py-12">
    <!-- KPI CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      <!-- Vehicles Card -->
      <div class="group bg-white border border-light-variant/30 rounded-3xl p-8 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 hover:border-primary-blue/50">
        <div class="flex items-center justify-between mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-blue/10 to-lighter-blue/10 border-2 border-primary-blue/20 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-primary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
        </div>
        <div class="text-4xl font-bold text-mid-grey mb-2 group-hover:text-primary-blue transition-colors"><%= @vehicles_count %></div>
        <div class="text-lg font-semibold text-accent-silver mb-1">Active Vehicles</div>
        <p class="text-primary-blue font-medium text-sm">GPS Tracking LIVE</p>
      </div>

      <!-- Batches Card -->
      <div class="group bg-white border border-light-variant/30 rounded-3xl p-8 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 hover:border-primary-blue/50">
        <div class="flex items-center justify-between mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 border-2 border-indigo-500/20 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
          </div>
          <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
        </div>
        <div class="text-4xl font-bold text-mid-grey mb-2 group-hover:text-indigo-600 transition-colors"><%= @batches_count %></div>
        <div class="text-lg font-semibold text-accent-silver mb-1">Pharma Batches</div>
        <p class="text-indigo-600 font-medium text-sm">FDA 21 CFR Part 11</p>
      </div>

      <!-- Revenue Card -->
      <div class="group bg-gradient-to-br from-emerald-500/5 to-emerald-600/5 border border-emerald-200/30 rounded-3xl p-8 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 md:col-span-2">
        <div class="flex items-center justify-between mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500/20 to-emerald-600/20 border-2 border-emerald-300/50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
            </svg>
          </div>
          <div class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></div>
        </div>
        <div class="text-4xl font-bold bg-gradient-to-r from-emerald-600 to-emerald-700 bg-clip-text text-transparent mb-2">$47K</div>
        <div class="text-xl font-semibold text-accent-silver mb-1">Monthly Recurring Revenue</div>
        <p class="text-emerald-600 font-semibold text-lg">Phase 14 ARR Trajectory</p>
      </div>

      <!-- Uptime Card -->
      <div class="group bg-white border border-light-variant/30 rounded-3xl p-8 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 hover:border-primary-blue/50">
        <div class="flex items-center justify-between mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-green-500/10 to-green-600/10 border-2 border-green-300/30 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">
            <div class="w-6 h-6 bg-green-500 rounded-full animate-ping"></div>
          </div>
          <div class="w-3 h-3 bg-green-500 rounded-full"></div>
        </div>
        <div class="text-4xl font-bold text-mid-grey mb-2 group-hover:text-green-600 transition-colors">99.9%</div>
        <div class="text-lg font-semibold text-accent-silver mb-1">Production Uptime</div>
        <p class="text-green-600 font-medium text-sm">24/7 Monitoring</p>
      </div>
    </div>

    <!-- STATUS GRID & CONTACT -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Production Status -->
      <div class="lg:col-span-2 bg-white/80 backdrop-blur-sm border border-light-variant/30 rounded-3xl p-8 shadow-2xl">
        <h2 class="text-2xl font-bold text-mid-grey mb-8 border-b border-light-variant/50 pb-6">Production Status</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="group p-6 bg-gradient-to-br from-emerald-500/5 to-emerald-400/5 border border-emerald-200/30 rounded-2xl hover:shadow-lg transition-all">
            <div class="text-3xl font-bold text-emerald-700 mb-2">🟢 LIVE</div>
            <div class="text-sm font-medium text-accent-silver">Phase 14</div>
          </div>
          <div class="group p-6 bg-gradient-to-br from-blue-500/5 to-blue-400/5 border border-blue-200/30 rounded-2xl hover:shadow-lg transition-all">
            <div class="text-3xl font-bold text-blue-700 mb-2">Rails 8.1</div>
            <div class="text-sm font-medium text-accent-silver">Production</div>
          </div>
          <div class="group p-6 bg-gradient-to-br from-indigo-500/5 to-indigo-400/5 border border-indigo-200/30 rounded-2xl hover:shadow-lg transition-all">
            <div class="text-3xl font-bold text-indigo-700 mb-2">GPS LIVE</div>
            <div class="text-sm font-medium text-accent-silver">Real-time</div>
          </div>
          <div class="group p-6 bg-gradient-to-br from-purple-500/5 to-purple-400/5 border border-purple-200/30 rounded-2xl hover:shadow-lg transition-all">
            <div class="text-3xl font-bold text-purple-700 mb-2">Stripe LIVE</div>
            <div class="text-sm font-medium text-accent-silver">Revenue Ready</div>
          </div>
        </div>
      </div>

      <!-- Thomas IT Contact Card -->
      <div class="bg-gradient-to-br from-primary-blue to-lighter-blue text-white rounded-3xl p-8 shadow-2xl border-0 hover:shadow-3xl hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-20 h-20 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold mb-4 text-center">Thomas IT</h3>
        <p class="text-blue-100 mb-8 text-center text-lg font-semibold opacity-90">Pharma Transport Dashboard</p>
        <p class="text-blue-50 mb-8 text-center text-sm opacity-80">v16.1 Production</p>
        <div class="space-y-4 text-sm">
          <%= link_to "🔐 Admin Login", "/login", class: "block w-full bg-white/20 backdrop-blur-sm border border-white/30 rounded-xl py-3 px-4 font-semibold hover:bg-white/30 hover:shadow-lg transition-all text-center" %>
          <%= link_to "📧 Support", "mailto:admin@pharmagps.com", class: "block w-full bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl py-3 px-4 font-semibold hover:bg-white/20 hover:shadow-md transition-all text-center" %>
        </div>
      </div>
    </div>
  </main>
</div>
