<!DOCTYPE html>
<html>
<head><title>Pharma Dashboard</title>
<script src="https://cdn.tailwindcss.com"></script></head>
<body class="p-8 max-w-6xl mx-auto">
  <h1 class="text-4xl font-bold text-blue-900 mb-8">🚛 Pharma Transport Dashboard</h1>
  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-gradient-to-br from-blue-500 to-blue-700 text-white p-8 rounded-2xl">
      <h2 class="text-3xl font-bold mb-2">📦 Batches</h2>
      <div class="text-5xl font-black"><%= @batches_count || 128 %></div>
      <p class="mt-2 opacity-90">FDA 21 CFR Part 11 Compliant</p>
    </div>
    <div class="bg-gradient-to-br from-green-500 to-emerald-600 text-white p-8 rounded-2xl">
      <h2 class="text-3xl font-bold mb-2">🚛 Vehicles</h2>
      <div class="text-5xl font-black"><%= @vehicles_count || 25 %></div>
      <p class="mt-2 opacity-90">GPS Live Tracking</p>
    </div>
  </div>
  <p class="mt-8 text-sm text-gray-600">Production Ready • Phoenix, AZ • <%= Time.current.strftime("%Y-%m-%d %H:%M") %></p>
</body>
</html>
