    <!-- METRICS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="text-3xl mb-2 text-blue-600">🚛 <%= @vehicles_count %></div>
        <div class="text-lg font-semibold text-gray-900">Live Vehicles</div>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="text-3xl mb-2 text-green-600">💉 <%= @batches_count %></div>
        <div class="text-lg font-semibold text-gray-900">Active Batches</div>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="text-3xl mb-2 text-purple-600">$<%= @mrr %></div>
        <div class="text-lg font-semibold text-gray-900">MRR Potential</div>
      </div>
      <div class="bg-emerald-50 border-2 border-emerald-200 p-8 rounded-2xl shadow-xl text-center">
        <div class="text-2xl font-bold text-emerald-700">✅ 21 CFR Part 11</div>
        <div class="text-sm text-emerald-700 mt-1">FDA Compliant</div>
      </div>
    </div>

    <!-- GPS MAP PLACEHOLDER -->
    <div class="bg-white p-8 rounded-2xl shadow-xl mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">🗺️ LIVE GPS TRACKING</h2>
      <div id="pharma-map" class="w-full h-96 bg-gradient-to-br from-gray-200 to-gray-300 rounded-xl flex items-center justify-center">
        <div class="text-center p-8">
          <div class="text-4xl mb-4">📍 PHX-001</div>
          <div class="text-xl font-semibold mb-2">Sky Harbor Airport</div>
          <div class="text-lg mb-4">33.4484° N, 112.0740° W</div>
          <div class="text-sm text-gray-500 bg-white px-4 py-2 rounded-lg border">Google Maps API → LIVE TRACKING</div>
        </div>
      </div>
    </div>

    <!-- CTA BUTTON -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 p-12 rounded-3xl shadow-2xl text-white text-center">
      <h2 class="text-4xl font-bold mb-8">🚀 Start Tracking Today</h2>
      <div class="grid grid-cols-2 gap-12 mb-12 max-w-2xl mx-auto text-2xl">
        <div><div class="font-bold">$99/mo</div><div class="opacity-90 text-lg">Per Vehicle</div></div>
        <div><div class="font-bold">$499/mo</div><div class="opacity-90 text-lg">Enterprise</div></div>
      </div>
      <a href="mailto:sales@thomasinformationtechnology.com?subject=Pharma%20Transport%20Demo" 
         class="inline-block bg-white text-blue-600 px-16 py-6 rounded-3xl font-bold text-2xl shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
        📞 REQUEST LIVE DEMO
      </a>
    </div>
  </div>
</div>
