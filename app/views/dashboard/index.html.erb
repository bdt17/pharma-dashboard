<div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 p-8">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white shadow-2xl rounded-3xl p-12 border border-indigo-100">
      <div class="text-center mb-12">
        <div class="w-24 h-24 bg-gradient-to-r from-indigo-600 to-blue-600 rounded-3xl mx-auto flex items-center justify-center mb-6 shadow-2xl">
          <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m7 4a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">Pharma Transport Dashboard</h1>
        <p class="text-gray-500">Enterprise v9.2 - LIVE</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div class="p-8 bg-indigo-50 rounded-2xl text-center border-4 border-indigo-200">
          <div class="text-5xl font-bold text-indigo-700 mb-2"><%= @vehicles_count %></div>
          <div class="text-xl font-semibold text-gray-700">Active Vehicles</div>
        </div>
        <div class="p-8 bg-blue-50 rounded-2xl text-center border-4 border-blue-200">
          <div class="text-5xl font-bold text-blue-700 mb-2"><%= @batches_count %></div>
          <div class="text-xl font-semibold text-gray-700">Active Batches</div>
        </div>
      </div>
    </div>
  </div>
</div>
