      </div>
      
      <div class="card">
        <h2 style="font-size:2rem;color:#1e293b;margin-bottom:30px;">🚀 Enterprise Ready</h2>
        <div style="margin-bottom:20px;padding:15px;background:#ecfdf5;border-radius:12px;border-left:4px solid #10b981;">
          ✅ Live GPS Tracking (10+ Phoenix trucks)
        </div>
        <div style="margin-bottom:20px;padding:15px;background:#eff6ff;border-radius:12px;border-left:4px solid #3b82f6;">
          ✅ FDA 21 CFR Part 11 Compliance
        </div>
        <a href="/billing" class="cta">💰 Start $99/mo Trial</a>
      </div>
    </div>
    
    <div style="text-align:center;margin-top:60px;padding:30px;background:white;border-radius:24px;">
      <p style="font-size:1.2rem;color:#64748b;">Thomas Information Technology • Phoenix, AZ</p>
      <a href="mailto:sales@thomasinformationtechnology.com?subject=Pharma+Demo" style="color:#3b82f6;font-weight:600;">sales@thomasinformationtechnology.com</a>
    </div>
  </div>
</body>
</html>
