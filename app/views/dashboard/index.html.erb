<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">💉 PHARMA TRANSPORT LIVE</h1>
      <p class="text-xl text-gray-600">Thomas Information Technology · Phoenix, AZ</p>
    </div>

    <!-- PERFECT METRICS (your screenshot) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="text-3xl mb-2 text-blue-600">🚛 <%= @vehicles_count %></div>
        <div class="text-lg font-semibold text-gray-900">Live Vehicles</div>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="text-3xl mb-2 text-green-600">💉 <%= @batches_count %></div>
        <div class="text-lg font-semibold text-gray-900">Active Batches</div>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center">
        <div class="text-3xl mb-2 text-purple-600">$<%= @mrr %></div>
        <div class="text-lg font-semibold text-gray-900">MRR Potential</div>
      </div>
      <div class="bg-emerald-50 border-2 border-emerald-200 p-8 rounded-2xl shadow-xl text-center">
        <div class="text-2xl font-bold text-emerald-700">✅ 21 CFR Part 11</div>
        <div class="text-sm text-emerald-700 mt-1">FDA Compliant</div>
      </div>
    </div>

    <!-- SINGLE GPS MAP PLACEHOLDER -->
    <div class="bg-white p-8 rounded-2xl shadow-xl mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">🗺️ LIVE GPS TRACKING</h2>
      <div class="w-full h-96 bg-gradient-to-br from-gray-200 to-gray-300 rounded-xl flex items-center justify-center">
        <div class="text-center">
          <div class="text-4xl mb-2">📍 PHX-001</div>
          <div class="text-lg text-gray-600">Sky Harbor Airport</div>
          <div class="text-sm text-gray-500">33.4484° N, 112.0740° W</div>
          <div class="text-xs text-gray-400 mt-2">Google Maps API → LIVE TRACKING</div>
        </div>
      </div>
    </div>

    <!-- PERFECT SINGLE CTA -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-700 p-10 rounded-3xl shadow-2xl text-white text-center">
      <h2 class="text-3xl font-bold mb-6">🚀 Start Tracking Today</h2>
      <div class="grid grid-cols-2 gap-8 mb-8 max-w-2xl mx-auto">
        <div><div class="text-3xl font-bold">$99/mo</div><div class="opacity-90">Per Vehicle</div></div>
        <div><div class="text-3xl font-bold">$499/mo</div><div class="opacity-90">Enterprise</div></div>
      </div>
      <a href="mailto:sales@thomasinformationtechnology.com?subject=Pharma%20Transport%20Demo" 
         class="inline-block bg-white text-blue-600 px-12 py-4 rounded-2xl font-bold text-xl hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        📞 REQUEST LIVE DEMO
      </a>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const apiKey = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';
  if (apiKey && apiKey !== 'GOOGLE_MAPS_API_KEY') {
    const script = document.createElement('script');
    script.src = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&callback=initPharmaMap`;
    script.async = true;
    document.head.appendChild(script);
  }
});

function initPharmaMap() {
  const map = new google.maps.Map(document.getElementById("pharma-map"), {
    zoom: 11,
    center: { lat: 33.4484, lng: -112.0740 },
    mapTypeId: 'roadmap'
  });
  
  // PHX-001 + 5 trucks LIVE
  [% for i in 1..6 do %]
    new google.maps.Marker({
      position: { lat: <%= 33.4484 + (i-1)*0.008 %>, lng: <%= -112.0740 + (i-1)*0.004 %> },
      map: map,
      title: "PHX-00<%= i %> (GV55-00<%= i %>)",
      icon: { url: "data:image/svg+xml;base64," }
    });
  [% endfor %]
}
</script>
