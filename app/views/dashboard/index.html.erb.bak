<div class="dashboard">
  <h1 class="logo">💉 PHARMA TRANSPORT</h1>
  <h2 class="subtitle">Thomas Information Technology · Phoenix AZ</h2>

  <div class="grid">
    <div class="card">
      <div class="card-title">Vehicles Live</div>
      <div class="card-main"><%= @active_vehicles %></div>
    </div>
    <div class="card">
      <div class="card-title">Batches Active</div>
      <div class="card-main"><%= @total_batches %></div>
    </div>
    <div class="card">
      <div class="card-title">Monthly Revenue</div>
      <div class="card-main"><%= @monthly_revenue %></div>
    </div>
    <div class="card">
      <div class="card-title">APIs</div>
      <div class="card-main"><%= @api_status %></div>
    </div>
  </div>

  <div class="badge">
    ✅ FDA 21 CFR Part 11 Compliant ·
    <%= link_to "B001 Chain of Custody →", chain_of_custody_path("B001") %>
  </div>
</div>

<!-- YOUR PERFECT CSS STAYS EXACTLY THE SAME -->
<style>
:root {
  --primary-blue: #0984C0;      /* Deep Ocean Blue */
  --lighter-blue: #60BDD1;      /* Sea Serpent */
  --silver-sand: #C0BEC6;
  --metallic-silver: #AAA7B0;
  --davy-grey: #565759;
  --white: #FFFFFF;
}

body {
  min-height: 100dvh;
  margin: 0;
  font-family: 'Courier', 'Courier New', monospace;
  background: #000000 !important;
  color: var(--white);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 40px 16px;
}

.dashboard { max-width: 1100px; width: 100%; }
.logo {
  font-size: 2.5rem;
  font-weight: 700;
  font-family: 'Courier', monospace;
  text-shadow: 0 2px 8px rgba(9,132,192,0.5);
  color: var(--primary-blue);
  letter-spacing: 0.08em;
}
.subtitle {
  font-family: 'Courier', monospace;
  font-size: 1.1rem;
  color: var(--silver-sand);
  margin-top: 8px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 32px;
}
.card {
  background: rgba(255,255,255,0.1);
  border: 1px solid var(--primary-blue);
  border-radius: 8px;
  padding: 20px;
  font-family: 'Courier', monospace;
  color: var(--white);
  backdrop-filter: blur(10px);
}
.card-main {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--primary-blue);
  font-family: 'Courier', monospace;
}
.card-title {
  font-size: 0.95rem;
  text-transform: uppercase;
  color: var(--silver-sand);
  margin-bottom: 8px;
  font-family: 'Courier', monospace;
}
.badge {
  margin-top: 28px;
  padding: 14px 18px;
  border: 2px solid var(--primary-blue);
  background: rgba(9,132,192,0.2);
  color: var(--white);
  font-family: 'Courier', monospace;
  font-size: 0.95rem;
}
a { color: var(--lighter-blue); font-weight: 600; text-decoration: none; }
a:hover { color: var(--white); }
</style>
