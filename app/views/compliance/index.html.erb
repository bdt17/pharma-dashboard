<% content_for :title, "Compliance — Pharma Transport" %>
<% content_for :crumb, "Compliance" %>

<div class="p-7 max-w-5xl">
  <div class="flex flex-col gap-1 mb-6">
    <h1 class="text-[24px]">Compliance</h1>
    <span class="text-[13px] text-ink-faint">Snapshot of the record held at the time of viewing &mdash; <%= current_organization&.name %></span>
  </div>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="card p-4 flex flex-col gap-0.5 <%= "border-[#f0c8c2] bg-[#fdeceb]" if @non_compliant_batches.any? %>">
      <div class="text-[11px] uppercase tracking-wide <%= @non_compliant_batches.any? ? "text-[#8a2c22]" : "text-ink-faint" %>">Non-compliant</div>
      <div class="mono text-[26px] font-medium <%= "text-[#b42318]" if @non_compliant_batches.any? %>"><%= @non_compliant_batches.size %></div>
    </div>
    <div class="card p-4 flex flex-col gap-0.5">
      <div class="text-[11px] uppercase tracking-wide text-ink-faint">Compliant</div>
      <div class="mono text-[26px] font-medium text-accent-700"><%= @compliant_count %></div>
    </div>
    <div class="card p-4 flex flex-col gap-0.5">
      <div class="text-[11px] uppercase tracking-wide text-ink-faint">No reading yet</div>
      <div class="mono text-[26px] font-medium text-ink-faint"><%= @unknown_count %></div>
    </div>
  </div>

  <% if @non_compliant_batches.any? %>
    <div class="card overflow-hidden mb-8 border-[#f0c8c2]">
      <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold text-[#b42318]">Temperature excursions</div>
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2">Lot</th>
            <th class="text-left font-medium px-4 py-2">Temperature</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @non_compliant_batches.each do |batch| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5 mono"><%= batch.lot_number %></td>
              <td class="px-4 py-2.5 mono text-[#b42318] font-semibold"><%= batch.temperature_celsius %>&deg;C</td>
              <td class="px-4 py-2.5"><%= link_to "Chain of custody →", batch_chain_of_custody_pdf_path(batch) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold">Audit trail</div>
    <% if @audit_logs.empty? %>
      <p class="px-4 py-4 text-ink-faint text-[13px]">No audited events yet.</p>
    <% else %>
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2">Time</th>
            <th class="text-left font-medium px-4 py-2">User</th>
            <th class="text-left font-medium px-4 py-2">Event</th>
          </tr>
        </thead>
        <tbody>
          <% @audit_logs.each do |log| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5 mono text-ink-soft"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= log.user.email %></td>
              <td class="px-4 py-2.5 mono"><%= log.event %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <p class="text-[12px] text-ink-faint mt-6 max-w-[80ch]">
    This is a record of the data held at the time of viewing. It is not, on its own, a certification of regulatory compliance.
  </p>
</div>
