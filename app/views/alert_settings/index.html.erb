<% content_for :title, "Alerts — Pharma Transport" %>
<% content_for :crumb, "Alerts" %>

<div class="p-7 max-w-3xl">
  <div class="flex flex-col gap-1 mb-6">
    <h1 class="text-[24px]">Temperature alerts</h1>
    <span class="text-[13px] text-ink-faint">Who hears about it when a shipment goes outside 2&ndash;8&deg;C</span>
  </div>

  <div class="card p-6 bg-surface mb-6">
    <div class="text-[13px] font-semibold mb-1">Email — always on</div>
    <p class="text-[13px] text-ink-soft">
      Every admin and pharmacist in <%= current_organization&.name %> gets an email the moment an
      excursion starts, and again when temperatures recover. Nothing to configure.
    </p>
  </div>

  <h2 class="text-[17px] font-sans font-semibold mb-1">Text messages</h2>
  <p class="text-[13px] text-ink-faint mb-4">
    A text the moment an excursion starts — for the shipments where an email that waits until
    morning is too late.
  </p>

  <% unless @sms_available %>
    <div class="card p-6 bg-[#fbf1e4] border-[#ecd3ac] mb-4">
      <p class="text-[13px]" style="color:#5c4420;">
        SMS alerts are included on the <strong>Pro</strong> and <strong>Compliance</strong> plans.
        <%= link_to "See plans", billing_path, class: "font-medium underline" %>.
      </p>
    </div>
  <% end %>

  <% if @sms_available %>
    <div class="card p-5 mb-4 flex flex-col gap-3">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
          <span class="font-semibold text-[14px]">Quiet hours</span>
          <p class="text-[13px] text-ink-soft max-w-[52ch]">
            Delay excursion texts between <%= Organization::SMS_QUIET_HOURS_START % 12 %>pm and
            <%= Organization::SMS_QUIET_HOURS_END %>am local time until the window ends, instead of
            sending them right away. Email and webhooks are never delayed — this is SMS only.
          </p>
        </div>
        <span class="badge <%= current_organization.sms_quiet_hours_enabled? ? "badge-accent" : "" %> shrink-0">
          <%= current_organization.sms_quiet_hours_enabled? ? "On" : "Off" %>
        </span>
      </div>
      <% if current_user.admin? %>
        <%= form_with url: alert_quiet_hours_path, method: :patch, model: current_organization,
              class: "flex flex-wrap items-center gap-3" do |f| %>
          <label class="flex items-center gap-2 text-[13px]">
            <%= f.check_box :sms_quiet_hours_enabled, class: "rounded" %>
            Enabled
          </label>
          <%= f.time_zone_select :time_zone, nil,
                { default: current_organization.time_zone_or_utc.name },
                class: "border border-line rounded px-2 py-1.5 text-[13px]" %>
          <%= f.submit "Save", class: "btn btn-primary btn-sm" %>
        <% end %>
      <% else %>
        <p class="text-[12px] text-ink-faint">Only an organization admin can change this.</p>
      <% end %>
    </div>
  <% end %>

  <% if @sms_available || @recipients.any? %>
    <div class="card overflow-hidden mb-4">
      <% if @recipients.any? %>
        <table class="w-full text-[13px]">
          <thead>
            <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
              <th class="text-left font-medium px-4 py-2">Name</th>
              <th class="text-left font-medium px-4 py-2">Number</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody>
            <% @recipients.each do |recipient| %>
              <tr class="border-t border-line-soft">
                <td class="px-4 py-2.5"><%= recipient.label %></td>
                <td class="px-4 py-2.5 mono"><%= recipient.phone %></td>
                <td class="px-4 py-2.5 text-right">
                  <% if current_user.admin? %>
                    <div class="flex items-center justify-end gap-3">
                      <%= button_to "Send test", test_alert_recipient_path(recipient), method: :post,
                            class: "text-[12px] text-accent-600 hover:text-accent-700" %>
                      <%= button_to "Remove", alert_recipient_path(recipient), method: :delete,
                            form: { data: { turbo_confirm: "Remove #{recipient.label} from SMS alerts?" } },
                            class: "text-[12px] text-[#b42318] hover:underline" %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-4 py-4 text-ink-faint text-[13px]">No numbers on the list yet.</p>
      <% end %>
    </div>

    <% if @sms_available && current_user.admin? %>
      <%= form_with model: @recipient, url: alert_recipients_path, method: :post, class: "card p-5 flex flex-col gap-3" do |f| %>
        <% if @recipient.errors.any? %>
          <div class="rounded border border-[#f0c8c2] bg-[#fdeceb] text-[#b42318] px-3 py-2 text-[13px]">
            <%= @recipient.errors.full_messages.to_sentence %>
          </div>
        <% end %>
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1">
            <%= f.label :label, "Name", class: "block text-[12px] text-ink-faint mb-1" %>
            <%= f.text_field :label, placeholder: "On-call pharmacist", class: "w-full border border-line rounded px-3 py-1.5 text-[13px]" %>
          </div>
          <div class="flex-1">
            <%= f.label :phone, "Mobile number", class: "block text-[12px] text-ink-faint mb-1" %>
            <%= f.telephone_field :phone, placeholder: "+1 415 555 0100", class: "w-full border border-line rounded px-3 py-1.5 text-[13px] mono" %>
          </div>
        </div>
        <div>
          <%= f.submit "Add number", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    <% elsif @sms_available %>
      <p class="text-[13px] text-ink-faint">Only an organization admin can change the list.</p>
    <% end %>
  <% end %>
</div>
