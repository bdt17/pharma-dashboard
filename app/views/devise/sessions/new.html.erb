<div class="min-h-screen bg-gradient-to-br from-indigo-900 to-purple-900 flex items-center justify-center py-12">
  <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl p-12">
    <h1 class="text-4xl font-bold text-center text-gray-800 mb-8">🔐 PharmaTransport</h1>
    <h2 class="text-xl text-center text-gray-600 mb-8">Enterprise Login Portal</h2>
    
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'space-y-6' }) do |f| %>
      <div>
        <%= f.email_field :email, autofocus: true, required: true, 
            class: 'w-full px-4 py-4 border border-gray-300 rounded-2xl focus:ring-4 focus:ring-indigo-500 focus:border-transparent text-lg',
            placeholder: 'admin@pharmatransport.com' %>
      </div>
      <div>
        <%= f.password_field :password, required: true, 
            class: 'w-full px-4 py-4 border border-gray-300 rounded-2xl focus:ring-4 focus:ring-indigo-500 focus:border-transparent text-lg',
            placeholder: 'Enter secure password' %>
      </div>
      <%= f.submit '🚚 Secure Enterprise Login', 
          class: 'w-full bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-4 px-8 rounded-2xl font-bold text-xl shadow-2xl hover:from-indigo-700 hover:to-purple-700 transition-all duration-300' %>
    <% end %>
  </div>
</div>


