<% content_for :title, "Sign in — Pharma Transport" %>
<% content_for :bare_layout, "1" %>

<h1 class="text-[20px] mb-1">Sign in</h1>
<p class="text-[13px] text-ink-faint mb-6">Access your organization's dashboard.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4" }) do |f| %>
  <div class="flex flex-col gap-1.5">
    <%= f.label :email, class: "text-[12.5px] font-semibold text-ink-soft" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
  </div>

  <div class="flex flex-col gap-1.5">
    <%= f.label :password, class: "text-[12.5px] font-semibold text-ink-soft" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "field-input" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="inline-flex items-center gap-2 text-[13px] text-ink-soft">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "Keep me signed in" %>
    </label>
  <% end %>

  <%= f.submit "Sign in", class: "btn btn-primary w-full" %>
<% end %>

<div class="mt-6 text-[13px] [&_a]:block [&_a]:mb-1">
  <%= render "devise/shared/links" %>
</div>
