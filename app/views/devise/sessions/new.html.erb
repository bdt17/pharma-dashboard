<div class="min-h-screen bg-white flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <!-- Logo Header -->
    <div class="text-center">
<div class="mx-auto h-16 w-16 bg-gradient-to-r from-[#0984C0] to-[#60BDD1] rounded-2xl flex items-center justify-center shadow-lg">
  <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
  </svg>
</div>
      <h2 class="mt-6 text-3xl font-bold text-[#565759]">Pharma Transport</h2>
      <p class="mt-1 text-sm text-[#AAA7B0]">Secure Enterprise Login</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white shadow-xl rounded-2xl p-8 border border-[#C0BEC6]">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <div>
          <label class="block text-sm font-medium text-[#565759] mb-2">Email</label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                           class: "w-full px-4 py-3 border border-[#C0BEC6] rounded-xl focus:ring-2 focus:ring-[#60BDD1] focus:border-[#0984C0] transition duration-200 text-[#565759] placeholder-[#AAA7B0]" %>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-[#565759] mb-2">Password</label>
          <%= f.password_field :password, autocomplete: "current-password", 
                              class: "w-full px-4 py-3 border border-[#C0BEC6] rounded-xl focus:ring-2 focus:ring-[#60BDD1] focus:border-[#0984C0] transition duration-200 text-[#565759] placeholder-[#AAA7B0]" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-[#0984C0] focus:ring-[#60BDD1] border-[#C0BEC6] rounded" %>
            <%= f.label :remember_me, "Remember me", class: "ml-2 block text-sm text-[#565759]" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "🚚 Secure Login", 
                      class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-gradient-to-r from-[#0984C0] to-[#60BDD1] hover:from-[#0984C0]/90 hover:to-[#60BDD1]/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#60BDD1] transition-all duration-200 shadow-xl hover:shadow-2xl hover:-translate-y-0.5 transform" %>
        </div>
      <% end %>
    </div>

    <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
      <%= link_to "Forgot your password?", new_password_path(resource_name), 
                  class: "block w-full text-center text-sm text-[#60BDD1] hover:text-[#0984C0] font-medium py-2 transition-colors duration-200" %>
    <% end %>
  </div>
</div>
