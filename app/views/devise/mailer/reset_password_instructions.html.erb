<% url = edit_password_url(@resource, reset_password_token: @token) %>
<p style="margin:0 0 14px;">We received a request to reset the password for your Pharma Transport account (<%= @resource.email %>).</p>
<p style="margin:0 0 20px;"><%= link_to "Choose a new password", url, style: "display:inline-block;background:#1f3a53;color:#ffffff;text-decoration:none;font-weight:600;padding:11px 20px;border-radius:8px;" %></p>
<p style="font-size:12px;color:#5b6b7c;">This link expires in <%= Devise.reset_password_within.inspect %> and works once. If the button doesn't work, copy this link into your browser:<br><%= link_to url, url, style: "color:#1f3a53;word-break:break-all;" %></p>
<p style="font-size:12px;color:#5b6b7c;">If you didn't ask for this, ignore this email. Your password stays the same unless you choose a new one.</p>
