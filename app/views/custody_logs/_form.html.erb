<%= form_with(model: custody_log, class: "contents") do |form| %>
  <% if custody_log.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(custody_log.errors.count, "error") %> prohibited this custody_log from being saved:</h2>

      <ul class="list-disc ml-6">
        <% custody_log.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :batch_id %>
    <%= form.text_field :batch_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:batch_id].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:batch_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :handler_name %>
    <%= form.text_field :handler_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:handler_name].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:handler_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :signature_data %>
    <%= form.text_field :signature_data, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:signature_data].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:signature_data].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :location %>
    <%= form.text_field :location, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:location].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:location].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :condition_notes %>
    <%= form.textarea :condition_notes, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:condition_notes].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:condition_notes].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :action_type %>
    <%= form.text_field :action_type, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:action_type].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:action_type].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :timestamp %>
    <%= form.datetime_field :timestamp, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": custody_log.errors[:timestamp].none?, "border-red-400 focus:outline-red-600": custody_log.errors[:timestamp].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
