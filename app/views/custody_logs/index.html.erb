<% content_for :title, "Custody history — Pharma Transport" %>
<% content_for :crumb, "Custody history" %>

<div class="p-7 max-w-4xl">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="flex flex-col gap-1">
      <h1 class="text-[24px]">Custody history</h1>
      <span class="text-[13px] text-ink-faint">
        Lot <span class="mono"><%= @batch.lot_number %></span>
      </span>
    </div>
    <%= link_to "Record a custody event", new_batch_custody_log_path(@batch), class: "btn btn-primary btn-sm shrink-0" %>
  </div>

  <p class="text-[13px] mb-6">
    <%= link_to "Chain-of-custody PDF", batch_chain_of_custody_pdf_path(@batch), class: "font-medium" %>
    <span class="text-ink-faint mx-1">·</span>
    <%= link_to "Compliance packets", batch_compliance_reports_path(@batch), class: "font-medium" %>
  </p>

  <div class="card overflow-hidden">
    <div class="px-4 py-3 border-b border-line-soft text-[13px] font-semibold">Events</div>
    <% if @custody_logs.empty? %>
      <p class="px-4 py-4 text-ink-faint text-[13px]">No custody events recorded yet.</p>
    <% else %>
      <table class="w-full text-[13px]">
        <thead>
          <tr class="bg-surface text-[11px] uppercase tracking-wide text-ink-faint">
            <th class="text-left font-medium px-4 py-2">Time</th>
            <th class="text-left font-medium px-4 py-2">Action</th>
            <th class="text-left font-medium px-4 py-2">Handler</th>
            <th class="text-left font-medium px-4 py-2">Location</th>
          </tr>
        </thead>
        <tbody>
          <% @custody_logs.each do |log| %>
            <tr class="border-t border-line-soft">
              <td class="px-4 py-2.5 mono">
                <%= link_to log.timestamp.strftime("%Y-%m-%d %H:%M"), batch_custody_log_path(@batch, log) %>
              </td>
              <td class="px-4 py-2.5"><span class="badge badge-accent"><%= log.action_type %></span></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= log.handler_name %></td>
              <td class="px-4 py-2.5 text-ink-soft"><%= log.location %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
