<div class="max-w-4xl mx-auto p-8">
  <h1 class="text-2xl font-bold mb-2">Custody history — <%= @batch.lot_number %></h1>
  <p class="text-sm text-gray-500 mb-6">
    <%= link_to "View chain-of-custody PDF", batch_chain_of_custody_pdf_path(@batch) %>
    &middot;
    <%= link_to "Compliance packets", batch_compliance_reports_path(@batch) %>
  </p>

  <% if @custody_logs.empty? %>
    <p class="text-gray-500">No custody events recorded yet.</p>
  <% else %>
    <table class="w-full border-collapse border border-gray-300">
      <thead>
        <tr class="bg-gray-100">
          <th class="border border-gray-300 p-2 text-left">Time</th>
          <th class="border border-gray-300 p-2 text-left">Action</th>
          <th class="border border-gray-300 p-2 text-left">Handler</th>
          <th class="border border-gray-300 p-2 text-left">Location</th>
        </tr>
      </thead>
      <tbody>
        <% @custody_logs.each do |log| %>
          <tr>
            <td class="border border-gray-300 p-2"><%= link_to log.timestamp.strftime("%Y-%m-%d %H:%M"), batch_custody_log_path(@batch, log) %></td>
            <td class="border border-gray-300 p-2"><%= log.action_type %></td>
            <td class="border border-gray-300 p-2"><%= log.handler_name %></td>
            <td class="border border-gray-300 p-2"><%= log.location %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <p class="mt-6">
    <%= link_to "Record a custody event", new_batch_custody_log_path(@batch), class: "text-blue-600 underline" %>
  </p>
</div>
