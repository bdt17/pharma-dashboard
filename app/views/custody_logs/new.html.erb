<div class="max-w-lg mx-auto p-8">
  <h1 class="text-2xl font-bold mb-4">Record a custody event — <%= @batch.lot_number %></h1>

  <%= form_with model: @custody_log, url: batch_custody_logs_path(@batch), local: true,
        data: { controller: "signature-pad", action: "submit->signature-pad#save" } do |f| %>
    <% if @custody_log.errors.any? %>
      <div class="text-red-600 mb-4">
        <ul>
          <% @custody_log.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :action_type, class: "block font-medium mb-1" %>
      <%= f.select :action_type, CustodyLog::ACTION_TYPES, {}, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :handler_name, "Handler name", class: "block font-medium mb-1" %>
      <%= f.text_field :handler_name, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :location, class: "block font-medium mb-1" %>
      <%= f.text_field :location, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :condition_notes, "Notes (optional)", class: "block font-medium mb-1" %>
      <%= f.text_area :condition_notes, class: "border rounded p-2 w-full" %>
    </div>

    <fieldset class="mb-4 border rounded p-4">
      <legend class="font-medium px-1">Signature (required to confirm delivery)</legend>

      <canvas data-signature-pad-target="canvas"
              class="border rounded w-full bg-gray-50"
              style="height: 160px; touch-action: none;"></canvas>
      <button type="button" data-action="signature-pad#clear" class="text-sm text-blue-600 underline mt-1">Clear</button>
      <%# signature_data is a plain jsonb column, not a real association --
          FormBuilder's f.* methods don't produce correct nested bracket
          names for that ("custody_log[signature_data[image]]", which
          doesn't parse as nested params), so these use the *_tag helpers
          with the exact name spelled out instead. %>
      <%= hidden_field_tag "custody_log[signature_data][image]", "", data: { signature_pad_target: "input" } %>

      <div class="mt-3">
        <%= label_tag "custody_log_signature_data_signer_name", "Signer name", class: "block font-medium mb-1" %>
        <%= text_field_tag "custody_log[signature_data][signer_name]", nil, class: "border rounded p-2 w-full" %>
      </div>

      <div class="mt-3">
        <%= label_tag "custody_log_signature_data_signer_role", "Signer role", class: "block font-medium mb-1" %>
        <%= select_tag "custody_log[signature_data][signer_role]", options_for_select([ "recipient", "driver", "witness" ]), class: "border rounded p-2 w-full" %>
      </div>
    </fieldset>

    <%= f.submit "Record event", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
  <% end %>
</div>
