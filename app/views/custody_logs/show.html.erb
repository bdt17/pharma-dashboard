<div class="max-w-2xl mx-auto p-8">
  <h1 class="text-2xl font-bold mb-4">Custody event — <%= @batch.lot_number %></h1>

  <dl class="grid grid-cols-3 gap-y-2">
    <dt class="text-gray-500">Time</dt>
    <dd class="col-span-2"><%= @custody_log.timestamp.strftime("%Y-%m-%d %H:%M") %></dd>

    <dt class="text-gray-500">Action</dt>
    <dd class="col-span-2"><%= @custody_log.action_type %></dd>

    <dt class="text-gray-500">Handler</dt>
    <dd class="col-span-2"><%= @custody_log.handler_name %></dd>

    <dt class="text-gray-500">Location</dt>
    <dd class="col-span-2"><%= @custody_log.location %></dd>

    <dt class="text-gray-500">Notes</dt>
    <dd class="col-span-2"><%= @custody_log.condition_notes.presence || "—" %></dd>
  </dl>

  <p class="mt-6">
    <%= link_to "← Back to custody history", batch_custody_logs_path(@batch) %>
  </p>
</div>
