<% content_for :title, "Custody event — Pharma Transport" %>
<% content_for :crumb, "Custody event" %>

<div class="p-7 max-w-2xl">
  <div class="flex flex-col gap-1 mb-6">
    <h1 class="text-[24px]">Custody event</h1>
    <span class="text-[13px] text-ink-faint">
      Lot <span class="mono"><%= @batch.lot_number %></span>
    </span>
  </div>

  <dl class="card p-6 grid grid-cols-3 gap-y-3 text-[14px]">
    <dt class="text-ink-faint">Time</dt>
    <dd class="col-span-2 mono"><%= @custody_log.timestamp.strftime("%Y-%m-%d %H:%M") %></dd>

    <dt class="text-ink-faint">Action</dt>
    <dd class="col-span-2"><span class="badge badge-accent"><%= @custody_log.action_type %></span></dd>

    <dt class="text-ink-faint">Handler</dt>
    <dd class="col-span-2 font-semibold"><%= @custody_log.handler_name %></dd>

    <dt class="text-ink-faint">Location</dt>
    <dd class="col-span-2"><%= @custody_log.location %></dd>

    <dt class="text-ink-faint">Notes</dt>
    <dd class="col-span-2 text-ink-soft"><%= @custody_log.condition_notes.presence || "—" %></dd>

    <% if @custody_log.signed? %>
      <dt class="text-ink-faint">Signed by</dt>
      <dd class="col-span-2">
        <%= @custody_log.signature_data["signer_name"] %>
        <% if @custody_log.signature_data["signed_at"].present? %>
          <span class="text-ink-faint">· <%= Time.zone.parse(@custody_log.signature_data["signed_at"]).strftime("%Y-%m-%d %H:%M") %></span>
        <% end %>
      </dd>
    <% end %>
  </dl>

  <p class="text-[13px] mt-4">
    <%= link_to "← Back to custody history", batch_custody_logs_path(@batch), class: "font-medium" %>
  </p>
</div>
