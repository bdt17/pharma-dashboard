<div id="<%= dom_id custody_log %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Batch:</strong>
    <%= custody_log.batch_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Handler name:</strong>
    <%= custody_log.handler_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Signature data:</strong>
    <%= custody_log.signature_data %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Location:</strong>
    <%= custody_log.location %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Condition notes:</strong>
    <%= custody_log.condition_notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Action type:</strong>
    <%= custody_log.action_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Timestamp:</strong>
    <%= custody_log.timestamp %>
  </div>
</div>
