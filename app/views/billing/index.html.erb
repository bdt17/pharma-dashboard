<div class="max-w-2xl mx-auto p-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Billing</h1>
    <% if @subscription %>
      <%= button_to "Manage billing", billing_portal_path, method: :post, class: "text-sm border border-gray-300 rounded px-3 py-1.5 hover:bg-gray-50" %>
    <% end %>
  </div>

  <% if @subscription&.active_or_trialing? %>
    <dl class="grid grid-cols-3 gap-y-3 border rounded-lg p-6">
      <dt class="text-gray-500">Status</dt>
      <dd class="col-span-2">
        <span class="text-green-700 font-semibold">
          <%= @subscription.status.humanize %>
        </span>
      </dd>

      <dt class="text-gray-500">Plan amount</dt>
      <dd class="col-span-2"><%= number_to_currency(@subscription.plan_amount) if @subscription.plan_amount %></dd>

      <dt class="text-gray-500">Current period ends</dt>
      <dd class="col-span-2"><%= @subscription.current_period_end&.strftime("%Y-%m-%d") || "—" %></dd>
    </dl>
  <% else %>
    <% if @subscription %>
      <div class="border rounded-lg p-6 bg-red-50 mb-6">
        <p class="text-gray-700">
          Subscription for <%= current_organization&.name %> is
          <span class="text-red-600 font-semibold"><%= @subscription.status.humanize %></span>.
        </p>
      </div>
    <% else %>
      <div class="border rounded-lg p-6 bg-gray-50 mb-6">
        <p class="text-gray-700">No subscription on file for <%= current_organization&.name %>.</p>
      </div>
    <% end %>

    <% if @plans.present? %>
      <h2 class="text-lg font-bold mb-3">Available plans</h2>
      <p class="text-sm text-gray-500 mb-3">
        Every plan starts with a <%= StripeBilling::TRIAL_PERIOD_DAYS %>-day free trial — you won't be charged until it ends.
      </p>
      <% if Time.current <= StripeBilling.founding_offer_cutoff %>
        <p class="text-sm font-medium text-accent-800 bg-accent-50 border border-accent-300 rounded-lg p-3 mb-3">
          Founding customer offer: subscribe to the monthly plan before
          <%= StripeBilling.founding_offer_cutoff.strftime("%B %-d, %Y") %>
          and get 25% off your first 6 months — applied automatically at checkout.
        </p>
      <% end %>
      <div class="space-y-3">
        <% @plans.group_by { |plan| plan[:product_name] }.each do |product_name, variants| %>
          <% monthly = variants.find { |p| p[:interval] == "month" }
             annual = variants.find { |p| p[:interval] == "year" }
             others = variants - [ monthly, annual ].compact %>
          <div class="border rounded-lg p-4">
            <div class="font-semibold mb-2"><%= product_name %></div>
            <div class="space-y-2">
              <% [ monthly, annual, *others ].compact.each do |plan| %>
                <div class="flex items-center justify-between">
                  <div class="text-sm text-gray-500">
                    <%= number_to_currency(plan[:amount]) %><% if plan[:interval] %> / <%= plan[:interval] %><% end %>
                    <% if plan == annual && monthly %>
                      <span class="text-green-700 font-medium">— save 10% vs. monthly</span>
                    <% end %>
                  </div>
                  <% if current_user.admin? %>
                    <%= button_to "Subscribe", billing_checkout_path(price_id: plan[:id]), method: :post, class: "bg-blue-600 text-white px-4 py-2 rounded" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <% unless current_user.admin? %>
        <p class="text-sm text-gray-500 mt-4">Only an organization admin can start a subscription.</p>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-500">Billing isn't configured yet. Contact us to set up billing.</p>
    <% end %>

    <% if @addons.present? %>
      <h2 class="text-lg font-bold mb-3 mt-8">Need one more this month?</h2>
      <p class="text-sm text-gray-500 mb-3">
        Buy a single extra Compliance Packet without subscribing.
        <% if @available_credits.to_i > 0 %>
          You currently have <%= pluralize(@available_credits, "unused credit") %>.
        <% end %>
      </p>
      <div class="space-y-3">
        <% @addons.each do |addon| %>
          <div class="border rounded-lg p-4 flex items-center justify-between">
            <div>
              <div class="font-semibold"><%= addon[:product_name] %></div>
              <div class="text-sm text-gray-500"><%= number_to_currency(addon[:amount]) %> one-time</div>
            </div>
            <% if current_user.admin? %>
              <%= button_to "Buy", billing_addon_checkout_path(price_id: addon[:id]), method: :post, class: "bg-gray-800 text-white px-4 py-2 rounded" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="border rounded-lg p-6 bg-gray-50 mt-8 space-y-4">
    <h2 class="text-lg font-bold">Share Pharma Transport</h2>

    <div>
      <div class="text-sm text-gray-500 mb-1">Your referral code — give it to another pharmacy and you both get a free month once they subscribe</div>
      <code class="bg-white border rounded px-3 py-1.5 inline-block font-mono text-sm"><%= current_organization.referral_code %></code>
    </div>

    <div>
      <div class="text-sm text-gray-500 mb-1">
        Your DSCSA verification badge —
        <% if current_organization.verified? %>
          shareable on your own site or with an auditor
        <% else %>
          currently shows "not verified" since there's no active subscription; it'll update automatically once you subscribe
        <% end %>
      </div>
      <code class="bg-white border rounded px-3 py-1.5 inline-block font-mono text-sm break-all"><%= verification_url(current_organization.verification_token) %></code>
    </div>
  </div>
</div>
