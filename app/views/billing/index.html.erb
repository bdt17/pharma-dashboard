<div class="min-h-screen bg-gradient-to-br from-indigo-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-20">
      <h1 class="text-6xl font-black bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-600 bg-clip-text text-transparent mb-6">
        💳 Pharma Transport Enterprise
      </h1>
      <h2 class="text-3xl font-semibold text-gray-900 mb-8">Live GPS + FDA 21 CFR Part 11 Compliance</h2>
      
      <% if @vehicles && @vehicles > 0 %>
        <div class="inline-flex items-center bg-gradient-to-r from-green-500 to-emerald-600 text-white px-12 py-8 rounded-3xl shadow-2xl mb-12">
          <div class="text-5xl font-black mr-6">$<%= number_with_delimiter(@revenue_projection) %></div>
          <div>
            <div class="text-2xl font-bold">Monthly Revenue Potential</div>
            <div class="text-xl opacity-90"><%= @vehicles %> trucks × $99/mo</div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <% [
        {name: "GPS Basic", price: "$99", desc: "1 Truck<br>Chain-of-Custody PDF<br>Live GPS", color: "blue"},
        {name: "Enterprise", price: "$999", desc: "10+ Trucks<br>FDA 21 CFR Part 11<br>API Access", color: "green"},
        {name: "Compliance Pro", price: "$1,999", desc: "Unlimited<br>Full FDA Compliance<br>White-label", color: "purple"}
      ].each do |plan| %>
        <%= form_with url: '/billing', method: :post do |f| %>
          <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-10 shadow-2xl hover:shadow-3xl border-2 hover:border-#{plan[:color]}-200 h-full transition-all hover:-translate-y-3">
            <div class="text-5xl font-black text-#{plan[:color]}-600 mb-8"><%= plan[:price] %><span class="text-2xl">/mo</span></div>
            <h3 class="text-3xl font-bold text-gray-900 mb-6"><%= plan[:name] %></h3>
            <div class="space-y-3 mb-12 text-xl text-gray-700"><%= plan[:desc].gsub('<br>', '<br>').html_safe %></div>
            <%= f.hidden_field :plan, value: plan[:name] %>
            <%= f.submit "🚀 Activate #{plan[:name]}", class: "w-full bg-gradient-to-r from-#{plan[:color]}-500 to-#{plan[:color]}-600 hover:from-#{plan[:color]}-600 hover:to-#{plan[:color]}-700 text-white font-black py-5 px-8 rounded-2xl text-xl shadow-2xl hover:shadow-3xl transition-all" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @live_vehicles && @live_vehicles.any? %>
      <div class="bg-white/60 backdrop-blur-xl rounded-3xl p-10 shadow-2xl border border-white/50">
        <h3 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
          📍 Live Phoenix Fleet (<%= @vehicles %> trucks)
          <span class="ml-6 px-6 py-2 bg-emerald-100 text-emerald-800 rounded-2xl text-lg font-bold">
            $<%= number_with_delimiter(@revenue_projection) %>/mo potential
          </span>
        </h3>
        <div class="grid md:grid-cols-3 lg:grid-cols-6 gap-6">
          <% @live_vehicles.each do |truck| %>
            <div class="p-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-100 hover:shadow-xl transition-all text-center">
              <div class="font-bold text-xl mb-2"><%= truck.name %></div>
              <div class="text-3xl font-black text-blue-600"><%= truck.speed %><span class="text-lg">mph</span></div>
              <div class="text-sm text-gray-500 mt-2">33.45°N, 112.07°W</div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
