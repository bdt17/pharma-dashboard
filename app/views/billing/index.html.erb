<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 p-12">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-5xl font-bold text-gray-900 mb-12">💳 Choose Your Plan</h1>
    
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white p-10 rounded-3xl shadow-xl border-4 border-blue-100">
        <div class="text-5xl font-black text-blue-600 mb-6">$99<span class="text-2xl">/mo</span></div>
        <h3 class="text-3xl font-bold mb-8">GPS Basic</h3>
        <ul class="text-left mb-12 space-y-3 text-lg">
          <li>✅ 1 Truck GPS Tracking</li>
          <li>✅ Chain-of-Custody PDF</li>
          <li>✅ Live Dashboard</li>
        </ul>
        <form action="/billing" method="post">
          <input type="hidden" name="plan" value="GPS Basic">
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-5 px-8 rounded-2xl text-xl shadow-xl hover:shadow-2xl transition-all">Activate GPS Basic</button>
        </form>
      </div>
      
      <div class="bg-white p-10 rounded-3xl shadow-xl border-4 border-emerald-100">
        <div class="text-5xl font-black text-emerald-600 mb-6">$999<span class="text-2xl">/mo</span></div>
        <h3 class="text-3xl font-bold mb-8">Enterprise</h3>
        <ul class="text-left mb-12 space-y-3 text-lg">
          <li>✅ 10+ Trucks</li>
          <li>✅ FDA 21 CFR Part 11</li>
          <li>✅ API Access</li>
        </ul>
        <form action="/billing" method="post">
          <input type="hidden" name="plan" value="Enterprise">
          <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-5 px-8 rounded-2xl text-xl shadow-xl hover:shadow-2xl transition-all">Activate Enterprise</button>
        </form>
      </div>
      
      <div class="bg-white p-10 rounded-3xl shadow-xl border-4 border-purple-100">
        <div class="text-5xl font-black text-purple-600 mb-6">$1,999<span class="text-2xl">/mo</span></div>
        <h3 class="text-3xl font-bold mb-8">Compliance Pro</h3>
        <ul class="text-left mb-12 space-y-3 text-lg">
          <li>✅ Unlimited Trucks</li>
          <li>✅ Full FDA Compliance</li>
          <li>✅ White-label Branding</li>
        </ul>
        <form action="/billing" method="post">
          <input type="hidden" name="plan" value="Compliance Pro">
          <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-5 px-8 rounded-2xl text-xl shadow-xl hover:shadow-2xl transition-all">Activate Pro</button>
        </form>
      </div>
    </div>
    
    <div class="mt-16 p-8 bg-emerald-100 border-2 border-emerald-200 rounded-3xl">
      <h3 class="text-2xl font-bold text-emerald-800 mb-4">💰 Revenue Calculator</h3>
      <div class="text-4xl font-black text-emerald-700">$<%= Vehicle.count * 99 %> MRR</div>
      <p class="text-xl text-emerald-800 mt-2"><%= Vehicle.count %> trucks × $99/month</p>
    </div>
  </div>
</div>
