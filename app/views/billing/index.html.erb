<div class="min-h-screen bg-gradient-to-br from-indigo-50 to-blue-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent mb-4">
        Pharma Transport
      </h1>
      <h2 class="text-3xl font-semibold text-gray-900 mb-6">Subscription Plans</h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">
        GPS tracking + FDA 21 CFR Part 11 compliance for pharmaceutical cold chain
      </p>
      <% if @vehicles && @vehicles > 0 %>
        <div class="bg-green-100 border border-green-400 text-green-800 px-6 py-3 rounded-xl max-w-md mx-auto">
          🚀 <%= @vehicles %> vehicles = $<%= number_with_delimiter(@revenue_projection) %>/mo potential
        </div>
      <% end %>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <% @plans.each do |plan| %>
        <%= form_with url: billing_index_path, method: :post do |f| %>
          <%= f.hidden_field :price_id, value: plan[:id] %>
          <%= f.hidden_field :plan, value: plan[:name].downcase.gsub(" ", "_") %>
          <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-500 p-10 border border-white/50 hover:border-blue-200 hover:-translate-y-2">
            <div class="text-5xl font-black text-blue-600 mb-6"><%= plan[:amount] %></div>
            <h3 class="text-3xl font-bold text-gray-900 mb-8"><%= plan[:name] %></h3>
            <div class="space-y-4 mb-10">
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center mt-1">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"></path>
                  </svg>
                </div>
                <span class="text-lg text-gray-700 font-medium">Real-time GPS tracking</span>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center mt-1">✓</div>
                <span class="text-lg text-gray-700 font-medium">Chain-of-custody PDFs</span>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center mt-1">✓</div>
                <span class="text-lg text-gray-700 font-medium">FDA 21 CFR Part 11</span>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center mt-1">✓</div>
                <span class="text-lg text-gray-700 font-medium">Live WebSocket updates</span>
              </div>
            </div>
            <%= f.submit "Start #{plan[:name]} →", 
                class: "w-full bg-gradient-to-r from-blue-500 to-blue-700 hover:from-blue-600 hover:to-blue-800 text-white font-bold py-5 px-8 rounded-2xl text-xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-1" %>
          </div>
        <% end %>
      <% end %>
    </div>
    
    <div class="text-center text-sm text-gray-500">
      Test with card: 4242 4242 4242 4242 • No real charges
    </div>
  </div>
</div>
