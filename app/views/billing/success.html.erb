          <span class="text-xl font-semibold text-green-800">✅ Chain-of-custody reports</span>
        </div>
      </div>
      <%= link_to "→ Vehicle Dashboard", "/vehicles", 
          class: "block w-full bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-bold py-6 px-8 rounded-3xl text-2xl shadow-2xl hover:shadow-3xl mt-12 transition-all duration-300 mx-auto max-w-md" %>
    </div>
  </div>
