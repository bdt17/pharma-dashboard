<div class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-50 py-20 px-4">
  <div class="max-w-2xl mx-auto text-center">
    <div class="w-32 h-32 bg-green-500 rounded-3xl mx-auto mb-12 flex items-center justify-center shadow-2xl">
