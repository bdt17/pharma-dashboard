<h1>Pharma Transport Login</h1>
<div style="max-width: 400px; padding: 20px; border: 1px solid #ccc;">
  <%= form_for resource, as: resource_name, url: session_path(resource_name), html: { class: 'form' } do |f| %>
    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email, autofocus: true, placeholder: "admin@pharmagps.com", value: "admin@pharmagps.com" %>
    </div>
    
    <div class="field">
      <%= f.label :password %><br />
      <%= f.password_field :password, placeholder: "password", autocomplete: "current-password" %>
    </div>
    
    <div><%= f.submit "Login", class: "button" %></div>
  <% end %>
</div>
