<div class="max-w-md mx-auto p-8">
  <h1 class="text-2xl font-bold mb-2">Start your organization</h1>
  <p class="text-sm text-gray-500 mb-6">Creates a new organization with you as its admin.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%# organization_name isn't a real User attribute -- f.text_field would call
          resource.organization_name, which doesn't exist. Spelled out as a plain
          tag instead, same reason as the signature_data fields on custody logs. %>
      <%= label_tag "user_organization_name", "Organization name", class: "block font-medium mb-1" %>
      <%= text_field_tag "user[organization_name]", params.dig(:user, :organization_name), autofocus: true, class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, class: "block font-medium mb-1" %>
      <%= f.email_field :email, autocomplete: "email", class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block font-medium mb-1" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-gray-500 mb-1">(<%= @minimum_password_length %> characters minimum)</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-6">
      <%= f.label :password_confirmation, "Confirm password", class: "block font-medium mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "border rounded p-2 w-full" %>
    </div>

    <div class="mb-4">
      <%# Same reasoning as organization_name above -- referral_code isn't a
          real User attribute, it's read directly off params in the
          controller to look up the referring organization. %>
      <%= label_tag "user_referral_code", "Referral code (optional)", class: "block font-medium mb-1" %>
      <%= text_field_tag "user[referral_code]", params.dig(:user, :referral_code), class: "border rounded p-2 w-full" %>
      <p class="text-xs text-gray-500 mt-1">Referred by another pharmacy? Enter their code and you'll both get a free month.</p>
    </div>

    <div class="mb-6 text-sm">
      <label class="inline-flex items-start gap-2">
        <%= f.check_box :terms_accepted, class: "mt-1" %>
        <span>
          I agree to the
          <%= link_to "Terms of Service", terms_path, target: "_blank", rel: "noopener", class: "text-blue-600 underline" %>
          and
          <%= link_to "Privacy Policy", privacy_path, target: "_blank", rel: "noopener", class: "text-blue-600 underline" %>.
        </span>
      </label>
    </div>

    <%= f.submit "Create organization", class: "bg-blue-600 text-white px-4 py-2 rounded w-full" %>
  <% end %>

  <div class="mt-6 text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
